---
import { SITE } from '@/data/site';
import CookieConsent from '@/components/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  keywords?: string[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
  hreflang?: { lang: string; href: string }[];
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  canonical = Astro.url.pathname,
  ogImage = SITE.defaultOgImage,
  ogType = 'website',
  noindex = false,
  keywords = [],
  schema,
  hreflang = [],
} = Astro.props;

const canonicalUrl = new URL(canonical, SITE.domain).href;
const ogImageUrl = new URL(ogImage, SITE.domain).href;

// Organization Schema 默认注入每页 (原站完全没有)
const defaultOrg = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.organization.legalName,
  url: SITE.domain,
  logo: new URL('/logo.png', SITE.domain).href,
  foundingDate: SITE.organization.foundingDate,
  sameAs: SITE.organization.sameAs,
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: SITE.organization.contact.phone,
    email: SITE.organization.contact.sales,
    contactType: 'sales',
    areaServed: ['US', 'CA'],
    availableLanguage: ['English', 'Spanish', 'Chinese'],
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.organization.hqAddress.street,
    addressLocality: SITE.organization.hqAddress.city,
    addressRegion: SITE.organization.hqAddress.region,
    postalCode: SITE.organization.hqAddress.postal,
    addressCountry: SITE.organization.hqAddress.country,
  },
};

const schemas = [defaultOrg, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---
<!doctype html>
<html lang="en-US" class="scroll-smooth" data-gtm-id={SITE.analytics.gtmId}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#00A86B" />
    <meta name="format-detection" content="telephone=yes" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- ✅ Open Graph (原站完全缺失) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />

    <!-- ✅ Twitter Card (原站完全缺失) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- ✅ Hreflang (原站缺失) -->
    <link rel="alternate" hreflang="en-US" href={canonicalUrl} />
    {hreflang.map((h) => (
      <link rel="alternate" hreflang={h.lang} href={h.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- ✅ Preconnect / DNS-prefetch (性能) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- ✅ 字体 (字体加载非阻塞) -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />

    <!-- ✅ Favicon (原站只有 png 多尺寸, 这里加 SVG 自适应) -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- ✅ JSON-LD 结构化数据 (原站完全没有, Rich Snippets 必备) -->
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- 📊 Cloudflare Web Analytics (零 cookie / 零 PII / 合规友好) -->
    {SITE.analytics?.cloudflareToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${SITE.analytics.cloudflareToken}"}`}
      />
    )}

    <!-- 📊 Plausible (默认不启用, 设置 analytics.plausibleDomain 后启用) -->
    {SITE.analytics?.plausibleDomain && (
      <script defer data-domain={SITE.analytics.plausibleDomain} src="https://plausible.io/js/script.js" />
    )}

    <slot name="head" />
  </head>
  <body class="bg-white text-jinko-ink font-sans antialiased">
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.callsunTrack = function(event, payload) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event, ...(payload || {}) });
      };
    </script>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-jinko focus:text-white focus:px-4 focus:py-2 focus:rounded">
      Skip to content
    </a>

    <slot name="header" />
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <slot name="footer" />
    <CookieConsent />
    <script is:inline>
      (function () {
        const gtmId = document.documentElement.dataset.gtmId;
        if (!gtmId) return;
        const load = function () {
          if (window.__callsunGtmLoaded) return;
          window.__callsunGtmLoaded = true;
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(gtmId);
          document.head.appendChild(s);
        };
        if (localStorage.getItem('callsun_cookie_consent') === 'accepted') load();
        window.addEventListener('callsun:analytics-consent', load);
      })();
    </script>
  </body>
</html>
