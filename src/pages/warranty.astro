---
// 原站完全没有的页面 — Warranty 落地页
// 抓关键词: "jinko solar warranty", "jinko warranty claim", "30 year power warranty"
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const faq = [
  {
    q: 'How long is the Jinko solar panel warranty?',
    a: 'EAGLE® G7 modules come with a 12-year product warranty and a 30-year linear power output warranty (≥87.4% at year 30).',
  },
  {
    q: 'How do I file a warranty claim?',
    a: 'Contact your installer first. If unreachable, email warranty@jinkosolar.us with module serial numbers and purchase proof. Claims are typically resolved within 30 days.',
  },
  {
    q: 'Does Jinko honor U.S. warranties on panels installed abroad?',
    a: 'EAGLE® warranties are honored in the country of original installation. Jinko (U.S.) Inc. supports projects in the U.S. and Canada.',
  },
  {
    q: 'What is covered under the EAGLE Storage® LFP battery warranty?',
    a: 'EAGLE Storage® includes a 10-year product and capacity warranty, guaranteeing 60% remaining capacity at year 10 under standard cycling.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="Jinko Solar Warranty — 30-Year Power, 12-Year Product | Jinko US"
  description="Comprehensive Jinko EAGLE® solar panel and EAGLE Storage® battery warranty details. 30-year linear power warranty. File a claim or download documentation."
  schema={faqSchema}
>
  <Header slot="header" />

  <section class="py-16 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <h1 class="text-4xl lg:text-5xl font-display font-extrabold">Jinko Warranty Center</h1>
      <p class="mt-3 text-lg text-jinko-mute max-w-2xl">
        Industry-leading warranty terms backed by one of the lowest claim rates in the U.S. solar industry.
      </p>
    </div>
  </section>

  <section class="py-14">
    <div class="max-w-content mx-auto px-4 lg:px-6 grid md:grid-cols-3 gap-6">
      <div class="rounded-2xl border border-jinko-line p-7 bg-white shadow-card">
        <p class="text-jinko-accent font-bold">EAGLE® Modules</p>
        <p class="mt-2 text-3xl font-display font-extrabold">30 yr</p>
        <p class="text-jinko-mute">Linear power output warranty</p>
      </div>
      <div class="rounded-2xl border border-jinko-line p-7 bg-white shadow-card">
        <p class="text-jinko-accent font-bold">EAGLE® Modules</p>
        <p class="mt-2 text-3xl font-display font-extrabold">12 yr</p>
        <p class="text-jinko-mute">Product workmanship warranty</p>
      </div>
      <div class="rounded-2xl border border-jinko-line p-7 bg-white shadow-card">
        <p class="text-jinko-accent font-bold">EAGLE Storage®</p>
        <p class="mt-2 text-3xl font-display font-extrabold">10 yr</p>
        <p class="text-jinko-mute">Product + capacity warranty</p>
      </div>
    </div>
  </section>

  <section class="py-14 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6 max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-display font-extrabold">Frequently Asked Questions</h2>
      <dl class="mt-8 space-y-4">
        {faq.map((f) => (
          <details class="group rounded-xl bg-white border border-jinko-line p-5 shadow-card open:shadow-md">
            <summary class="cursor-pointer font-semibold text-jinko-ink list-none flex justify-between items-center">
              {f.q}
              <span class="text-jinko-mute group-open:rotate-180 transition-transform">▾</span>
            </summary>
            <p class="mt-3 text-jinko-mute leading-relaxed">{f.a}</p>
          </details>
        ))}
      </dl>

      <div class="mt-10 p-6 rounded-2xl bg-jinko text-white flex flex-col sm:flex-row gap-4 justify-between items-center">
        <p class="font-semibold">Need to file a claim?</p>
        <a href="mailto:warranty@jinkosolar.us" class="px-5 py-3 rounded-md bg-jinko-accent text-jinko-ink font-bold">warranty@jinkosolar.us</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
