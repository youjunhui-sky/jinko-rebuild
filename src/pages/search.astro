---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---
<BaseLayout title="Search — Callsun" description="Search Callsun products, solutions, cases and resources.">
  <Header slot="header" />
  <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><h1 class="text-4xl lg:text-5xl font-display font-extrabold">Search Callsun</h1><p class="mt-2 text-jinko-mute">Find products, solutions, cases, resources and support pages.</p></div></section>
  <section class="py-14"><div class="max-w-content mx-auto px-4 lg:px-6"><link href="/pagefind/pagefind-ui.css" rel="stylesheet" /><div id="search" class="max-w-3xl"></div></div></section>
  <Footer slot="footer" />
</BaseLayout>
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    new PagefindUI({ element: '#search', showSubResults: true, translations: { placeholder: 'Search Callsun products & resources…' } });
  });
</script>
