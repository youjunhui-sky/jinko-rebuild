---
// 家用市场页 — 抓关键词: residential solar, home battery, hurricane backup
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const FAQ = [
  { q: 'How much does a Jinko home solar system cost?', a: 'Typical 8 kW residential systems range from $20,000–$30,000 before federal tax credit (30%). Combined with EAGLE Storage® batteries (~$10,000 for 13 kWh), expect $30K–$45K total. Your installer provides exact pricing based on roof type and local incentives.' },
  { q: 'How long does installation take?', a: 'A standard residential install completes in 1–3 days. Permit and utility interconnection typically add 4–8 weeks depending on your jurisdiction.' },
  { q: 'Will solar work during a power outage?', a: 'Solar alone shuts off during outages (safety requirement). Solar + EAGLE Storage® battery keeps your critical loads (fridge, lights, internet, well pump) running for 12–48 hours. Whole-home backup requires sizing battery to peak load.' },
  { q: 'What is the warranty?', a: 'EAGLE® modules: 12-year product + 30-year linear power warranty (≥87.4% output at year 30). EAGLE Storage® batteries: 10-year product and capacity warranty (≥60% capacity at year 10).' },
  { q: 'Are Jinko panels eligible for the federal tax credit?', a: 'Yes — all residential solar + storage systems qualify for the federal Investment Tax Credit (ITC) of 30% through 2032. Jinko modules made in Jacksonville, FL also qualify for IRA Domestic Content Bonus.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="Residential Solar + Battery Storage for U.S. Homes | Jinko US"
  description="Power your home with Jinko EAGLE® solar panels and EAGLE Storage® LFP batteries. 30-year warranty. Federal tax credit eligible. Find a certified installer near you."
  schema={faqSchema}
>
  <Header slot="header" />

  <!-- HERO -->
  <section class="relative isolate text-white overflow-hidden">
    <img src="/hero/home-rooftop.jpg" alt="Residential rooftop solar installation" class="absolute inset-0 w-full h-full object-cover" width="1920" height="800" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-r from-jinko-dark/95 via-jinko/80 to-sky-700/30"></div>
    <div class="max-w-content mx-auto px-4 lg:px-6 py-24 lg:py-32 relative">
      <p class="text-xs uppercase tracking-widest font-bold text-jinko-accent">For Homeowners · Across All 50 States</p>
      <h1 class="mt-3 text-4xl lg:text-6xl font-display font-extrabold max-w-3xl leading-tight">
        Solar + Storage,<br />Built for Your Home.
      </h1>
      <p class="mt-5 text-lg lg:text-xl text-sky-100 max-w-2xl leading-relaxed">
        EAGLE® solar panels and EAGLE Storage® LFP batteries — the same panels powering 28 GW of U.S. utility projects, now ready for your roof.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/installer-finder" class="px-6 py-3 rounded-md bg-jinko-accent text-jinko-ink font-semibold hover:opacity-90">Find an Installer</a>
        <a href="/warranty" class="px-6 py-3 rounded-md bg-white/10 text-white font-semibold ring-1 ring-white/20">See Warranty</a>
      </div>
    </div>
  </section>

  <!-- 价值主张 -->
  <section class="py-20">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <h2 class="text-3xl lg:text-4xl font-display font-extrabold max-w-2xl">Why Jinko for Your Home</h2>
      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {[
          { v: '3.8 M', l: 'Homes worth of solar deployed across the U.S.', icon: '🏘️' },
          { v: '30 yr', l: 'Linear power warranty — the industry standard you can count on', icon: '🛡️' },
          { v: '30%', l: 'Federal ITC tax credit eligibility through 2032', icon: '💰' },
        ].map((s) => (
          <li class="rounded-2xl bg-white border border-jinko-line p-7 shadow-card text-center">
            <div class="text-4xl">{s.icon}</div>
            <p class="mt-3 text-4xl font-display font-extrabold text-jinko">{s.v}</p>
            <p class="mt-2 text-jinko-mute leading-relaxed">{s.l}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 流程图: 4 步 -->
  <section class="py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <h2 class="text-3xl lg:text-4xl font-display font-extrabold">From First Call to Power-On</h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-4">
        {[
          { n: '1', t: 'Find Installer', d: 'Use our installer finder to connect with a Jinko-authorized partner in your area.' },
          { n: '2', t: 'Custom Design', d: 'Your installer designs a system sized to your home, roof, and energy goals.' },
          { n: '3', t: 'Install (1–3 days)', d: 'Professional installation with permits, inspections, and utility interconnection handled.' },
          { n: '4', t: 'Power On', d: 'Generate clean power for 30+ years. Optional battery for backup during outages.' },
        ].map((s) => (
          <li class="rounded-2xl bg-white p-6 border border-jinko-line shadow-card">
            <p class="text-5xl font-display font-extrabold text-jinko-accent">{s.n}</p>
            <h3 class="mt-3 font-display font-bold text-lg">{s.t}</h3>
            <p class="mt-2 text-sm text-jinko-mute leading-relaxed">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQ (含 Schema 抓 Google "People Also Ask") -->
  <section class="py-20">
    <div class="max-w-3xl mx-auto px-4 lg:px-6">
      <h2 class="text-3xl lg:text-4xl font-display font-extrabold">Frequently Asked Questions</h2>
      <dl class="mt-8 space-y-4">
        {FAQ.map((f) => (
          <details class="group rounded-xl bg-white border border-jinko-line p-5 shadow-card">
            <summary class="cursor-pointer font-semibold text-jinko-ink list-none flex justify-between items-center">
              {f.q}
              <span class="text-jinko-mute group-open:rotate-180 transition-transform">▾</span>
            </summary>
            <p class="mt-3 text-jinko-mute leading-relaxed">{f.a}</p>
          </details>
        ))}
      </dl>
      <div class="mt-10 p-6 rounded-2xl bg-jinko text-white flex flex-col sm:flex-row gap-4 justify-between items-center">
        <p class="font-semibold">Ready to power your home?</p>
        <a href="/installer-finder" class="px-5 py-3 rounded-md bg-jinko-accent text-jinko-ink font-bold">Find an Installer →</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
