---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---
<BaseLayout title="News moved to Resources Blog | Callsun" description="Callsun news and technical content are now available under Resources Blog.">
  <Header slot="header" />
  <section class="py-20 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><h1 class="text-4xl font-display font-extrabold">News & blog moved</h1><p class="mt-4 text-jinko-mute">Callsun content is now organized under Resources for the new SEO structure.</p><a href="/resources/blog" class="mt-6 inline-flex px-5 py-3 rounded-md bg-jinko text-white font-semibold">Go to Blog</a></div></section>
  <Footer slot="footer" />
</BaseLayout>
