---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const news = await getCollection('news', n => !n.data.draft);
  return news.map((n) => ({ params: { slug: n.slug }, props: { slug: n.slug, title: n.data.title } }));
}
const { slug, title } = Astro.props;
const target = `/resources/blog/${slug}`;
---
<BaseLayout title={`${title} moved | Callsun`} description="This article has moved to the Callsun Resources Blog." noindex={true} canonical={target}>
  <meta http-equiv="refresh" content={`0;url=${target}`} />
  <script is:inline define:vars={{ target }}>window.location.replace(target);</script>
  <section class="py-20 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><h1 class="text-4xl font-display font-extrabold">Article moved</h1><p class="mt-4 text-jinko-mute">Redirecting to <a href={target} class="text-jinko font-semibold">{target}</a>...</p></div></section>
</BaseLayout>
