---
// 新闻详情页 (动态生成, Markdown 渲染 + Article Schema)
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/data/site';

export async function getStaticPaths() {
  const news = await getCollection('news', n => !n.data.draft);
  return news.map((n) => ({ params: { slug: n.slug }, props: { entry: n } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishDate.toISOString(),
  author: { '@type': 'Organization', name: entry.data.author },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: { '@type': 'ImageObject', url: new URL('/logo.svg', SITE.domain).href },
  },
  image: entry.data.cover ? new URL(entry.data.cover, SITE.domain).href : undefined,
};
---
<BaseLayout
  title={`${entry.data.title} | Jinko US`}
  description={entry.data.description}
  ogImage={entry.data.cover}
  ogType="article"
  schema={schema}
>
  <Header slot="header" />

  <article class="max-w-3xl mx-auto px-4 lg:px-6 py-14">
    <nav class="text-sm text-jinko-mute mb-4">
      <a href="/" class="hover:text-jinko">Home</a> /
      <a href="/news" class="hover:text-jinko">News</a> /
      <span class="text-jinko-ink">{entry.data.category}</span>
    </nav>
    <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{entry.data.category}</p>
    <h1 class="mt-2 text-4xl lg:text-5xl font-display font-extrabold leading-tight">{entry.data.title}</h1>
    <p class="mt-3 text-jinko-mute">
      {entry.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} · by {entry.data.author}
    </p>

    {entry.data.cover && (
      <div class="mt-8 aspect-[16/9] bg-jinko-bg rounded-2xl flex items-center justify-center text-jinko-mute text-sm">
        [{entry.data.title} cover]
      </div>
    )}

    <div class="prose prose-slate mt-10 max-w-none
                prose-headings:font-display prose-headings:font-extrabold
                prose-h2:text-3xl prose-h3:text-2xl
                prose-a:text-jinko prose-blockquote:border-jinko-accent">
      <Content />
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>
