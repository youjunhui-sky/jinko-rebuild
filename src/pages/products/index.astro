---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import StatStrip from '@/components/StatStrip.astro';
import CardGrid from '@/components/CardGrid.astro';

const indexEntry = await getEntry('productIndex', 'index');
if (!indexEntry) throw new Error('Missing product index content entry: src/content/productIndex/index.json');
const page = indexEntry.data;
const products = (await getCollection('products')).map(p=>p.data).sort((a,b)=>a.order-b.order);
const groups = [
  { id: 'standard-modules', label: 'Standard Modules', description: 'High-power modules for mainstream project supply, distributor inventory and commercial rooftop demand.', items: products.filter(p=>p.category==='standard-module') },
  { id: 'custom-modules', label: 'Custom Modules', description: 'Compact and non-standard modules for special applications, mobile use cases and space-limited projects.', items: products.filter(p=>p.category==='custom-module') },
];
---
<BaseLayout title={page.seoTitle || `${page.title} | Callsun`} description={page.metaDescription || page.hero.description} canonical={page.canonical || '/products'} ogImage={page.ogImage || '/og/default.svg'} keywords={page.keywords} noindex={page.noindex}>
  <Header slot="header" />
  <section class="py-16 lg:py-20 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><nav class="text-sm text-jinko-mute mb-5"><a href="/">Home</a> / <span>{page.title}</span></nav><p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold">{page.hero.eyebrow}</p><h1 class="mt-3 text-4xl lg:text-6xl font-display font-extrabold leading-tight max-w-5xl">{page.h1 || page.title}</h1><p class="mt-5 text-lg text-jinko-mute max-w-3xl leading-relaxed">{page.hero.description}</p><div class="mt-8 flex flex-wrap gap-3"><a href={page.hero.primaryCtaHref} class="inline-flex px-5 py-3 rounded-md bg-jinko text-white font-semibold shadow-card">{page.hero.primaryCtaLabel}</a>{page.hero.secondaryCtaLabel && page.hero.secondaryCtaHref && <a href={page.hero.secondaryCtaHref} class="inline-flex px-5 py-3 rounded-md bg-white text-jinko font-semibold border border-jinko-line">{page.hero.secondaryCtaLabel}</a>}</div></div></section>
  <StatStrip stats={page.stats} />
  <section class="py-16"><div class="max-w-content mx-auto px-4 lg:px-6"><SectionHeader eyebrow={page.intro.eyebrow} title={page.intro.title} description={page.intro.description} />{page.categoryNotes.length > 0 && <div class="mt-10"><CardGrid items={page.categoryNotes} /></div>}</div></section>
  {groups.map(group => <section id={group.id} class="py-16 odd:bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><SectionHeader eyebrow="Product category" title={group.label} description={group.description} /><ul class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{group.items.map(p=><li class="rounded-2xl bg-white border border-jinko-line shadow-card overflow-hidden"><a href={`/products/${p.slug}`}><img src={p.image} alt={p.imageAlt || p.name} class="aspect-[4/3] w-full object-cover" loading="lazy"/><div class="p-6"><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{p.model || p.category}</p><h3 class="mt-2 text-xl font-display font-bold">{p.name}</h3><p class="mt-2 text-sm text-jinko-mute">{p.tagline}</p><p class="mt-4 text-jinko font-semibold">View specs →</p></div></a></li>)}</ul></div></section>)}
  {page.finalCta && <section class="py-16"><div class="max-w-content mx-auto px-4 lg:px-6"><div class="rounded-3xl bg-jinko text-white p-8 lg:p-10 flex flex-col lg:flex-row gap-6 lg:items-center lg:justify-between"><div><h2 class="text-3xl font-display font-extrabold">{page.finalCta.title}</h2>{page.finalCta.description && <p class="mt-3 text-white/80 max-w-2xl">{page.finalCta.description}</p>}</div><div class="flex flex-wrap gap-3 shrink-0"><a href={page.finalCta.primaryHref} class="inline-flex px-5 py-3 rounded-md bg-white text-jinko font-semibold">{page.finalCta.primaryLabel}</a>{page.finalCta.secondaryLabel && page.finalCta.secondaryHref && <a href={page.finalCta.secondaryHref} class="inline-flex px-5 py-3 rounded-md bg-jinko-dark text-white font-semibold border border-white/20">{page.finalCta.secondaryLabel}</a>}</div></div></div></section>}
  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>
