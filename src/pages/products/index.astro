---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import { SITE } from '@/data/site';

const categories = [
  {
    slug: 'standard-modules',
    label: 'Standard Modules',
    tag: 'High-Power · Utility & Commercial',
    title: 'High-Power Bifacial Modules',
    range: '450W – 720W',
    lineup: 'CN450W · CN580W · CN620W · CN720W',
    description: 'Bifacial dual-glass N-type TOPCon modules engineered for commercial rooftops, industrial installations and utility-scale solar farms. Up to 23.18% module efficiency and 30-year linear power warranty.',
    features: [
      'Up to 23.18% module efficiency',
      'Bifacial dual-glass 2.0+2.0mm construction',
      '1500V DC system voltage',
      '30-year linear power warranty (87.4% at year 30)',
    ],
    image: '/uploads/callsun/products/720w/front-back.jpg',
    imageAlt: 'Callsun standard N-type bifacial dual-glass solar module lineup',
    href: '/products/standard-modules/',
    ctaLabel: 'Explore Standard Modules',
  },
  {
    slug: 'custom-modules',
    label: 'Custom Modules',
    tag: 'Compact · RV, Marine & 12V',
    title: 'Compact Modules for Off-Grid & Mobility',
    range: '180W – 215W',
    lineup: 'CN180W · CN200W · CN215W',
    description: 'Compact N-type TOPCon modules with anti-shading circuits and dual-cell parallel design. Engineered for RVs, boats, off-grid battery systems and portable power stations that demand reliability under partial shade and complex conditions.',
    features: [
      'Anti-shading 4-zone independent circuit',
      'TwinCell / dual-cell parallel design',
      'High current output for 12V battery systems',
      'IP68, ultra-slim all-terrain frame',
    ],
    image: '/uploads/callsun/products/215w/front-back.jpg',
    imageAlt: 'Callsun custom N-type solar module lineup for RV, marine and 12V systems',
    href: '/products/custom-modules/',
    ctaLabel: 'Explore Custom Modules',
  },
];

const productHubSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Callsun Solar Module Categories',
  itemListElement: categories.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    url: new URL(c.href, SITE.domain).href,
  })),
};
---
<BaseLayout
  title="Solar Modules | Standard 450W–720W & Custom 180W–215W | Callsun"
  description="Callsun N-type TOPCon solar module portfolio. Standard Modules (450W, 580W, 620W, 720W) for commercial and utility solar. Custom Modules (180W, 200W, 215W) for RV, marine and 12V battery systems."
  canonical="/products/"
  keywords={['solar modules', 'n type topcon solar', 'standard solar module', 'custom solar module', 'utility solar module', 'rv solar panel']}
  schema={productHubSchema}
>
  <Header slot="header" />

  <!-- 1. Hero 大场景图 -->
  <section class="relative h-[520px] md:h-[640px] lg:h-[720px] overflow-hidden">
    <img src="/uploads/callsun/products/180w/hero-04.jpg" alt="Callsun CN series bifacial modules installed on white boat deck with deep blue sea" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-r from-jinko-ink/70 via-jinko-ink/40 to-transparent"></div>
    <div class="relative h-full flex items-center">
      <div class="max-w-content mx-auto px-4 lg:px-6 w-full">
        <p class="text-xs uppercase tracking-[0.28em] text-jinko-accent font-extrabold">Product Portfolio</p>
        <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-white leading-tight max-w-3xl">
          N-Type TOPCon Solar Modules for <span class="text-jinko-accent">Every Application</span>
        </h1>
        <p class="mt-6 text-lg text-white/85 leading-relaxed max-w-2xl">
          Choose from two module lineups engineered for distinct application needs — high-power standard modules for commercial and utility solar, or compact custom modules for RV, marine and 12V systems.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Info Strip -->
  <section class="bg-jinko text-white">
    <div class="max-w-content mx-auto px-4 lg:px-6 pt-5 pb-4 lg:pt-6 lg:pb-5">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <p class="flex-1 min-w-0 text-sm lg:text-base text-white/75 leading-relaxed max-w-4xl">We offer a full-range solar module portfolio — 450W–720W high-power standard modules and 180W–215W customized modules — serving utility, commercial & industrial, and residential applications with consistent quality and stable global delivery.</p>
        <div class="flex gap-3 shrink-0">
          <a href="/contact" data-track-click="portfolio_inquiry" class="px-5 py-2.5 rounded bg-white/10 ring-1 ring-white/30 text-white font-semibold text-sm hover:bg-white/20 transition">Request a Quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. 两大分类入口卡 -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="max-w-2xl mb-12 lg:mb-16">
        <p class="text-xs uppercase tracking-[0.28em] text-jinko-accent font-extrabold">Explore by Category</p>
        <h2 class="mt-4 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-jinko-ink leading-tight">Two Lineups. One Standard of Quality.</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-8 lg:gap-10">
        {categories.map((c) => (
          <a href={c.href} class="group block bg-white border border-jinko-line hover:border-jinko-accent transition-all overflow-hidden">
            <div class="aspect-[4/3] overflow-hidden bg-jinko-bg flex items-center justify-center p-8">
              <img src={c.image} alt={c.imageAlt} class="max-h-full w-auto object-contain group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <div class="p-8 lg:p-10 border-t border-jinko-line">
              <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{c.tag}</p>
              <h3 class="mt-3 text-3xl lg:text-4xl font-display font-extrabold text-jinko-ink leading-tight">{c.label}</h3>
              <div class="mt-4 flex flex-wrap items-center gap-3">
                <span class="inline-block px-4 py-1.5 bg-jinko-accent text-white font-bold text-sm rounded">{c.range}</span>
                <span class="text-sm text-jinko-mute font-semibold">{c.lineup}</span>
              </div>
              <p class="mt-5 text-jinko-mute leading-relaxed">{c.description}</p>
              <ul class="mt-6 space-y-2">
                {c.features.map((f) => (
                  <li class="flex items-start gap-3 text-sm text-jinko-mute">
                    <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-jinko-accent flex-shrink-0"></span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-8 text-jinko font-bold uppercase tracking-wider text-sm group-hover:text-jinko-accent inline-flex items-center gap-2">
                {c.ctaLabel}
                <span aria-hidden="true">→</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Quality / Service / Downloads 3 通用卡 -->
  <section class="py-16 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6 grid md:grid-cols-3 gap-6">
      <div class="rounded-2xl bg-white border border-jinko-line p-7">
        <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Quality</p>
        <h3 class="mt-2 text-2xl font-display font-extrabold">Tested &amp; validated</h3>
        <p class="mt-4 text-jinko-mute leading-relaxed">Callsun modules are manufactured under rigorous quality-control standards. Each module passes UL and IEC testing. We work with the world's leading third-party organizations to audit our facilities and test our products.</p>
        <p class="mt-3 text-xs text-jinko-mute">IEC 61215 · IEC 61730 · ISO 9001:2023 · ISO 14001:2023 · ISO 45001:2023 · CE · RoHS</p>
      </div>
      <div class="rounded-2xl bg-white border border-jinko-line p-7">
        <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Service | Support</p>
        <h3 class="mt-2 text-2xl font-display font-extrabold">B2B confidence</h3>
        <p class="mt-4 text-jinko-mute leading-relaxed">We stand behind every module we ship. Contact us at <a href="mailto:callsun-service@outlook.com" class="underline">callsun-service@outlook.com</a> with your order details. Our service team responds within 1 business day.</p>
      </div>
      <div class="rounded-2xl bg-white border border-jinko-line p-7">
        <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Downloads | Documents</p>
        <h3 class="mt-2 text-2xl font-display font-extrabold">Datasheets &amp; more</h3>
        <p class="mt-4 text-jinko-mute leading-relaxed">Datasheets, installation manuals, warranty terms, certifications, brochures, and more — all available in our <a href="/resources/" class="underline">Download Center</a>.</p>
      </div>
    </div>
  </section>

  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>