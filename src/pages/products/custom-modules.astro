---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import { SITE } from '@/data/site';

const all = (await getCollection('products'))
  .filter((p) => p.data.category === 'custom-module')
  .map((p) => p.data)
  .filter((p) => ['180w-custom-solar-module', '200w-custom-solar-module', '215w-custom-solar-module'].includes(p.slug))
  .sort((a, b) => (a.order || 0) - (b.order || 0));

const getSpec = (p, re) => p.specs.find((s) => re.test(s.label))?.value || '';

const cardImgMap = {
  'CN180W': '/uploads/callsun/products/180w/hero-05.jpg',
  'CN200W': '/uploads/callsun/products/200w/front-back.jpg',
  'CN215W': '/uploads/callsun/products/215w/front-back.jpg',
};

const subtitleMap = {
  'CN180W': '180W Custom N-Type TOPCon Solar Module',
  'CN200W': '200W Custom N-Type TwinCell Solar Module',
  'CN215W': '215W Anti-Shading Custom N-Type Solar Module',
};

const descMap = {
  'CN180W': 'Commercial-grade 180W N-Type TOPCon with dual-cell parallel design. The CN180W delivers uninterrupted energy yields even under complex conditions — whether it\'s shading, high temperatures, or narrow spaces. Ultra-slim and all-terrain, it is the ideal choice for RV, marine and off-grid applications.',
  'CN200W': 'High-output 200W with TwinCell anti-shade design. The CN200W delivers up to 25% efficiency and innovative TwinCell parallel circuit for uninterrupted, double-sided energy yields under shading, scorching heat, or narrow spaces. Engineered for RVs, boats and 12V battery systems.',
  'CN215W': 'Anti-shading 215W with 4-zone independent circuit design. The CN215W keeps Vmp rock-solid even under partial shade — retaining 75% more power when obstructed. Capturing an extra 7-30% of reflected light from the backside, it perfectly matches 12V systems and portable power stations.',
};

const cards = all.map((p) => ({
  slug: p.slug,
  model: p.model,
  name: p.name,
  image: cardImgMap[p.model] || p.image,
  imageAlt: p.imageAlt,
  subtitle: subtitleMap[p.model] || 'Custom Module',
  description: descMap[p.model] || '',
  pmax: getSpec(p, /Pmax/i),
  cellEff: getSpec(p, /Cell Efficiency|Module Efficiency/i),
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Callsun Custom N-Type Solar Module Series',
  itemListElement: cards.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.model,
    url: new URL(`/products/${c.slug}`, SITE.domain).href,
  })),
};
---
<BaseLayout
  title="Custom N-Type TOPCon Solar Modules | 180W, 200W, 215W | Callsun"
  description="Callsun custom N-type TOPCon solar module lineup — CN180W, CN200W and CN215W engineered for RV, marine, 12V battery systems and portable power stations. Anti-shading circuits, dual-cell parallel design, high current output."
  canonical="/products/custom-modules/"
  keywords={['custom solar module', 'rv solar panel', 'marine solar module', '12v solar module', '180w solar', '200w solar module', '215w solar module', 'anti shading solar panel']}
  schema={schema}
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="bg-jinko-ink text-white py-20 lg:py-28">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-[0.28em] text-jinko-accent font-extrabold">Custom Modules</p>
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-display font-extrabold leading-tight max-w-4xl">
        Compact Modules for <span class="text-jinko-accent">RV, Marine & 12V Systems</span>
      </h1>
      <p class="mt-6 text-lg text-white/80 leading-relaxed max-w-3xl">
        Callsun custom N-type TOPCon module lineup covers 180W to 215W output with anti-shading circuits, dual-cell parallel design and high current output. Engineered for RVs, boats, off-grid battery systems and portable power stations.
      </p>
    </div>
  </section>

  <!-- 纵列交替卡片，仿 standard-modules 布局 -->
  {cards.map((c, i) => {
    const isOdd = i % 2 === 0;
    const bg = isOdd ? 'bg-white' : 'bg-jinko-bg';
    return (
      <section class={`${bg} text-jinko-ink py-12 lg:py-20`}>
        <div class="max-w-content mx-auto px-4 lg:px-6">
          <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            {isOdd ? (
              <>
                <!-- 左图 -->
                <div>
                  <img src={c.image} alt={c.imageAlt || c.name} class="w-full h-auto object-contain" loading="lazy" />
                </div>
                <!-- 右文 -->
                <div>
                  <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">CUSTOM MODULE · {String(i + 1).padStart(2, '0')} OF {String(cards.length).padStart(2, '0')}</p>
                  <h2 class="mt-3 text-4xl md:text-5xl lg:text-6xl font-display font-extrabold leading-tight text-jinko-ink">
                    {c.model}
                  </h2>
                  <p class="mt-2 text-base text-jinko-mute font-semibold">{c.subtitle}</p>
                  <div class="mt-4 flex flex-wrap items-center gap-3">
                    <span class="inline-block px-4 py-1.5 bg-jinko-accent text-white font-bold text-sm rounded">{c.pmax}</span>
                    <span class="text-sm text-jinko-mute"><span class="text-jinko-ink font-semibold">Module Efficiency</span> {c.cellEff}</span>
                  </div>
                  <p class="mt-6 text-jinko-mute leading-relaxed">{c.description}</p>
                  <a href={`/products/${c.slug}/`} class="mt-6 inline-flex items-center text-jinko font-bold uppercase tracking-wider text-sm hover:text-jinko-accent transition gap-2">
                    View Product Details
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </>
            ) : (
              <>
                <!-- 左文 -->
                <div>
                  <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">CUSTOM MODULE · {String(i + 1).padStart(2, '0')} OF {String(cards.length).padStart(2, '0')}</p>
                  <h2 class="mt-3 text-4xl md:text-5xl lg:text-6xl font-display font-extrabold leading-tight text-jinko-ink">
                    {c.model}
                  </h2>
                  <p class="mt-2 text-base text-jinko-mute font-semibold">{c.subtitle}</p>
                  <div class="mt-4 flex flex-wrap items-center gap-3">
                    <span class="inline-block px-4 py-1.5 bg-jinko-accent text-white font-bold text-sm rounded">{c.pmax}</span>
                    <span class="text-sm text-jinko-mute"><span class="text-jinko-ink font-semibold">Module Efficiency</span> {c.cellEff}</span>
                  </div>
                  <p class="mt-6 text-jinko-mute leading-relaxed">{c.description}</p>
                  <a href={`/products/${c.slug}/`} class="mt-6 inline-flex items-center text-jinko font-bold uppercase tracking-wider text-sm hover:text-jinko-accent transition gap-2">
                    View Product Details
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
                <!-- 右图 -->
                <div>
                  <img src={c.image} alt={c.imageAlt || c.name} class="w-full h-auto object-contain" loading="lazy" />
                </div>
              </>
            )}
          </div>
        </div>
      </section>
    );
  })}

  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>