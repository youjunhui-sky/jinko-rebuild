---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import CardGrid from '@/components/CardGrid.astro';
import { SITE } from '@/data/site';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const solutions = await getCollection('solutions');
  const cases = await getCollection('cases');
  return products.map((p) => ({ params: { slug: p.data.slug }, props: { product: p.data, allSolutions: solutions.map(s => s.data), allCases: cases.map(c => c.data) } }));
}

const { product, allSolutions, allCases } = Astro.props;
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  model: product.model,
  description: product.description,
  brand: { '@type': 'Brand', name: 'Callsun' },
  manufacturer: { '@type': 'Organization', name: SITE.organization.legalName },
  category: product.category,
  image: new URL(product.image, SITE.domain).href,
};
const groups = product.specs.reduce((acc, spec) => { const g = spec.group || 'General'; (acc[g] ||= []).push(spec); return acc; }, {});
const fallbackBenefits = product.category === 'standard-module'
  ? ['High-power module platform for commercial and distributed generation projects.', 'Specification-driven product page for faster distributor and EPC evaluation.', 'Designed for repeatable B2B supply with certifications, warranty notes and datasheet placeholders.']
  : ['Compact custom module format for RV, remote power and non-standard applications.', 'Flexible product positioning for B2B customers with specialized size requirements.', 'N-type cell platform with editable datasheet and certification placeholders.'];
const benefits = product.benefits.length ? product.benefits : fallbackBenefits;
const warranty = product.warranty || product.specs.find(s => /warranty/i.test(s.label))?.value || 'Warranty terms are reserved for official Callsun documentation.';
const relatedSolutions = allSolutions.filter((s) => product.relatedSolutions.includes(s.slug) || s.relatedProducts.includes(product.slug) || (product.category === 'standard-module' && s.relatedProducts.length === 0)).slice(0, 3);
const relatedCases = allCases.filter((c) => product.relatedCases.includes(c.slug) || c.relatedProducts.includes(product.slug) || c.featured).slice(0, 3);
const solutionCards = relatedSolutions.map(s => ({ title: s.title, description: s.summary, href: `/solutions/${s.slug}`, eyebrow: s.type, image: s.image, metric: s.capacityLabel }));
const caseCards = relatedCases.map(c => ({ title: c.title, description: c.salesAngle || c.description, href: `/cases/${c.slug}`, eyebrow: c.segment, image: c.coverImage, metric: c.capacityKW ? (c.capacityKW >= 1000 ? `${c.capacityKW / 1000}MW` : `${c.capacityKW}kW`) : undefined }));
const downloadItems = product.downloads.length ? product.downloads : [
  { label: `${product.name} Datasheet (placeholder)`, url: '/resources/downloads' },
  { label: 'Certification Package (placeholder)', url: '/resources/downloads' },
];
---
<style is:global>
  .hero-slide {
    opacity: 0;
    animation: hero-fade 24s infinite;
  }
  @keyframes hero-fade {
    0%, 3% { opacity: 0; }
    6%, 18% { opacity: 1; }
    22%, 100% { opacity: 0; }
  }
</style>
<BaseLayout title={product.seoTitle || `${product.name} | Callsun`} description={product.metaDescription || product.description} canonical={product.canonical || `/products/${product.slug}`} ogImage={product.ogImage || product.image} keywords={product.keywords} schema={productSchema} noindex={product.noindex}>
  <Header slot="header" />
  <article>

    {/* ── 1. Hero Carousel — 纯图片，突出视觉冲击 ── */}
    <section class="relative w-full h-[520px] md:h-[640px] lg:h-[760px] overflow-hidden">
      {product.heroBanners && product.heroBanners.length > 0 ? (
        product.heroBanners.map((banner, i) => (
          <img
            src={banner.src}
            alt={banner.alt}
            class="hero-slide absolute inset-0 w-full h-full object-cover"
            style={`animation-delay: ${i * 5}s;`}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        ))
      ) : (
        <div class="absolute inset-0 bg-jinko-bg flex items-center justify-center">
          <img src={product.image} alt={product.imageAlt || product.name} class="max-h-[80%] object-contain" />
        </div>
      )}
      {product.heroBanners && product.heroBanners.length > 1 && (
        <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-10 flex gap-2">
          {product.heroBanners.map(() => (
            <span class="w-2 h-2 rounded-full bg-white/50"></span>
          ))}
        </div>
      )}
    </section>

    {/* ── 2. Product Info Strip — 标题 + 参数一行，紧凑不抢图 ── */}
    <section class="bg-jinko text-white">
      <div class="max-w-content mx-auto px-4 lg:px-6 pt-5 pb-4 lg:pt-6 lg:pb-5">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <nav class="text-xs text-white/40 w-full lg:w-auto"><a href="/" class="hover:text-white/70">Home</a> / <a href="/products" class="hover:text-white/70">Products</a> / <span>{product.name}</span></nav>
          <div class="flex-1 min-w-0">
            <h1 class="text-lg lg:text-xl font-display font-bold leading-snug truncate">{product.h1 || product.name}</h1>
          </div>
          <div class="flex gap-2 shrink-0">
            <a href="/contact" data-track-click="product_inquiry_button" data-product={product.slug} class="px-4 py-1.5 rounded bg-white/10 ring-1 ring-white/30 text-white font-semibold text-xs hover:bg-white/20 transition">Request Quote</a>
            <a href="#downloads" data-track-click="datasheet_download" data-product={product.slug} class="px-4 py-1.5 rounded ring-1 ring-white/30 text-white font-semibold text-xs hover:bg-white/10 transition">Datasheet</a>
          </div>
        </div>
        <div class="mt-3 pt-3 border-t border-white/10 flex flex-wrap gap-x-5 gap-y-1 text-xs text-white/55">
          {[
            { label: 'Model', value: product.model },
            { label: 'Tech', value: product.tech },
            { label: 'Efficiency', value: product.specs.find(s => /Efficiency/i.test(s.label))?.value || '—' },
            { label: 'Warranty', value: warranty },
          ].map(item => (
            <span><span class="text-white/35">{item.label}</span> <span class="text-white/80 font-medium">{item.value}</span></span>
          ))}
        </div>
      </div>
    </section>

    {/* ── 4. Product Image — White Background (仿 Jinko G7BX 居中产品图) ── */}
    <section class="bg-white">
      <div class="max-w-content mx-auto px-4 lg:px-6 py-12 lg:py-16">
        <img src={product.image} alt={product.imageAlt || product.name} class="w-full max-h-[600px] object-contain mx-auto" loading="lazy" />
      </div>
    </section>

    {/* ── 5. Key Features — 2×3 Grid with Icons (仿 Jinko Key Features) ── */}
    {(() => {
      const featureIcons = [
        /* N-Type / Tech */ `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48 2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48 2.83-2.83"/></svg>`,
        /* Bifacial / Power */ `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
        /* Temp / Thermo */ `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/></svg>`,
        /* Construction / Shield */ `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
        /* Environment / Globe */ `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20"/></svg>`,
        /* Warranty / Badge */ `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2m16 0h2M12 20v2"/></svg>`,
      ];
      const normalizedBenefits = benefits.map(b =>
        typeof b === 'object' && b.title ? b : { title: 'Feature', description: String(b) }
      );
      return (
        <section id="key-features" class="py-16 lg:py-20 bg-jinko-bg">
          <div class="max-w-content mx-auto px-4 lg:px-6">
            <div class="text-center mb-12">
              <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Key Features</p>
              <h2 class="mt-3 text-3xl lg:text-4xl font-display font-extrabold">What makes {product.model} stand out</h2>
            </div>
            <div class="grid md:grid-cols-2 gap-6">
              {normalizedBenefits.map((b, i) => (
                <div class="flex items-start gap-5 bg-white rounded-2xl border border-jinko-line p-6 shadow-card hover:shadow-lg transition-shadow">
                  <div class="w-14 h-14 rounded-xl bg-jinko/10 flex items-center justify-center shrink-0 text-jinko" set:html={featureIcons[i] || featureIcons[0]} />
                  <div>
                    <h3 class="font-display font-bold text-lg text-jinko-ink">{b.title}</h3>
                    <p class="mt-2 text-jinko-mute leading-relaxed text-sm">{b.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      );
    })()}

    {/* ── 6. Certifications / Warranty / Downloads — 3-col (仿 Jinko 底部三栏) ── */}
    <section id="downloads" class="py-16 lg:py-20">
      <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-3 gap-6">
        <div class="rounded-3xl bg-white border border-jinko-line shadow-card p-7">
          <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Certifications</p>
          <h2 class="mt-2 text-2xl font-display font-extrabold">Tested & validated</h2>
          <ul class="mt-5 flex flex-wrap gap-2">
            {product.certifications.map(c => <li class="px-3 py-1.5 rounded-full bg-jinko-bg text-sm font-semibold">{c}</li>)}
          </ul>
        </div>
        <div class="rounded-3xl bg-white border border-jinko-line shadow-card p-7">
          <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Service | Support</p>
          <h2 class="mt-2 text-2xl font-display font-extrabold">B2B confidence</h2>
          <p class="mt-4 text-jinko-mute leading-relaxed">{warranty}</p>
        </div>
        <div class="rounded-3xl bg-jinko text-white shadow-card p-7">
          <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Downloads | Documents</p>
          <h2 class="mt-2 text-2xl font-display font-extrabold">Datasheets & more</h2>
          <ul class="mt-5 space-y-2">
            {downloadItems.map(d => <li><a href={d.url} data-track-click="datasheet_download" data-product={product.slug} class="underline underline-offset-4 hover:text-jinko-accent transition">{d.label}</a></li>)}
          </ul>
        </div>
      </div>
    </section>

    {/* ── 7. Applications ── */}
    <section class="py-16 bg-jinko-bg">
      <div class="max-w-content mx-auto px-4 lg:px-6">
        <SectionHeader eyebrow="Applications" title="Recommended application scenarios" description="From product specs to real use cases — find the right fit for your project." />
        <div class="mt-8 flex flex-wrap gap-3">
          {product.applications.map(app => <span class="px-4 py-2 rounded-full bg-white border border-jinko-line font-semibold text-jinko-ink">{app}</span>)}
        </div>
      </div>
    </section>
  </article>
  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>
