---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import CardGrid from '@/components/CardGrid.astro';
import { SITE } from '@/data/site';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const solutions = await getCollection('solutions');
  const cases = await getCollection('cases');
  return products.map((p) => ({ params: { slug: p.data.slug }, props: { product: p.data, allSolutions: solutions.map(s => s.data), allCases: cases.map(c => c.data) } }));
}

const { product, allSolutions, allCases } = Astro.props;
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  model: product.model,
  description: product.description,
  brand: { '@type': 'Brand', name: 'Callsun' },
  manufacturer: { '@type': 'Organization', name: SITE.organization.legalName },
  category: product.category,
  image: new URL(product.image, SITE.domain).href,
};
const groups = product.specs.reduce((acc, spec) => { const g = spec.group || 'General'; (acc[g] ||= []).push(spec); return acc; }, {});
const fallbackBenefits = product.category === 'standard-module'
  ? ['High-power module platform for commercial and distributed generation projects.', 'Specification-driven product page for faster distributor and EPC evaluation.', 'Designed for repeatable B2B supply with certifications, warranty notes and datasheet placeholders.']
  : ['Compact custom module format for RV, remote power and non-standard applications.', 'Flexible product positioning for B2B customers with specialized size requirements.', 'N-type cell platform with editable datasheet and certification placeholders.'];
const benefits = product.benefits.length ? product.benefits : fallbackBenefits;
const warranty = product.warranty || product.specs.find(s => /warranty/i.test(s.label))?.value || 'Warranty terms are reserved for official Callsun documentation.';
const relatedSolutions = allSolutions.filter((s) => product.relatedSolutions.includes(s.slug) || s.relatedProducts.includes(product.slug) || (product.category === 'standard-module' && s.relatedProducts.length === 0)).slice(0, 3);
const relatedCases = allCases.filter((c) => product.relatedCases.includes(c.slug) || c.relatedProducts.includes(product.slug) || c.featured).slice(0, 3);
const solutionCards = relatedSolutions.map(s => ({ title: s.title, description: s.summary, href: `/solutions/${s.slug}`, eyebrow: s.type, image: s.image, metric: s.capacityLabel }));
const caseCards = relatedCases.map(c => ({ title: c.title, description: c.salesAngle || c.description, href: `/cases/${c.slug}`, eyebrow: c.segment, image: c.coverImage, metric: c.capacityKW ? (c.capacityKW >= 1000 ? `${c.capacityKW / 1000}MW` : `${c.capacityKW}kW`) : undefined }));
const downloadItems = product.downloads.length ? product.downloads : [
  { label: `${product.name} Datasheet (placeholder)`, url: '/resources/downloads' },
  { label: 'Certification Package (placeholder)', url: '/resources/downloads' },
];
---
<style is:global>
  .hero-slide {
    opacity: 0;
    animation: hero-fade 20s infinite;
  }
  @keyframes hero-fade {
    0%, 4% { opacity: 0; }
    8%, 20% { opacity: 1; }
    24%, 100% { opacity: 0; }
  }
</style>
<BaseLayout title={product.seoTitle || `${product.name} | Callsun`} description={product.metaDescription || product.description} canonical={product.canonical || `/products/${product.slug}`} ogImage={product.ogImage || product.image} keywords={product.keywords} schema={productSchema} noindex={product.noindex}>
  <Header slot="header" />
  <article>
    <section class="bg-jinko-bg">
      {product.heroBanners && product.heroBanners.length > 0 ? (
        <div class="relative w-full h-[400px] md:h-[500px] lg:h-[600px] overflow-hidden">
          {product.heroBanners.map((banner, i) => (
            <img
              src={banner.src}
              alt={banner.alt}
              class="hero-slide absolute inset-0 w-full h-full object-cover"
              style={`animation-delay: ${i * 4}s;`}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          ))}
          <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-10 flex gap-2">
            {product.heroBanners.map(() => (
              <span class="w-2.5 h-2.5 rounded-full bg-white/60"></span>
            ))}
          </div>
        </div>
      ) : (
        <div class="max-w-content mx-auto px-4 lg:px-6 pt-10">
          <img src={product.image} alt={product.imageAlt || product.name} class="rounded-3xl border border-jinko-line shadow-card bg-white w-full max-h-[500px] object-contain" width="1200" height="500" />
        </div>
      )}
      <div class="py-14 lg:py-20">
        <div class="max-w-content mx-auto px-4 lg:px-6">
          <nav class="text-sm text-jinko-mute mb-6"><a href="/">Home</a> / <a href="/products">Products</a> / <span>{product.name}</span></nav>
          <div class="grid lg:grid-cols-[1.1fr_.9fr] gap-10 items-center">
            <div>
              <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{product.model} · {product.category.replace('-', ' ')}</p>
              <h1 class="mt-3 text-4xl lg:text-6xl font-display font-extrabold leading-tight">{product.h1 || product.name}</h1>
              <p class="mt-5 text-lg text-jinko-mute leading-relaxed max-w-2xl">{product.description}</p>
              <div class="mt-7 flex flex-wrap gap-3">
                <a href="/contact" data-track-click="product_inquiry_button" data-product={product.slug} class="px-6 py-3 rounded-md bg-jinko text-white font-semibold">Request Quote</a>
                <a href="#advantages" class="px-6 py-3 rounded-md ring-1 ring-jinko text-jinko font-semibold">View Advantages</a>
                <a href="#downloads" data-track-click="datasheet_download" data-product={product.slug} class="px-6 py-3 rounded-md bg-white border border-jinko-line text-jinko-ink font-semibold">Download Datasheet</a>
              </div>
            </div>
            <dl class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              {['Model', 'Technology', 'Warranty'].map((label) => <div class="rounded-2xl bg-white border border-jinko-line p-4"><dt class="text-xs uppercase tracking-widest text-jinko-mute font-semibold">{label}</dt><dd class="mt-1 font-display font-bold text-jinko-ink">{label === 'Model' ? product.model : label === 'Technology' ? product.tech : warranty}</dd></div>)}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16">
      <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-[.9fr_1.1fr] gap-10">
        <SectionHeader eyebrow="Product advantages" title="Why this module fits B2B solar supply." description="Use this section as the sales layer above the technical parameter table. It gives distributors and installers a quick reason to ask for pricing." />
        <div class="grid gap-4">
          {benefits.map((b, index) => <div class="rounded-2xl bg-white border border-jinko-line shadow-card p-5 flex gap-4"><span class="w-9 h-9 rounded-full bg-jinko text-white flex items-center justify-center font-display font-bold shrink-0">{index + 1}</span><p class="text-jinko-mute leading-relaxed">{b}</p></div>)}
        </div>
      </div>
    </section>

    {product.slug === '450w-double-glass-solar-module' ? (
      <>
        {/* 第二部分：1 张满屏宽图（450W 白底图） */}
        <section class="bg-white">
          <div class="max-w-content mx-auto px-4 lg:px-6 py-12 lg:py-16">
            <img src="/uploads/callsun/products/450w/01-front.jpg" alt="Callsun CN450W double glass bifacial solar module on white background" class="w-full max-h-[600px] object-contain" loading="lazy" />
          </div>
        </section>
      </>
    ) : (
      <section id="advantages" class="py-16">
        <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-[.9fr_1.1fr] gap-10">
          <SectionHeader eyebrow="Product advantages" title="Why this module fits B2B solar supply." description="Use this section as the sales layer above the technical parameter table. It gives distributors and installers a quick reason to ask for pricing." />
          <div class="grid gap-4">
            {benefits.map((b, index) => <div class="rounded-2xl bg-white border border-jinko-line shadow-card p-5 flex gap-4"><span class="w-9 h-9 rounded-full bg-jinko text-white flex items-center justify-center font-display font-bold shrink-0">{index + 1}</span><p class="text-jinko-mute leading-relaxed">{b}</p></div>)}
          </div>
        </div>
      </section>
    )}

    {product.slug === '450w-double-glass-solar-module' ? (
      <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><SectionHeader eyebrow="Applications" title="Recommended application scenarios" description="Product pages connect to scenarios so SEO visitors can move from product specs to real use cases." /><div class="mt-8 flex flex-wrap gap-3">{product.applications.map(app => <span class="px-4 py-2 rounded-full bg-white border border-jinko-line font-semibold text-jinko-ink">{app}</span>)}</div></div></section>
    ) : (
      <>
        <section class="py-16">
          <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-3 gap-6">
            <div class="rounded-3xl bg-white border border-jinko-line shadow-card p-7"><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Certifications</p><h2 class="mt-2 text-2xl font-display font-extrabold">Certificate ready</h2><ul class="mt-5 flex flex-wrap gap-2">{product.certifications.map(c => <li class="px-3 py-1.5 rounded-full bg-jinko-bg text-sm font-semibold">{c}</li>)}</ul></div>
            <div class="rounded-3xl bg-white border border-jinko-line shadow-card p-7"><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Warranty</p><h2 class="mt-2 text-2xl font-display font-extrabold">B2B confidence</h2><p class="mt-4 text-jinko-mute leading-relaxed">{warranty}</p></div>
            <div id="downloads" class="rounded-3xl bg-jinko text-white shadow-card p-7"><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Downloads</p><h2 class="mt-2 text-2xl font-display font-extrabold">Datasheet & certificates</h2><ul class="mt-5 space-y-2">{downloadItems.map(d => <li><a href={d.url} data-track-click="datasheet_download" data-product={product.slug} class="underline underline-offset-4 hover:text-jinko-accent">{d.label}</a></li>)}</ul></div>
          </div>
        </section>

        <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><SectionHeader eyebrow="Applications" title="Recommended application scenarios" description="Product pages connect to scenarios so SEO visitors can move from product specs to real use cases." /><div class="mt-8 flex flex-wrap gap-3">{product.applications.map(app => <span class="px-4 py-2 rounded-full bg-white border border-jinko-line font-semibold text-jinko-ink">{app}</span>)}</div></div></section>
      </>
    )}
  </article>
  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>
