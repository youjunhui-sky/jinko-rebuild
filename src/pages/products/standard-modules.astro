---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import { SITE } from '@/data/site';

const all = (await getCollection('products'))
  .filter((p) => p.data.category === 'standard-module')
  .map((p) => p.data)
  .filter((p) => ['450w-double-glass-solar-module', '580w-n-type-solar-module', '620w-n-type-solar-module', '720w-n-type-solar-module'].includes(p.slug))
  .sort((a, b) => (a.order || 0) - (b.order || 0));

const getSpec = (p, re) => p.specs.find((s) => re.test(s.label))?.value || '';

const cardImgMap = {
  'CN450W': '/uploads/callsun/products/450w/01-front.jpg',
  'CN580W': '/uploads/callsun/products/580w/front-back.jpg',
  'CN620W': '/uploads/callsun/products/620w/front-back.jpg',
  'CN720W': '/uploads/callsun/products/720w/front-back.jpg',
};

const subtitleMap = {
  'CN450W': '450W N-Type Bifacial Double-Glass Solar Module',
  'CN580W': '580W N-Type Bifacial Dual-Glass Solar Module',
  'CN620W': '620W N-Type Bifacial Dual-Glass Solar Module',
  'CN720W': '720W N-Type Bifacial Dual-Glass Solar Module',
};

const descMap = {
  'CN450W': 'The CN450W series modules feature our latest N-type monocrystalline cell technology, delivering an impressive module efficiency of 22.52%. As a high-efficiency bifacial double-glass module, it not only provides industry-leading power output but also significantly enhances long-term energy performance and system reliability, making it the ideal choice for your commercial and industrial solar projects.',
  'CN580W': 'Industrial-Grade 580W Bifacial Double-Glass Module. The CN580W combines premium N-type monocrystalline cells with 2.0+2mm dual-glass construction to deliver 580W output at 22.45% efficiency. Built for commercial rooftops, industrial projects and utility-scale deployments with a 30-year linear power warranty (87.4% output at year 30).',
  'CN620W': 'Next-Pinnacle 620W Bifacial Double-Glass Module. The CN620W achieves a record-high 22.95% module efficiency with 132-cell high-density architecture and an exceptional -0.28%/°C temperature coefficient. Built for utility-scale solar farms and large industrial projects with a 30-year linear power warranty (87.4% at year 30).',
  'CN720W': 'Flagship 720W Bifacial Dual-Glass Module. The CN720W achieves a leading 23.18% module efficiency with 132-cell (6×11×2) 210×105mm wafer design. Engineered for the largest utility-scale solar farms, it delivers exceptional power density and long-term reliability with a 30-year linear power warranty (87.4% at year 30).',
};

const cards = all.map((p) => ({
  slug: p.slug,
  model: p.model,
  name: p.name,
  image: cardImgMap[p.model] || p.image,
  imageAlt: p.imageAlt,
  subtitle: subtitleMap[p.model] || 'Standard Module',
  description: descMap[p.model] || '',
  pmax: getSpec(p, /Pmax/i),
  cellEff: getSpec(p, /Cell Efficiency|Module Efficiency/i),
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Callsun Standard N-Type Solar Module Series',
  itemListElement: cards.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.model,
    url: new URL(`/products/${c.slug}`, SITE.domain).href,
  })),
};
---
<BaseLayout
  title="Standard N-Type TOPCon Solar Modules | 450W, 580W, 620W, 720W | Callsun"
  description="Callsun standard N-type TOPCon solar modules — CN450W, CN580W, CN620W and CN720W bifacial dual-glass modules for commercial rooftops, industrial installations and utility-scale solar farms. Up to 23.18% efficiency, 30-year linear power warranty."
  canonical="/products/standard-modules/"
  keywords={['standard solar module', 'n type topcon solar panel', 'bifacial dual glass module', '450w solar panel', '580w solar module', '620w solar module', '720w solar module', 'utility solar module']}
  schema={schema}
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="bg-jinko-ink text-white py-20 lg:py-28">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-[0.28em] text-jinko-accent font-extrabold">Standard Modules</p>
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-display font-extrabold leading-tight max-w-4xl">
        High-Power Bifacial Modules for <span class="text-jinko-accent">Commercial & Utility Solar</span>
      </h1>
      <p class="mt-6 text-lg text-white/80 leading-relaxed max-w-3xl">
        Callsun standard N-type TOPCon module lineup covers 450W to 720W output, engineered for commercial rooftops, industrial installations and utility-scale solar farms. Up to 23.18% module efficiency, dual-glass construction, 30-year linear power warranty.
      </p>
    </div>
  </section>

  <!-- 纵列交替卡片，仿截图布局 -->
  {cards.map((c, i) => {
    const isOdd = i % 2 === 0;
    const bg = isOdd ? 'bg-white' : 'bg-jinko-bg';
    return (
      <section class={`${bg} text-jinko-ink py-12 lg:py-20`}>
        <div class="max-w-content mx-auto px-4 lg:px-6">
          <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            {isOdd ? (
              <>
                <!-- 左图 -->
                <div>
                  <img src={c.image} alt={c.imageAlt || c.name} class="w-full h-auto object-contain" loading="lazy" />
                </div>
                <!-- 右文 -->
                <div>
                  <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">STANDARD MODULE · {String(i + 1).padStart(2, '0')} OF {String(cards.length).padStart(2, '0')}</p>
                  <h2 class="mt-3 text-4xl md:text-5xl lg:text-6xl font-display font-extrabold leading-tight text-jinko-ink">
                    {c.model}
                  </h2>
                  <p class="mt-2 text-base text-jinko-mute font-semibold">{c.subtitle}</p>
                  <div class="mt-4 flex flex-wrap items-center gap-3">
                    <span class="inline-block px-4 py-1.5 bg-jinko-accent text-white font-bold text-sm rounded">{c.pmax}</span>
                    <span class="text-sm text-jinko-mute"><span class="text-jinko-ink font-semibold">Module Efficiency</span> {c.cellEff}</span>
                  </div>
                  <p class="mt-6 text-jinko-mute leading-relaxed">{c.description}</p>
                  <a href={`/products/${c.slug}/`} class="mt-6 inline-flex items-center text-jinko font-bold uppercase tracking-wider text-sm hover:text-jinko-accent transition gap-2">
                    View Product Details
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </>
            ) : (
              <>
                <!-- 左文 -->
                <div>
                  <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">STANDARD MODULE · {String(i + 1).padStart(2, '0')} OF {String(cards.length).padStart(2, '0')}</p>
                  <h2 class="mt-3 text-4xl md:text-5xl lg:text-6xl font-display font-extrabold leading-tight text-jinko-ink">
                    {c.model}
                  </h2>
                  <p class="mt-2 text-base text-jinko-mute font-semibold">{c.subtitle}</p>
                  <div class="mt-4 flex flex-wrap items-center gap-3">
                    <span class="inline-block px-4 py-1.5 bg-jinko-accent text-white font-bold text-sm rounded">{c.pmax}</span>
                    <span class="text-sm text-jinko-mute"><span class="text-jinko-ink font-semibold">Module Efficiency</span> {c.cellEff}</span>
                  </div>
                  <p class="mt-6 text-jinko-mute leading-relaxed">{c.description}</p>
                  <a href={`/products/${c.slug}/`} class="mt-6 inline-flex items-center text-jinko font-bold uppercase tracking-wider text-sm hover:text-jinko-accent transition gap-2">
                    View Product Details
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
                <!-- 右图 -->
                <div>
                  <img src={c.image} alt={c.imageAlt || c.name} class="w-full h-auto object-contain" loading="lazy" />
                </div>
              </>
            )}
          </div>
        </div>
      </section>
    );
  })}

  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>