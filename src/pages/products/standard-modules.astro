---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import { SITE } from '@/data/site';

const all = (await getCollection('products'))
  .filter((p) => p.data.category === 'standard-module')
  .map((p) => p.data)
  .filter((p) => ['450w-double-glass-solar-module', '580w-n-type-solar-module', '620w-n-type-solar-module', '720w-n-type-solar-module'].includes(p.slug))
  .sort((a, b) => (a.order || 0) - (b.order || 0));

const getSpec = (p, re) => p.specs.find((s) => re.test(s.label))?.value || '';

const cardImgMap = {
  'CN450W': '/uploads/callsun/products/450w/01-front.jpg',
  'CN580W': '/uploads/callsun/products/580w/front-back.jpg',
  'CN620W': '/uploads/callsun/products/620w/front-back.jpg',
  'CN720W': '/uploads/callsun/products/720w/front-back.jpg',
};

const subtitleMap = {
  'CN450W': 'Double Glass Module',
  'CN580W': 'N-Type Bifacial Module',
  'CN620W': 'N-Type Bifacial Module',
  'CN720W': 'N-Type Bifacial Dual-Glass',
};

const summaryMap = {
  'CN450W': 'Bifacial double-glass module with 22.52% efficiency for commercial rooftops and utility solar projects.',
  'CN580W': '580W N-type bifacial dual-glass module at 22.45% efficiency with 30-year linear power warranty (87.4% at year 30).',
  'CN620W': 'Record-high 22.95% efficiency with 132-cell high-density architecture and exceptional -0.28%/°C temperature coefficient.',
  'CN720W': 'Flagship 720W bifacial dual-glass at 23.18% efficiency with 132-cell (6×11×2) 210×105mm wafer design for utility-scale farms.',
};

const cards = all.map((p) => ({
  slug: p.slug,
  model: p.model,
  name: p.name,
  image: cardImgMap[p.model] || p.image,
  imageAlt: p.imageAlt,
  subtitle: subtitleMap[p.model] || 'Standard Module',
  summary: summaryMap[p.model] || '',
  pmax: getSpec(p, /Pmax/i),
  cellEff: getSpec(p, /Cell Efficiency|Module Efficiency/i),
  dimensions: getSpec(p, /Dimensions/i),
  weight: getSpec(p, /Weight/i),
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Callsun Standard N-Type Solar Module Series',
  itemListElement: cards.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.model,
    url: new URL(`/products/${c.slug}`, SITE.domain).href,
  })),
};
---
<BaseLayout
  title="Standard N-Type TOPCon Solar Modules | 450W, 580W, 620W, 720W | Callsun"
  description="Callsun standard N-type TOPCon solar modules — CN450W, CN580W, CN620W and CN720W bifacial dual-glass modules for commercial rooftops, industrial installations and utility-scale solar farms. Up to 23.18% efficiency, 30-year linear power warranty."
  canonical="/products/standard-modules/"
  keywords={['standard solar module', 'n type topcon solar panel', 'bifacial dual glass module', '450w solar panel', '580w solar module', '620w solar module', '720w solar module', 'utility solar module']}
  schema={schema}
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="bg-jinko-ink text-white py-20 lg:py-28">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-[0.28em] text-jinko-accent font-extrabold">Standard Modules</p>
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-display font-extrabold leading-tight max-w-4xl">
        High-Power Bifacial Modules for <span class="text-jinko-accent">Commercial & Utility Solar</span>
      </h1>
      <p class="mt-6 text-lg text-white/80 leading-relaxed max-w-3xl">
        Callsun standard N-type TOPCon module lineup covers 450W to 720W output, engineered for commercial rooftops, industrial installations and utility-scale solar farms. Up to 23.18% module efficiency, dual-glass construction, 30-year linear power warranty.
      </p>
    </div>
  </section>

  <!-- Cards Grid -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="grid md:grid-cols-2 gap-8 lg:gap-10">
        {cards.map((c) => (
          <a href={`/products/${c.slug}/`} class="group block bg-white border border-jinko-line hover:border-jinko-accent transition overflow-hidden">
            <div class="aspect-[4/3] overflow-hidden bg-white flex items-center justify-center p-6">
              <img src={c.image} alt={c.imageAlt || c.name} class="max-h-full w-auto object-contain group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <div class="p-6 lg:p-8 border-t border-jinko-line">
              <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{c.pmax}</p>
              <h2 class="mt-2 text-3xl font-display font-extrabold text-jinko-ink leading-tight">
                {c.model} <span class="block mt-1 text-base font-semibold text-jinko-mute">{c.subtitle}</span>
              </h2>
              <p class="mt-4 text-sm text-jinko-mute leading-relaxed">{c.summary}</p>
              <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-2 text-xs text-jinko-mute">
                <li><span class="text-jinko-ink font-bold">Pmax</span> {c.pmax}</li>
                <li><span class="text-jinko-ink font-bold">Efficiency</span> {c.cellEff}</li>
                <li class="col-span-2"><span class="text-jinko-ink font-bold">Size</span> {c.dimensions}</li>
              </ul>
              <p class="mt-6 text-jinko font-bold text-sm uppercase tracking-wider group-hover:text-jinko-accent inline-flex items-center gap-2">
                View Details
                <span aria-hidden="true">→</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>
