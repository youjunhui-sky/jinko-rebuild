---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { slugify } from '@/lib/slugify';

const modules = (await getCollection('products', p => p.data.family === 'eagle-modules'))
  .map(p => p.data).sort((a, b) => a.order - b.order);

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: modules.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `/products/${slugify(p.name)}`,
    name: p.name,
  })),
};
---
<BaseLayout
  title="EAGLE® Solar Modules — TOPCon N-Type Panels for U.S. Utility & C&I | Jinko US"
  description="Browse Jinko's full EAGLE® lineup: TOPCon G7, Tiger Neo bifacial, and more. Up to 22.7% efficiency, 30-year power warranty. Made in Florida."
  schema={itemList}
>
  <Header slot="header" />

  <section class="py-16 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <h1 class="text-4xl lg:text-5xl font-display font-extrabold">EAGLE® Solar Modules</h1>
      <p class="mt-3 text-jinko-mute text-lg max-w-2xl">
        High-powered solar module solutions for utility, C&I, and residential applications.
      </p>
    </div>
  </section>

  <section class="py-14">
    <div class="max-w-content mx-auto px-4 lg:px-6 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {modules.map((p) => (
        <a href={`/products/${slugify(p.name)}`} class="rounded-2xl border border-jinko-line bg-white shadow-card p-6 hover:-translate-y-1 transition-transform">
          <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{p.tech}</p>
          <h2 class="mt-2 text-2xl font-display font-bold">{p.name}</h2>
          <p class="mt-2 text-jinko-mute">{p.tagline}</p>
          {p.powerRangeW && (
            <p class="mt-4 text-sm"><strong>{p.powerRangeW[0]}–{p.powerRangeW[1]} W</strong>{p.efficiencyPct ? ` · ${p.efficiencyPct}% efficiency` : ''}</p>
          )}
        </a>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
