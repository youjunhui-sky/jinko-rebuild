---
// 改造后的首页 — 数据从 Content Collections 来 (Decap CMS 编辑)
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import TrustPillars from '@/components/TrustPillars.astro';
import { SITE } from '@/data/site';
import { slugify } from '@/lib/slugify';

// 📦 产品 (按 order 排序)
const allProducts = await getCollection('products');
const products = allProducts.map(p => p.data).sort((a, b) => a.order - b.order);

// 📊 KPI
const statsEntry = await getEntry('stats', 'homepage');
const stats = statsEntry?.data.items.sort((a, b) => a.order - b.order) ?? [];

// 📰 精选新闻 (最多 3 条)
const allNews = await getCollection('news', n => !n.data.draft);
const featuredNews = allNews
  .filter(n => n.data.featured)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

// 🏗️ 项目案例 (最多 3 个)
const allCases = await getCollection('cases');
const featuredCases = allCases
  .filter(c => c.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.domain,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.domain}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---
<BaseLayout
  title="Jinko US — U.S. Solar Panels + LFP Battery Storage | EAGLE® Modules"
  description="Jinko (NYSE: JKS) — Bloomberg Tier 1 solar panel manufacturer. EAGLE® TOPCon modules and EAGLE Storage® LFP batteries. Made in Jacksonville, FL since 2018."
  hreflang={[
    { lang: 'es-MX', href: 'https://jinko-rebuild.youjh120608.workers.dev/es/' },
    { lang: 'zh-CN', href: 'https://jinko-rebuild.youjh120608.workers.dev/zh/' },
  ]}
  schema={homeSchema}
>
  <Header slot="header" />

  <!-- HERO + 动态 KPI + 背景实拍 -->
  <section class="relative overflow-hidden text-white">
    <!-- 背景大图 (热载, 高清) -->
    <img
      src="/hero/home-utility.jpg"
      alt="Jinko solar panels deployed at utility scale"
      class="absolute inset-0 w-full h-full object-cover"
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
    />
    <!-- 叠加渐变蒙版 (保证文字可读) -->
    <div class="absolute inset-0 bg-gradient-to-br from-jinko-dark/95 via-jinko/85 to-sky-700/70"></div>
    <div class="absolute inset-0 opacity-30 pointer-events-none"
         style="background-image:radial-gradient(circle at 20% 20%, rgba(255,180,0,.6), transparent 40%), radial-gradient(circle at 80% 30%, rgba(255,255,255,.2), transparent 50%);"></div>
    <div class="max-w-content mx-auto px-4 lg:px-6 py-20 lg:py-28 relative">
      <p class="inline-block text-xs tracking-widest uppercase font-semibold text-jinko-accent bg-white/10 px-3 py-1 rounded-full">
        NYSE: JKS · Bloomberg Tier 1 · Made in Jacksonville, FL
      </p>
      <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-display font-extrabold leading-tight max-w-3xl">
        U.S. Solar Panels <span class="text-jinko-accent">+</span> Battery Storage,<br />
        From One Trusted Manufacturer
      </h1>
      <p class="mt-5 text-lg lg:text-xl text-sky-100 max-w-2xl leading-relaxed">
        EAGLE® TOPCon modules and EAGLE Storage® LFP batteries — engineered for U.S. utility, commercial, and residential projects.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/eagle-modules" class="inline-flex items-center px-6 py-3 rounded-md bg-jinko-accent text-jinko-ink font-semibold hover:opacity-90">Explore EAGLE® →</a>
        <a href="/installer-finder" class="inline-flex items-center px-6 py-3 rounded-md bg-white/10 text-white font-semibold ring-1 ring-white/20">Find an Installer</a>
      </div>

      <dl class="mt-14 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6 max-w-4xl">
        {stats.map((s) => (
          <div>
            <dt class="text-xs uppercase tracking-wider text-sky-200">{s.label}</dt>
            <dd class="mt-1 text-2xl lg:text-3xl font-display font-extrabold text-white">
              {s.value}<span class="text-jinko-accent text-lg ml-1">{s.unit}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- PRODUCTS (来自 CMS) -->
  <section class="py-20 lg:py-24">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <h2 class="text-3xl lg:text-4xl font-display font-extrabold max-w-2xl">
        One Lineup. Solar + Storage. Made in America.
      </h2>
      <ul class="mt-12 grid gap-6 md:grid-cols-3">
        {products.map((p) => (
          <li class="group rounded-2xl border border-jinko-line bg-white shadow-card overflow-hidden hover:-translate-y-1 transition-transform">
            <a href={`/products/${slugify(p.name)}`} class="block">
              <div class="aspect-[4/3] bg-jinko-bg overflow-hidden flex items-center justify-center">
                {p.image
                  ? <img src={p.image} alt={p.name} loading="lazy" decoding="async" width="480" height="360" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
                  : <span class="text-jinko-mute text-sm">[{p.name}]</span>
                }
              </div>
              <div class="p-6">
                <p class="text-xs uppercase tracking-wider text-jinko-accent font-bold">{p.tech}</p>
                <h3 class="mt-2 text-xl font-display font-bold group-hover:text-jinko">{p.name}</h3>
                <p class="mt-2 text-sm text-jinko-mute leading-relaxed">{p.tagline}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <TrustPillars />

  <!-- 🏭 FACTORY SHOWCASE (街道仅 · 全幅背景图 + 数据叠加) -->
  <section aria-labelledby="factory-title" class="relative isolate overflow-hidden text-white">
    <img
      src="/factory/jacksonville.jpg"
      alt="Jinko Jacksonville, Florida manufacturing facility"
      class="absolute inset-0 w-full h-full object-cover"
      width="1920"
      height="800"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-jinko-dark/95 via-jinko-dark/80 to-jinko-dark/40"></div>

    <div class="max-w-content mx-auto px-4 lg:px-6 py-24 lg:py-32 relative grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-xs uppercase tracking-widest font-bold text-jinko-accent">USA · FL · JAX</p>
        <h2 id="factory-title" class="mt-3 text-4xl lg:text-5xl font-display font-extrabold leading-tight">
          A look inside our<br />Jacksonville, FL factory.
        </h2>
        <p class="mt-5 text-lg text-sky-100 leading-relaxed max-w-lg">
          400 MW of annual U.S. solar module production. Qualifying for IRA Domestic Content Bonus Credit — helping developers unlock up to 10% additional tax credits.
        </p>
        <a href="/jacksonville" class="mt-6 inline-flex items-center px-5 py-3 rounded-md bg-jinko-accent text-jinko-ink font-semibold hover:opacity-90">
          Tour the factory →
        </a>
      </div>
      <dl class="grid grid-cols-2 gap-6">
        {[
          { v: '400 MW', l: 'Annual production' },
          { v: '2018', l: 'In operation since' },
          { v: '500+', l: 'Local jobs created' },
          { v: '10%', l: 'IRA bonus credit eligible' },
        ].map((s) => (
          <div class="backdrop-blur bg-white/10 ring-1 ring-white/20 rounded-2xl p-5">
            <p class="text-3xl font-display font-extrabold text-jinko-accent">{s.v}</p>
            <p class="mt-1 text-sm text-sky-100">{s.l}</p>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 🏗️ CASE STUDIES (来自 CMS) -->
  {featuredCases.length > 0 && (
    <section aria-labelledby="cases-title" class="py-20 lg:py-24">
      <div class="max-w-content mx-auto px-4 lg:px-6">
        <div class="flex items-end justify-between flex-wrap gap-4">
          <div>
            <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Project Spotlight</p>
            <h2 id="cases-title" class="mt-2 text-3xl lg:text-4xl font-display font-extrabold">Powering Real Projects</h2>
          </div>
          <a href="/case-studies" class="text-jinko font-semibold">All case studies →</a>
        </div>
        <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {featuredCases.map((c) => (
            <li class="group rounded-2xl overflow-hidden bg-white border border-jinko-line shadow-card hover:-translate-y-1 transition-transform">
              <a href={`/case-studies/${c.id.replace(/\.json$/, '')}`} class="block">
                <div class="aspect-[16/10] overflow-hidden bg-jinko-bg">
                  <img src={c.data.coverImage} alt={c.data.title} loading="lazy" decoding="async" width="640" height="400" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
                </div>
                <div class="p-6">
                  <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{c.data.application} · {c.data.location}</p>
                  <h3 class="mt-2 text-lg font-display font-bold leading-snug group-hover:text-jinko">{c.data.title}</h3>
                  {c.data.capacityMW && (
                    <p class="mt-3 text-2xl font-display font-extrabold text-jinko">
                      {c.data.capacityMW >= 1 ? `${c.data.capacityMW} MW` : `${(c.data.capacityMW * 1000).toFixed(0)} kW`}
                    </p>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- LATEST NEWS (来自 CMS) -->
  {featuredNews.length > 0 && (
    <section class="py-20 bg-jinko-bg">
      <div class="max-w-content mx-auto px-4 lg:px-6">
        <div class="flex items-end justify-between flex-wrap gap-4">
          <h2 class="text-3xl lg:text-4xl font-display font-extrabold">Latest News & Insights</h2>
          <a href="/news" class="text-jinko font-semibold">All news →</a>
        </div>
        <ul class="mt-10 grid gap-6 md:grid-cols-3">
          {featuredNews.map((n) => (
            <li class="rounded-2xl bg-white border border-jinko-line shadow-card overflow-hidden">
              <a href={`/news/${n.slug}`} class="block">
                <div class="aspect-[16/9] overflow-hidden bg-jinko-bg">
                  {n.data.cover
                    ? <img src={n.data.cover} alt={n.data.title} loading="lazy" decoding="async" width="640" height="360" class="w-full h-full object-cover" />
                    : <div class="w-full h-full flex items-center justify-center text-xs text-jinko-mute">[no cover]</div>
                  }
                </div>
                <div class="p-6">
                  <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{n.data.category}</p>
                  <h3 class="mt-2 font-display font-bold text-lg leading-snug line-clamp-2">{n.data.title}</h3>
                  <p class="mt-2 text-sm text-jinko-mute line-clamp-2">{n.data.description}</p>
                  <p class="mt-3 text-xs text-jinko-mute">
                    {n.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>
