---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import CardGrid from '@/components/CardGrid.astro';
import { SITE } from '@/data/site';

const homepageEntries = await getCollection('homepage');
const home = homepageEntries[0].data;
const products = (await getCollection('products')).map(p => p.data).sort((a,b)=>a.order-b.order).slice(0, 8);

const productCards = products.map(p => ({ title: p.name, description: p.tagline, href: `/products/${p.slug}`, eyebrow: p.model || p.category, image: p.cardImage || p.image, imageAspectRatio: p.cardImageAspectRatio }));

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.domain,
  potentialAction: { '@type': 'SearchAction', target: `${SITE.domain}/search?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
};
---
<BaseLayout title={home.seoTitle || SITE.defaultTitle} description={home.metaDescription || SITE.defaultDescription} canonical={home.canonical || '/'} ogImage={home.ogImage || SITE.defaultOgImage} noindex={home.noindex} keywords={home.keywords} schema={homeSchema}>
  <Header slot="header" />

  <!-- 1. HERO — About v4 风格：暗底 image opacity + gradient overlay -->
  <section class="relative overflow-hidden bg-jinko-ink">
    <img
      src={home.hero.image}
      alt={home.hero.imageAlt || home.hero.title}
      class="absolute inset-0 w-full h-full object-cover object-center opacity-60"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-jinko-ink via-jinko-ink/80 to-transparent"></div>
    <div class="relative max-w-content mx-auto px-4 lg:px-6 py-28 lg:py-40">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-[0.28em] text-jinko-accent font-extrabold">{home.hero.eyebrow}</p>
        <h1 class="mt-6 text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-white leading-[1.1]">
          {home.hero.title}
        </h1>
        <p class="mt-8 text-base md:text-lg text-white/85 leading-relaxed max-w-2xl">
          {home.hero.description}
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href={home.hero.primaryCtaHref} data-track-click="product_inquiry_button" data-track-location="home_hero" class="inline-flex items-center px-7 py-4 bg-jinko-accent text-jinko-ink font-bold hover:bg-jinko-accent/90 transition">{home.hero.primaryCtaLabel}</a>
          <a href={home.hero.secondaryCtaHref} class="inline-flex items-center px-7 py-4 border border-white/40 text-white font-bold hover:bg-white/10 transition">{home.hero.secondaryCtaLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 1b. STATS BAND — 与 About v4 一致 -->
  {home.stats.length > 0 && <section class="bg-jinko-ink border-t border-white/10">
    <div class="max-w-content mx-auto px-4 lg:px-6 py-14 lg:py-16">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-4">
        {home.stats.map((s, i) => (
          <div class={`text-center lg:text-left ${i > 0 ? 'lg:border-l lg:border-white/10 lg:pl-8' : ''}`}>
            <p class="text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-white leading-none">{s.value}</p>
            <div class="mt-3 flex items-center gap-2 justify-center lg:justify-start">
              <span class="w-2 h-2 bg-jinko-accent"></span>
              <p class="text-[11px] uppercase tracking-[0.22em] text-white/70 font-semibold">{s.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>}

  <!-- 2. 产品橱窗 -->
  {home.productsSection.visible && <section class="py-20 lg:py-24 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="flex items-end justify-between flex-wrap gap-4">
        <SectionHeader eyebrow={home.productsSection.eyebrow} title={home.productsSection.title} description={home.productsSection.description} />
        {home.productsSection.linkHref && <a href={home.productsSection.linkHref} class="text-jinko font-semibold">{home.productsSection.linkLabel || 'Learn more →'}</a>}
      </div>
      <div class="mt-12"><CardGrid items={productCards} imageFit="contain" showDescription={false} ctaStyle="button" /></div>
    </div>
  </section>}

  <!-- 3. 证书 -->
  {home.certificationsSection?.visible && <section class="py-20 lg:py-24 bg-white">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xs uppercase tracking-[0.28em] text-jinko-accent font-extrabold">{home.certificationsSection.eyebrow}</p>
        <h2 class="mt-4 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-jinko-ink leading-tight">
          {home.certificationsSection.title}
        </h2>
        {home.certificationsSection.description && <p class="mt-6 text-jinko-mute leading-relaxed text-base lg:text-lg">
          {home.certificationsSection.description}
        </p>}
      </div>
      <div class="mt-12 lg:mt-14">
        <img
          src={home.certificationsSection.image}
          alt={home.certificationsSection.imageAlt || home.certificationsSection.title}
          class="w-full h-auto"
          loading="lazy"
        />
      </div>
    </div>
  </section>}

  <!-- 4. 全球市场地图 -->
  {home.globalSection?.visible && <section class="py-20 lg:py-24 bg-jinko-ink">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-[0.28em] text-jinko-accent font-extrabold">{home.globalSection.eyebrow}</p>
        <h2 class="mt-4 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-white leading-tight">
          {home.globalSection.title}
        </h2>
        {home.globalSection.description && <p class="mt-6 text-white/80 leading-relaxed text-base lg:text-lg">
          {home.globalSection.description}
        </p>}
      </div>

      <div class="mt-14 border border-white/10 bg-white/5 p-6 lg:p-10">
        <img
          src={home.globalSection.image}
          alt={home.globalSection.imageAlt || home.globalSection.title}
          class="w-full h-auto"
          loading="lazy"
        />
        {home.globalSection.markets.length > 0 && <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 justify-center items-center border-t border-white/10 pt-6">
          <p class="text-[10px] uppercase tracking-[0.24em] text-jinko-accent font-bold">Manufacturing & Logistics Network</p>
          {home.globalSection.markets.map((m) => (
            <span class="text-[11px] uppercase tracking-[0.22em] text-white/70 font-semibold">· {m}</span>
          ))}
        </div>}
      </div>
    </div>
  </section>}

  <!-- 5. 询盘联络 -->
  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>
