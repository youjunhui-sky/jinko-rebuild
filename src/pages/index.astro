---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import StatStrip from '@/components/StatStrip.astro';
import CardGrid from '@/components/CardGrid.astro';
import { SITE } from '@/data/site';

const products = (await getCollection('products')).map(p => p.data).sort((a,b)=>a.order-b.order).slice(0, 6);
const solutions = (await getCollection('solutions')).map(s => s.data).filter(s=>s.featured).sort((a,b)=>a.order-b.order);
const cases = (await getCollection('cases')).map(c => c.data).filter(c=>c.featured).sort((a,b)=>a.order-b.order).slice(0, 4);
const news = (await getCollection('news', n => !n.data.draft)).sort((a,b)=>b.data.publishDate.getTime()-a.data.publishDate.getTime()).slice(0, 3);

const productCards = products.map(p => ({ title: p.name, description: p.tagline, href: `/products/${p.slug}`, eyebrow: p.model || p.category, image: p.image }));
const solutionCards = solutions.map(s => ({ title: s.title, description: s.summary, href: `/solutions/${s.slug}`, eyebrow: s.type, image: s.image, metric: s.capacityLabel }));
const caseCards = cases.map(c => ({ title: c.title, description: c.salesAngle || c.description, href: `/cases/${c.slug}`, eyebrow: `${c.segment} · ${c.location}`, image: c.coverImage, metric: c.capacityKW ? (c.capacityKW >= 1000 ? `${c.capacityKW / 1000}MW` : `${c.capacityKW}kW`) : undefined }));

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.domain,
  potentialAction: { '@type': 'SearchAction', target: `${SITE.domain}/search?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
};
---
<BaseLayout title={SITE.defaultTitle} description={SITE.defaultDescription} schema={homeSchema}>
  <Header slot="header" />

  <section class="relative overflow-hidden text-white">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_10%,rgba(251,191,36,.28),transparent_30%),radial-gradient(circle_at_80%_20%,rgba(14,165,233,.22),transparent_34%),linear-gradient(135deg,#0f172a,#0f766e_48%,#134e4a)]"></div>
    <div class="absolute inset-0 opacity-25" style="background-image:linear-gradient(rgba(255,255,255,.12) 1px, transparent 1px),linear-gradient(90deg, rgba(255,255,255,.12) 1px, transparent 1px);background-size:52px 52px;"></div>
    <div class="max-w-content mx-auto px-4 lg:px-6 py-24 lg:py-32 relative grid lg:grid-cols-[1.1fr_.9fr] gap-12 items-center">
      <div>
        <p class="inline-flex items-center gap-2 text-xs tracking-widest uppercase font-bold text-jinko-accent bg-white/10 px-3 py-1.5 rounded-full ring-1 ring-white/15">Callsun B2B Solar Platform</p>
        <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-display font-extrabold leading-tight max-w-4xl">
          Sell solar modules, storage packages and C&I systems with less project friction.
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-sky-100 max-w-2xl leading-relaxed">
          Callsun provides a structured product and solution portfolio for distributors, dealers and EPC installers: module specs, repeatable system packages, sales-ready case references and inquiry-focused landing pages.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/products" data-track-click="product_inquiry_button" data-track-location="home_hero" class="inline-flex items-center px-6 py-3 rounded-md bg-jinko-accent text-jinko-ink font-bold hover:opacity-90">Explore Products →</a>
          <a href="/solutions" class="inline-flex items-center px-6 py-3 rounded-md bg-white/10 text-white font-semibold ring-1 ring-white/20 hover:bg-white/15">View System Packages</a>
          <a href="/contact" data-track-click="inquiry_cta" data-track-location="home_hero" class="inline-flex items-center px-6 py-3 rounded-md bg-white text-jinko-ink font-semibold hover:bg-slate-100">Request Quote</a>
        </div>
      </div>
      <div class="relative">
        <div class="rounded-[2rem] bg-white/10 ring-1 ring-white/20 p-4 backdrop-blur shadow-2xl">
          <img src="/placeholders/battery-system.svg" alt="Callsun solar and storage package placeholder" width="900" height="680" class="rounded-[1.5rem] w-full object-cover" />
        </div>
        <div class="absolute -bottom-6 -left-6 bg-white text-jinko-ink rounded-2xl shadow-card p-5 max-w-xs hidden sm:block">
          <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">For U.S. partners</p>
          <p class="mt-2 font-display font-extrabold text-2xl">Distributors · Dealers · EPC</p>
          <p class="mt-1 text-sm text-jinko-mute">Built around quality, supply flexibility and repeatable C&I references.</p>
        </div>
      </div>
    </div>
  </section>

  <StatStrip />

  <section class="py-20 lg:py-24">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <SectionHeader eyebrow="Why Callsun" title="Answer the three questions every B2B solar buyer asks." description="The site now directly addresses product reliability, delivery flexibility and repeatable experience — the key concerns of distributors, dealers and EPC installers." />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <article class="rounded-2xl bg-white border border-jinko-line shadow-card p-7"><p class="text-3xl">01</p><h3 class="mt-4 text-xl font-display font-bold">Will product quality reduce after-sales risk?</h3><p class="mt-3 text-jinko-mute">Product pages emphasize certifications, warranty placeholders, specs and image-alt SEO fields so buyers can evaluate reliability.</p></article>
        <article class="rounded-2xl bg-white border border-jinko-line shadow-card p-7"><p class="text-3xl">02</p><h3 class="mt-4 text-xl font-display font-bold">Can supply match project schedules?</h3><p class="mt-3 text-jinko-mute">The CMS supports module families, system packages and future MOQ/logistics policies for faster sales conversations.</p></article>
        <article class="rounded-2xl bg-white border border-jinko-line shadow-card p-7"><p class="text-3xl">03</p><h3 class="mt-4 text-xl font-display font-bold">Are there proven projects to copy?</h3><p class="mt-3 text-jinko-mute">Case pages convert commercial rooftop, auto dealership and solar-plus-storage references into sales narratives.</p></article>
      </div>
    </div>
  </section>

  <section class="py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <SectionHeader eyebrow="Products" title="Solar modules structured for SEO, datasheets and inquiry conversion." description="The product center is CMS-driven. Each product supports specs, certifications, downloads, image alt text and SEO metadata." />
      <div class="mt-12"><CardGrid items={productCards} /></div>
    </div>
  </section>

  <section class="py-20 lg:py-24">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="flex items-end justify-between flex-wrap gap-4">
        <SectionHeader eyebrow="Solutions" title="Repeatable packages for grid-tied and off-grid sales." description="System pages turn product components into package-level landing pages for Google Ads, SEO and distributor conversations." />
        <a href="/solutions" class="text-jinko font-semibold">All solutions →</a>
      </div>
      <div class="mt-12"><CardGrid items={solutionCards} /></div>
    </div>
  </section>

  <section class="py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="flex items-end justify-between flex-wrap gap-4">
        <SectionHeader eyebrow="Cases" title="Sales-ready references for the U.S. distributor channel." description="Each case includes a sales angle, capacity, segment and application — not just a photo gallery." />
        <a href="/cases" class="text-jinko font-semibold">All cases →</a>
      </div>
      <div class="mt-12"><CardGrid items={caseCards} columns="4" /></div>
    </div>
  </section>

  <section class="py-20 lg:py-24">
    <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-[.9fr_1.1fr] gap-12 items-start">
      <SectionHeader eyebrow="SEO + SEM ready" title="The marketing stack is reserved before the first ad dollar is spent." description="GTM, GA4, Google Ads conversion IDs, Cookie Consent and dataLayer events are already structured. When the customer provides account IDs, tracking can be enabled without rebuilding the site architecture." />
      <div class="grid gap-4 sm:grid-cols-2">
        {['GTM Container placeholder', 'GA4 Measurement placeholder', 'Google Ads Conversion placeholder', 'Cookie Consent base layer', 'Contact / RFQ submit event', 'Email / WhatsApp / download events'].map((item) => <div class="rounded-2xl border border-jinko-line bg-white p-5 shadow-card"><p class="font-semibold text-jinko-ink">✓ {item}</p></div>)}
      </div>
    </div>
  </section>

  {news.length > 0 && <section class="py-20 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><div class="flex items-end justify-between"><SectionHeader eyebrow="Resources" title="Content hub for long-tail SEO." /><a href="/resources/blog" class="text-jinko font-semibold">Blog →</a></div><ul class="mt-10 grid gap-6 md:grid-cols-3">{news.map((n)=><li class="rounded-2xl bg-white border border-jinko-line shadow-card p-6"><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{n.data.category}</p><h3 class="mt-2 text-lg font-display font-bold"><a href={`/resources/blog/${n.slug}`}>{n.data.title}</a></h3><p class="mt-2 text-sm text-jinko-mute">{n.data.description}</p></li>)}</ul></div></section>}

  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>
