---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
const solutions = (await getCollection('solutions')).map(s=>s.data).sort((a,b)=>a.order-b.order);
const groups = [{id:'grid-tied',label:'Grid-Tied Systems',items:solutions.filter(s=>s.type==='grid-tied')},{id:'off-grid',label:'Off-Grid Systems',items:solutions.filter(s=>s.type==='off-grid')}];
---
<BaseLayout title="Solar Solutions | Callsun" description="Callsun grid-tied and off-grid solar storage system packages for B2B installers and dealers.">
<Header slot="header" />
<section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Solutions</p><h1 class="mt-2 text-4xl lg:text-5xl font-display font-extrabold">Installer-ready solar system packages</h1><p class="mt-4 text-lg text-jinko-mute max-w-3xl">Repeatable grid-tied and off-grid packages with modules, inverters, batteries and accessories structured for future BOM downloads and inquiry conversion.</p></div></section>
{groups.map(group => <section id={group.id} class="py-14"><div class="max-w-content mx-auto px-4 lg:px-6"><h2 class="text-3xl font-display font-extrabold">{group.label}</h2><ul class="mt-8 grid gap-6 md:grid-cols-3">{group.items.map(s=><li class="rounded-2xl bg-white border border-jinko-line shadow-card p-6"><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{s.type}</p><h3 class="mt-2 text-xl font-display font-bold"><a href={`/solutions/${s.slug}`}>{s.title}</a></h3><p class="mt-2 text-2xl font-display font-extrabold text-jinko">{s.capacityLabel}</p><p class="mt-3 text-sm text-jinko-mute">{s.summary}</p><a href={`/solutions/${s.slug}`} class="mt-5 inline-block text-jinko font-semibold">View solution →</a></li>)}</ul></div></section>)}
<Footer slot="footer" />
</BaseLayout>
