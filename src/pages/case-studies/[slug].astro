---
import BaseLayout from '@/layouts/BaseLayout.astro';
export async function getStaticPaths() { return []; }
---
<BaseLayout title="Cases moved | Callsun" description="This page has moved." noindex={true}>
  <meta http-equiv="refresh" content="0;url=/cases" />
  <script is:inline>window.location.replace("/cases");</script>
  <section class="py-20 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><h1 class="text-4xl font-display font-extrabold">This page has moved</h1><p class="mt-4 text-jinko-mute">Redirecting to <a href="/cases" class="text-jinko font-semibold">/cases</a>...</p></div></section>
</BaseLayout>
