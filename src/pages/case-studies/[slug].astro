---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
export async function getStaticPaths() { return []; }
---
<BaseLayout title="Case Study moved | Callsun" description="Callsun project cases are now available under /cases.">
  <Header slot="header" />
  <section class="py-20 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><h1 class="text-4xl font-display font-extrabold">Case study moved</h1><p class="mt-4 text-jinko-mute">Please use the new Callsun project cases library.</p><a href="/cases" class="mt-6 inline-flex px-5 py-3 rounded-md bg-jinko text-white font-semibold">Go to Cases</a></div></section>
  <Footer slot="footer" />
</BaseLayout>
