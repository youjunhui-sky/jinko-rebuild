---
// Case Studies 列表页 (CMS 驱动, 自动生成)
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const cases = (await getCollection('cases'))
  .sort((a, b) => b.data.completedAt.getTime() - a.data.completedAt.getTime());

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: cases.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `/case-studies/${c.id.replace(/\.json$/, '')}`,
    name: c.data.title,
  })),
};
---
<BaseLayout
  title="Case Studies — Real Jinko Solar + Storage Deployments | Jinko US"
  description="Real-world Jinko EAGLE® solar and storage projects: utility-scale, commercial, and residential deployments across the U.S. and Canada."
  schema={itemList}
>
  <Header slot="header" />

  <section class="py-16 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Real Projects · Real Results</p>
      <h1 class="mt-2 text-4xl lg:text-5xl font-display font-extrabold">Case Studies</h1>
      <p class="mt-3 text-jinko-mute text-lg max-w-2xl">
        Deployments powered by Jinko EAGLE® modules and EAGLE Storage® batteries.
      </p>
    </div>
  </section>

  <section class="py-14">
    <div class="max-w-content mx-auto px-4 lg:px-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {cases.map((c) => (
        <article class="group rounded-2xl overflow-hidden bg-white border border-jinko-line shadow-card hover:-translate-y-1 transition-transform">
          <a href={`/case-studies/${c.id.replace(/\.json$/, '')}`} class="block">
            <div class="aspect-[16/10] overflow-hidden bg-jinko-bg">
              <img src={c.data.coverImage} alt={c.data.title} loading="lazy" decoding="async" width="640" height="400" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
            </div>
            <div class="p-6">
              <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{c.data.application} · {c.data.location}</p>
              <h2 class="mt-2 text-lg font-display font-bold leading-snug group-hover:text-jinko">{c.data.title}</h2>
              <p class="mt-2 text-sm text-jinko-mute line-clamp-2">{c.data.description}</p>
              {c.data.capacityMW && (
                <p class="mt-3 text-2xl font-display font-extrabold text-jinko">
                  {c.data.capacityMW >= 1 ? `${c.data.capacityMW} MW` : `${(c.data.capacityMW * 1000).toFixed(0)} kW`}
                </p>
              )}
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
