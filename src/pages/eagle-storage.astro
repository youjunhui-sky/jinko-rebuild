---
// EAGLE Storage® 储能产品聚合页 (CMS 驱动: 拉所有 family=eagle-storage 的产品)
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { slugify } from '@/lib/slugify';

const storage = (await getCollection('products', p => p.data.family === 'eagle-storage'))
  .map(p => p.data).sort((a, b) => a.order - b.order);

const FEATURES = [
  { icon: '🔋', t: 'Safe LFP Chemistry', d: 'Lithium iron phosphate cells — the safest, longest-lasting battery chemistry in the industry.' },
  { icon: '⚡', t: 'Seamless Solar Integration', d: 'Paired with EAGLE® modules for true one-vendor solar + storage projects.' },
  { icon: '🏭', t: 'Scales from 5 kWh to MW+', d: 'Residential home batteries up to multi-MWh utility containers.' },
  { icon: '🛡️', t: '10-Year Warranty', d: 'Industry-leading product and capacity warranty backed by NYSE-listed Jinko.' },
];

const APPS = [
  { name: 'Residential', kwh: '5 – 27 kWh', desc: 'Backup power for U.S. homes during outages. Self-consumption optimization. Hurricane resilience.', image: '/cases/florida-residential.jpg' },
  { name: 'Commercial & Industrial', kwh: '100 kWh – 2 MWh', desc: 'Peak demand shaving, demand charge reduction, and resilience for warehouses, retail, manufacturing.', image: '/hero/home-rooftop.jpg' },
  { name: 'Utility-Scale', kwh: '> 2 MWh', desc: 'Multi-MWh containerized solutions for grid services, time-shifting, and renewable integration.', image: '/cases/texas-utility.jpg' },
];
---
<BaseLayout
  title="EAGLE Storage® — Safe LFP Battery Storage for U.S. Solar Projects | Jinko"
  description="EAGLE Storage® LFP battery systems — from 5 kWh home batteries to multi-MWh utility containers. Paired seamlessly with EAGLE® solar modules. Made by NYSE-listed Jinko."
>
  <Header slot="header" />

  <!-- HERO -->
  <section class="relative isolate text-white overflow-hidden">
    <img src="/hero/home-rooftop.jpg" alt="EAGLE Storage battery system" class="absolute inset-0 w-full h-full object-cover" width="1920" height="800" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-r from-jinko-dark/95 via-jinko/80 to-sky-700/40"></div>
    <div class="max-w-content mx-auto px-4 lg:px-6 py-24 lg:py-32 relative">
      <p class="text-xs uppercase tracking-widest font-bold text-jinko-accent">EAGLE Storage® · LFP · Made by Jinko</p>
      <h1 class="mt-3 text-4xl lg:text-6xl font-display font-extrabold max-w-3xl leading-tight">
        Battery Storage<br />From a Solar Company You Trust.
      </h1>
      <p class="mt-5 text-lg lg:text-xl text-sky-100 max-w-2xl leading-relaxed">
        Safe LFP chemistry. Seamless solar pairing. Scales from 5 kWh home batteries to multi-MWh utility containers. Backed by a 10-year warranty.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact" class="px-6 py-3 rounded-md bg-jinko-accent text-jinko-ink font-semibold hover:opacity-90">Request a Quote</a>
        <a href="/installer-finder" class="px-6 py-3 rounded-md bg-white/10 text-white font-semibold ring-1 ring-white/20">Find an Installer</a>
      </div>
    </div>
  </section>

  <!-- 核心优势 -->
  <section class="py-20">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <h2 class="text-3xl lg:text-4xl font-display font-extrabold">Why EAGLE Storage®</h2>
      <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {FEATURES.map((f) => (
          <li class="rounded-2xl bg-white border border-jinko-line p-6 shadow-card">
            <div class="text-4xl">{f.icon}</div>
            <h3 class="mt-3 font-display font-bold text-lg">{f.t}</h3>
            <p class="mt-2 text-sm text-jinko-mute leading-relaxed">{f.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 三大应用场景 -->
  <section class="py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <h2 class="text-3xl lg:text-4xl font-display font-extrabold">One Platform · Three Markets</h2>
      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {APPS.map((a) => (
          <li class="rounded-2xl bg-white overflow-hidden shadow-card border border-jinko-line">
            <div class="aspect-[16/10] overflow-hidden">
              <img src={a.image} alt={a.name} loading="lazy" decoding="async" width="640" height="400" class="w-full h-full object-cover" />
            </div>
            <div class="p-6">
              <h3 class="font-display font-bold text-xl">{a.name}</h3>
              <p class="mt-1 text-jinko-accent font-semibold text-sm">{a.kwh}</p>
              <p class="mt-3 text-jinko-mute leading-relaxed">{a.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 产品列表 (来自 CMS, family=eagle-storage) -->
  {storage.length > 0 && (
    <section class="py-20">
      <div class="max-w-content mx-auto px-4 lg:px-6">
        <h2 class="text-3xl lg:text-4xl font-display font-extrabold">Available Products</h2>
        <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {storage.map((p) => (
            <li class="group rounded-2xl border border-jinko-line bg-white shadow-card overflow-hidden hover:-translate-y-1 transition-transform">
              <a href={`/products/${slugify(p.name)}`} class="block">
                <div class="aspect-[4/3] bg-jinko-bg overflow-hidden flex items-center justify-center">
                  {p.image
                    ? <img src={p.image} alt={p.name} loading="lazy" class="w-full h-full object-cover" />
                    : <span class="text-jinko-mute text-sm">[{p.name}]</span>
                  }
                </div>
                <div class="p-6">
                  <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{p.tech}</p>
                  <h3 class="mt-2 text-2xl font-display font-bold group-hover:text-jinko">{p.name}</h3>
                  <p class="mt-2 text-jinko-mute">{p.tagline}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <Footer slot="footer" />
</BaseLayout>
