---
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const aboutEntry = await getEntry('about', 'about');
if (!aboutEntry) throw new Error('Missing about content entry: src/content/about/about.json');
const about = aboutEntry.data;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: about.seoTitle || about.title,
  description: about.metaDescription || (Array.isArray(about.sections?.[1]?.body?.paragraphs) ? about.sections[1].body.paragraphs.join(' ') : ''),
  url: new URL(about.canonical || '/about', Astro.url.origin).href,
};

const sections = about.sections || [];
const findSection = (type) => sections.find((s) => s.type === type);

const manifesto = findSection('manifesto');
const mission = findSection('mission');
const pillars = findSection('pillars');
---
<BaseLayout
  title={about.seoTitle || `${about.title} | Callsun`}
  description={about.metaDescription}
  canonical={about.canonical || '/about'}
  ogImage={about.ogImage || manifesto?.lead?.image}
  keywords={about.keywords}
  noindex={about.noindex}
  schema={organizationSchema}
>
  <Header slot="header" />

  <!-- Section 1: Brand Manifesto — white -->
  {manifesto && (
    <>
      <section class="relative overflow-hidden bg-jinko-ink">
        <img src={manifesto.lead.image} alt={manifesto.lead.imageAlt} loading="eager" width="3840" height="1500" class="w-full h-[420px] md:h-[480px] lg:h-[560px] object-cover object-center" />
        {/* 文字层 + 渐变层临时去掉 — 东家 2026-07-11 试 hero 遮挡问题，加回时取消注释 */}
      </section>

    </>
  )}

  <!-- Section 2: Mission — light bg -->
  {mission && (
    <>
      {mission.body && (
        <section class="bg-jinko-bg">
          <div class="max-w-3xl mx-auto px-4 lg:px-6 py-16 lg:py-24 text-center">
            {Array.isArray(mission.body.paragraphs) && mission.body.paragraphs.map((para) => (
              <p class="text-lg text-jinko-ink/85 leading-relaxed mb-5 last:mb-0">{para}</p>
            ))}
          </div>
        </section>
      )}

      {mission.banner && (
        <section class="relative overflow-hidden bg-jinko-bg">
          <img src={mission.banner.image} alt={mission.banner.imageAlt} loading="lazy" width="1464" height="600" class="w-full h-56 md:h-72 lg:h-80 object-cover" />
          <div class="absolute inset-0 bg-gradient-to-b from-jinko-ink/55 via-jinko-ink/45 to-jinko-ink/65 flex items-center">
            <div class="max-w-content mx-auto px-4 lg:px-6 w-full text-center">
              {/* eyebrow 隐藏 — 东家 2026-07-11 要求去掉 "About Callsun" 字样 */}
              <h2 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold leading-tight text-white max-w-4xl mx-auto">{mission.banner.title}</h2>
            </div>
          </div>
        </section>
      )}
    </>
  )}

  <!-- Section 3: Three Pillars — image-text left-right rows, alternating sides and bg -->
  {pillars && (
    <div>
      <!-- Row 1: 段头 — image-LEFT (bg-jinko-bg) -->
      {pillars.header && (
        <section class="bg-jinko-bg">
          <div class="max-w-content mx-auto px-4 lg:px-6 py-10 lg:py-14">
            <div class="grid lg:grid-cols-2 gap-8 lg:gap-10 items-center">
              <figure>
                <img src={pillars.header.image} alt={pillars.header.imageAlt} loading="lazy" width="1600" height="1600" class="w-full h-auto rounded-2xl shadow-card object-cover" />
              </figure>
              <div>
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-extrabold leading-tight text-jinko-ink">{pillars.header.title}</h2>
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- Row 2+: 2 张支柱卡 — 镜像交替 (bg 跟 image 一起换) -->
      {Array.isArray(pillars.cards) && pillars.cards.map((card, idx) => {
        const flip = idx % 2 === 0;
        return (
          <section class={flip ? 'bg-jinko-bg' : 'bg-white'}>
            <div class="max-w-content mx-auto px-4 lg:px-6 py-8 lg:py-12">
              <div class="grid lg:grid-cols-2 gap-8 lg:gap-10 items-center">
                <figure class={flip ? 'lg:order-2' : ''}>
                  <img src={card.image} alt={card.imageAlt} loading="lazy" width="1600" height="1600" class="w-full h-auto rounded-2xl shadow-card object-cover" />
                </figure>
                <div class={flip ? 'lg:order-1' : ''}>
                  <h3 class="text-2xl lg:text-3xl font-display font-bold text-jinko-ink">{card.title}</h3>
                  <p class="mt-4 text-lg text-jinko-mute leading-relaxed">{card.description}</p>
                </div>
              </div>
            </div>
          </section>
        );
      })}

      <!-- Row 末尾: 收尾 band — image-LEFT (bg-white) -->
      {pillars.band && (
        <section class="bg-white">
          <div class="max-w-content mx-auto px-4 lg:px-6 py-10 lg:py-14">
            <div class="grid lg:grid-cols-2 gap-8 lg:gap-10 items-center">
              <figure class="lg:order-2">
                <img src={pillars.band.image} alt={pillars.band.imageAlt} loading="lazy" width="3840" height="1500" class="w-full h-auto rounded-2xl shadow-card object-cover" />
              </figure>
              <div class="lg:order-1">
                <h3 class="text-2xl lg:text-3xl font-display font-bold text-jinko-ink">{pillars.band.title}</h3>
                {pillars.band.description && <p class="mt-4 text-lg text-jinko-mute leading-relaxed">{pillars.band.description}</p>}
              </div>
            </div>
          </div>
        </section>
      )}
    </div>
  )}

  <Footer slot="footer" />
</BaseLayout>
