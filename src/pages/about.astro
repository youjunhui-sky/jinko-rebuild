---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
---
<BaseLayout title="About Callsun — B2B Solar Modules & Storage Systems" description="Callsun supplies solar modules, grid-tied systems, off-grid systems and solar-plus-storage packages for distributors, dealers and EPC installers.">
  <Header slot="header" />
  <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">About Callsun</p><h1 class="mt-2 text-4xl lg:text-5xl font-display font-extrabold">Built for B2B solar partners.</h1><p class="mt-4 text-lg text-jinko-mute max-w-3xl">Callsun focuses on solar modules, standard system packages and project references that help distributors, dealers and EPC installers sell and deliver repeatable solar projects.</p></div></section>
  <section class="py-14"><div class="max-w-content mx-auto px-4 lg:px-6 grid gap-6 md:grid-cols-3"><div class="rounded-2xl bg-white border border-jinko-line shadow-card p-7"><h2 class="text-xl font-display font-bold">Product supply</h2><p class="mt-3 text-jinko-mute">Standard and custom modules structured for B2B product pages, datasheets and inquiry conversion.</p></div><div class="rounded-2xl bg-white border border-jinko-line shadow-card p-7"><h2 class="text-xl font-display font-bold">System packages</h2><p class="mt-3 text-jinko-mute">Grid-tied and off-grid packages with modules, inverters, batteries and accessories.</p></div><div class="rounded-2xl bg-white border border-jinko-line shadow-card p-7"><h2 class="text-xl font-display font-bold">Case references</h2><p class="mt-3 text-jinko-mute">C&I rooftop, premium retail and solar-plus-storage cases for sales enablement.</p></div></div></section>
  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>
