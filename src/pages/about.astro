---
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SectionHeader from '@/components/SectionHeader.astro';

const aboutEntry = await getEntry('about', 'about');
if (!aboutEntry) throw new Error('Missing about content entry: src/content/about/about.json');
const about = aboutEntry.data;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: about.seoTitle || about.title,
  description: about.metaDescription || about.hero.description,
  url: new URL(about.canonical || '/about', Astro.url.origin).href,
};
---
<BaseLayout
  title={about.seoTitle || `${about.title} | Callsun`}
  description={about.metaDescription || about.hero.description}
  canonical={about.canonical || '/about'}
  ogImage={about.ogImage || about.hero.image}
  keywords={about.keywords}
  noindex={about.noindex}
  schema={organizationSchema}
>
  <Header slot="header" />

  <section class="relative py-24 lg:py-32 overflow-hidden bg-jinko-ink">
    <div class="absolute inset-0">
      <picture>
        {about.hero.imageMobile && <source media="(max-width: 768px)" srcset={about.hero.imageMobile} />}
        <img src={about.hero.image} alt={about.hero.imageAlt || about.title} width="3840" height="1500" class="w-full h-full object-cover" />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-b from-jinko-ink/70 via-jinko-ink/55 to-jinko-ink/85"></div>
    </div>
    <div class="relative max-w-content mx-auto px-4 lg:px-6">
      <div class="mx-auto max-w-3xl text-center text-white">
        <nav class="text-sm text-white/70 mb-5"><a href="/" class="hover:text-white">Home</a> / <span>{about.title}</span></nav>
        <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold">{about.hero.eyebrow}</p>
        <h1 class="mt-3 text-5xl lg:text-7xl font-display font-extrabold leading-[1.05] tracking-tight">{about.h1 || about.title}</h1>
        <p class="mt-5 text-lg text-white/85 leading-relaxed">{about.hero.description}</p>
        {about.hero.body && <div class="mt-8 text-lg text-white/70 leading-relaxed whitespace-pre-line text-left">{about.hero.body}</div>}
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={about.hero.primaryCtaHref} class="inline-flex px-5 py-3 rounded-md bg-jinko text-white font-semibold shadow-card hover:bg-jinko-dark transition-colors">{about.hero.primaryCtaLabel}</a>
          {about.hero.secondaryCtaLabel && about.hero.secondaryCtaHref && (
            <a href={about.hero.secondaryCtaHref} class="inline-flex px-5 py-3 rounded-md bg-white/10 backdrop-blur text-white font-semibold border border-white/30 hover:bg-white/20 transition-colors">{about.hero.secondaryCtaLabel}</a>
          )}
        </div>
      </div>
    </div>
  </section>




  <section class="py-20 lg:py-28 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <SectionHeader eyebrow={about.strengths.eyebrow} title={about.strengths.title} description={about.strengths.description} />
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {about.strengths.items.map((item) => (
          <article class="rounded-2xl bg-white border border-jinko-line shadow-card p-8 hover:-translate-y-1 hover:shadow-xl transition-all">
            <span class="inline-flex h-14 w-14 rounded-2xl bg-jinko/10 text-3xl items-center justify-center" aria-hidden="true">{item.icon}</span>
            <h3 class="mt-6 text-xl font-display font-bold text-jinko-ink">{item.title}</h3>
            <p class="mt-3 text-jinko-mute leading-relaxed">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>




  {about.hero.dividerImage && (
    <figure class="w-full">
      <img src={about.hero.dividerImage} alt={about.hero.dividerAlt || 'Callsun global projects'} loading="lazy" width="1480" height="2000" class="w-full h-64 md:h-80 lg:h-[440px] object-cover" />
    </figure>
  )}




  <section class="py-20 lg:py-28">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <SectionHeader eyebrow={about.cases.eyebrow} title={about.cases.title} description={about.cases.description} align="center" />
      <div class="mt-12 grid gap-6 grid-cols-1 sm:grid-cols-2">
        {about.cases.images.map((image) => (
          <figure class="group rounded-2xl overflow-hidden bg-jinko-bg border border-jinko-line shadow-card hover:-translate-y-1 hover:shadow-xl transition-all aspect-[4/3]">
            <img src={image.src} alt={image.alt} loading="lazy" width="640" height="480" class="w-full h-full object-cover" />
          </figure>
        ))}
      </div>
      {about.cases.ctaLabel && about.cases.ctaHref && (
        <div class="mt-10 text-center">
          <a href={about.cases.ctaHref} class="inline-flex px-5 py-3 rounded-md bg-jinko text-white font-semibold shadow-card hover:bg-jinko-dark transition-colors">{about.cases.ctaLabel}</a>
        </div>
      )}
    </div>
  </section>



  <Footer slot="footer" />
</BaseLayout>
