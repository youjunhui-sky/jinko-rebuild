---
// About 公司介绍页
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/data/site';

const TIMELINE = [
  { y: '2006', e: 'Jinko Solar founded in China — vertical integration from polysilicon to modules.' },
  { y: '2010', e: 'Listed on NYSE (ticker JKS).' },
  { y: '2016', e: 'First Bloomberg Tier 1 ranking. Cumulative shipments cross 10 GW.' },
  { y: '2018', e: '🏭 Jacksonville, FL manufacturing facility opens — first major Chinese solar maker to build in the U.S.' },
  { y: '2022', e: 'Industry-first commercial N-type TOPCon production. Tiger Neo series launched.' },
  { y: '2024', e: 'Cumulative global shipments exceed 250 GW.' },
  { y: '2026', e: 'EAGLE® G7 + EAGLE Storage® lineup — full solar + storage offering for U.S. market. 400+ GW deployed globally.' },
];

const VALUES = [
  { t: 'Vertical Integration', d: 'From polysilicon to modules, we control every step of the value chain — the source of our quality and cost leadership.', icon: '🏭' },
  { t: 'Innovation Leadership', d: 'First major manufacturer to commercialize N-type TOPCon at gigawatt scale. R&D centers in China, Switzerland, and the U.S.', icon: '🔬' },
  { t: 'Local Manufacturing', d: 'Florida-made modules qualifying for IRA Domestic Content. Supporting U.S. energy independence and local jobs.', icon: '🇺🇸' },
  { t: 'Sustainability', d: 'Carbon-neutral manufacturing roadmap. ISO 14001 certified facilities. Industry-low warranty claim rates.', icon: '🌱' },
];
---
<BaseLayout
  title="About Jinko Solar — Global Leader in PV Modules + Energy Storage | NYSE: JKS"
  description="Jinko Solar (NYSE: JKS) — a global leader in solar module manufacturing since 2006. Public on NYSE since 2010. Bloomberg Tier 1. Made in Jacksonville, FL since 2018."
>
  <Header slot="header" />

  <!-- HERO -->
  <section class="relative isolate text-white overflow-hidden">
    <img src="/factory/jacksonville.jpg" alt="Jinko Jacksonville Florida manufacturing" class="absolute inset-0 w-full h-full object-cover" width="1920" height="800" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-r from-jinko-dark/95 via-jinko-dark/80 to-jinko-dark/40"></div>
    <div class="max-w-content mx-auto px-4 lg:px-6 py-24 lg:py-32 relative">
      <p class="text-xs uppercase tracking-widest font-bold text-jinko-accent">NYSE: JKS · Since 2010</p>
      <h1 class="mt-3 text-4xl lg:text-6xl font-display font-extrabold max-w-3xl leading-tight">
        Powering 160 countries.<br />Made for America.
      </h1>
      <p class="mt-5 text-lg lg:text-xl text-sky-100 max-w-2xl leading-relaxed">
        Jinko (U.S.) Inc. is the U.S. arm of Jinko Solar — one of the world's largest and most innovative PV module manufacturers. We provide locally-based sales, support, and manufacturing for North American customers.
      </p>
    </div>
  </section>

  <!-- 关键数据 -->
  <section class="py-20">
    <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-4 gap-6">
      {[
        { v: '400+', l: 'GW deployed globally' },
        { v: '160+', l: 'Countries served' },
        { v: '2010', l: 'NYSE listed since' },
        { v: '#1', l: 'Bloomberg Tier 1' },
      ].map((s) => (
        <div class="rounded-2xl bg-jinko-bg p-7 border border-jinko-line">
          <p class="text-5xl font-display font-extrabold text-jinko">{s.v}</p>
          <p class="mt-2 text-jinko-mute leading-relaxed">{s.l}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 公司价值观 -->
  <section class="py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <h2 class="text-3xl lg:text-4xl font-display font-extrabold">What Drives Us</h2>
      <ul class="mt-10 grid gap-6 md:grid-cols-2">
        {VALUES.map((v) => (
          <li class="rounded-2xl bg-white p-7 border border-jinko-line shadow-card">
            <div class="text-3xl">{v.icon}</div>
            <h3 class="mt-3 font-display font-bold text-xl">{v.t}</h3>
            <p class="mt-2 text-jinko-mute leading-relaxed">{v.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 历史时间线 -->
  <section class="py-20">
    <div class="max-w-3xl mx-auto px-4 lg:px-6">
      <h2 class="text-3xl lg:text-4xl font-display font-extrabold">Our Journey</h2>
      <ol class="mt-10 space-y-6 relative before:absolute before:left-6 before:top-2 before:bottom-2 before:w-px before:bg-jinko-line">
        {TIMELINE.map((t) => (
          <li class="pl-16 relative">
            <span class="absolute left-0 top-0 w-12 h-12 rounded-full bg-jinko text-white flex items-center justify-center font-display font-extrabold text-sm">{t.y}</span>
            <p class="text-jinko-ink leading-relaxed">{t.e}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 联系卡 -->
  <section class="py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <h2 class="text-3xl lg:text-4xl font-display font-extrabold">U.S. Headquarters & Manufacturing</h2>
      <div class="mt-10 grid md:grid-cols-2 gap-6">
        <div class="rounded-2xl bg-white p-7 border border-jinko-line shadow-card">
          <p class="text-xs uppercase tracking-widest font-bold text-jinko-accent">U.S. HQ — Sales & Support</p>
          <p class="mt-2 text-2xl font-display font-bold">San Francisco, CA</p>
          <p class="mt-3 text-jinko-mute">
            {SITE.organization.hqAddress.street}<br />
            {SITE.organization.hqAddress.city}, {SITE.organization.hqAddress.region} {SITE.organization.hqAddress.postal}
          </p>
          <p class="mt-3 text-sm"><a href={`mailto:${SITE.organization.contact.sales}`} class="text-jinko hover:underline">{SITE.organization.contact.sales}</a></p>
          <p class="text-sm"><a href={`tel:${SITE.organization.contact.phone}`} class="text-jinko hover:underline">{SITE.organization.contact.phone}</a></p>
        </div>
        <div class="rounded-2xl bg-white p-7 border border-jinko-line shadow-card">
          <p class="text-xs uppercase tracking-widest font-bold text-jinko-accent">U.S. Manufacturing</p>
          <p class="mt-2 text-2xl font-display font-bold">Jacksonville, FL</p>
          <p class="mt-3 text-jinko-mute">
            Operating since 2018. 400 MW annual production capacity. Qualifies for IRA Domestic Content Bonus Credit.
          </p>
          <a href="/jacksonville" class="mt-4 inline-flex items-center text-jinko font-semibold hover:underline">Tour the factory →</a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
