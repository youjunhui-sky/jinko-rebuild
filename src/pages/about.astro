---
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import StatStrip from '@/components/StatStrip.astro';
import CardGrid from '@/components/CardGrid.astro';

const aboutEntry = await getEntry('about', 'about');
if (!aboutEntry) throw new Error('Missing about content entry: src/content/about/about.json');
const about = aboutEntry.data;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: about.seoTitle || about.title,
  description: about.metaDescription || about.hero.description,
  url: new URL(about.canonical || '/about', Astro.url.origin).href,
};
---
<BaseLayout
  title={about.seoTitle || `${about.title} | Callsun`}
  description={about.metaDescription || about.hero.description}
  canonical={about.canonical || '/about'}
  ogImage={about.ogImage || about.hero.image}
  keywords={about.keywords}
  noindex={about.noindex}
  schema={organizationSchema}
>
  <Header slot="header" />

  <section class="py-16 lg:py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <nav class="text-sm text-jinko-mute mb-5"><a href="/">Home</a> / <span>{about.title}</span></nav>
        <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold">{about.hero.eyebrow}</p>
        <h1 class="mt-3 text-4xl lg:text-6xl font-display font-extrabold leading-tight text-jinko-ink">{about.h1 || about.title}</h1>
        <p class="mt-5 text-lg text-jinko-mute leading-relaxed max-w-2xl">{about.hero.description}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={about.hero.primaryCtaHref} class="inline-flex px-5 py-3 rounded-md bg-jinko text-white font-semibold shadow-card hover:bg-jinko-dark transition-colors">{about.hero.primaryCtaLabel}</a>
          {about.hero.secondaryCtaLabel && about.hero.secondaryCtaHref && (
            <a href={about.hero.secondaryCtaHref} class="inline-flex px-5 py-3 rounded-md bg-white text-jinko font-semibold border border-jinko-line hover:border-jinko transition-colors">{about.hero.secondaryCtaLabel}</a>
          )}
        </div>
      </div>
      <div class="relative">
        <div class="absolute -inset-4 rounded-none bg-gradient-to-br from-jinko/10 to-jinko-accent/10 blur-2xl"></div>
        <img src={about.hero.image} alt={about.hero.imageAlt || about.title} width="720" height="520" class="relative rounded-3xl border border-jinko-line bg-white shadow-card w-full" />
      </div>
    </div>
  </section>

  <StatStrip stats={about.stats} />

  <section class="py-16 lg:py-20">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <SectionHeader eyebrow={about.intro.eyebrow} title={about.intro.title} description={about.intro.description} />
      <div class="mt-10">
        <CardGrid items={about.intro.cards} />
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <SectionHeader eyebrow={about.strengths.eyebrow} title={about.strengths.title} description={about.strengths.description} />
      <div class="mt-10">
        <CardGrid items={about.strengths.items} columns="4" />
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-[1fr_0.8fr] gap-10 items-start">
      <div class="rounded-3xl bg-jinko text-white p-8 lg:p-10 shadow-card">
        <p class="text-xs uppercase tracking-[0.22em] text-white/70 font-extrabold">{about.certifications.eyebrow}</p>
        <h2 class="mt-3 text-3xl lg:text-5xl font-display font-extrabold leading-tight">{about.certifications.title}</h2>
        {about.certifications.description && <p class="mt-5 text-white/80 leading-relaxed text-lg">{about.certifications.description}</p>}
        {about.certifications.ctaLabel && about.certifications.ctaHref && (
          <a href={about.certifications.ctaHref} class="mt-8 inline-flex px-5 py-3 rounded-md bg-white text-jinko font-semibold">{about.certifications.ctaLabel}</a>
        )}
      </div>
      <ul class="grid gap-4">
        {about.certifications.items.map((item) => (
          <li class="rounded-2xl bg-white border border-jinko-line shadow-card p-5 flex gap-4 items-start">
            <span class="mt-1 inline-flex h-6 w-6 rounded-full bg-jinko-accent text-white items-center justify-center text-sm font-bold">✓</span>
            <span class="font-semibold text-jinko-ink">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <SectionHeader eyebrow={about.partners.eyebrow} title={about.partners.title} description={about.partners.description} align="center" />
      <div class="mt-10">
        <CardGrid items={about.partners.items} />
      </div>
    </div>
  </section>

  {about.timeline.length > 0 && (
    <section class="py-16 lg:py-20">
      <div class="max-w-content mx-auto px-4 lg:px-6">
        <SectionHeader eyebrow="Growth roadmap" title="How the website supports B2B growth." description="This editable timeline explains the commercial logic behind Callsun's product, solution and marketing layers." />
        <ol class="mt-10 grid gap-6 md:grid-cols-3 counter-reset">
          {about.timeline.map((step, index) => (
            <li class="rounded-2xl border border-jinko-line bg-white shadow-card p-7">
              <span class="inline-flex h-10 w-10 rounded-full bg-jinko text-white items-center justify-center font-display font-extrabold">{index + 1}</span>
              <h3 class="mt-5 text-xl font-display font-bold">{step.label}</h3>
              <p class="mt-3 text-jinko-mute leading-relaxed">{step.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {about.finalCta && (
    <section class="py-16 bg-jinko-bg">
      <div class="max-w-content mx-auto px-4 lg:px-6">
        <div class="rounded-3xl bg-white border border-jinko-line shadow-card p-8 lg:p-10 flex flex-col lg:flex-row gap-8 lg:items-center lg:justify-between">
          <div class="max-w-2xl">
            <h2 class="text-3xl lg:text-4xl font-display font-extrabold">{about.finalCta.title}</h2>
            {about.finalCta.description && <p class="mt-4 text-jinko-mute text-lg leading-relaxed">{about.finalCta.description}</p>}
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <a href={about.finalCta.primaryHref} class="inline-flex px-5 py-3 rounded-md bg-jinko text-white font-semibold">{about.finalCta.primaryLabel}</a>
            {about.finalCta.secondaryLabel && about.finalCta.secondaryHref && <a href={about.finalCta.secondaryHref} class="inline-flex px-5 py-3 rounded-md bg-white text-jinko font-semibold border border-jinko-line">{about.finalCta.secondaryLabel}</a>}
          </div>
        </div>
      </div>
    </section>
  )}

  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>
