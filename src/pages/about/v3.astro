---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
---
<BaseLayout title="Callsun — PV Module Manufacturer | R&D, Manufacturing, Testing" description="Callsun: in-house R&D, 55,000 m² manufacturing base, standard and custom PV modules, EL/I-V quality control, global supply for B2B partners." canonical="/about/v3" ogImage="/uploads/callsun/about/factory-concept.png">
  <Header slot="header" />

  <!-- Hero: Bold positioning card -->
  <section class="py-24 lg:py-32 bg-jinko-ink">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-12 items-center">
        <div>
          <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold">About Callsun</p>
          <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-display font-extrabold leading-tight text-white">Photovoltaic Module Brand & Manufacturer</h1>
          <p class="mt-6 text-lg text-white/80 leading-relaxed">In-house R&D, manufacturing, and testing. Standard and custom PV modules for global B2B partners. From product selection to volume delivery — one supply chain, verified quality.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/contact" class="inline-flex px-6 py-3 rounded-md bg-jinko text-white font-semibold">Request a Quote</a>
            <a href="/products" class="inline-flex px-6 py-3 rounded-md bg-white/10 text-white font-semibold border border-white/30 backdrop-blur-sm">View Products</a>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="rounded-2xl bg-white/10 backdrop-blur-sm border border-white/20 p-5 text-center"><p class="text-3xl font-display font-extrabold text-white">55K</p><p class="mt-1 text-xs text-white/70">m² Manufacturing Base</p></div>
          <div class="rounded-2xl bg-white/10 backdrop-blur-sm border border-white/20 p-5 text-center"><p class="text-3xl font-display font-extrabold text-white">180–720</p><p class="mt-1 text-xs text-white/70">Watt Module Range</p></div>
          <div class="rounded-2xl bg-white/10 backdrop-blur-sm border border-white/20 p-5 text-center"><p class="text-3xl font-display font-extrabold text-white">8+</p><p class="mt-1 text-xs text-white/70">Global Markets</p></div>
          <div class="rounded-2xl bg-white/10 backdrop-blur-sm border border-white/20 p-5 text-center"><p class="text-3xl font-display font-extrabold text-white">ISO</p><p class="mt-1 text-xs text-white/70">Certified Quality</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core positioning: 3 pillar cards -->
  <section class="py-20">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold text-center">Core Capabilities</p>
      <h2 class="mt-4 text-3xl lg:text-5xl font-display font-extrabold leading-tight text-center text-jinko-ink">In-House R&D, Manufacturing & Testing</h2>
      <div class="mt-12 grid gap-8 lg:grid-cols-3">
        <div class="rounded-2xl border border-jinko-line shadow-card bg-white overflow-hidden">
          <div class="h-48 bg-jinko-bg flex items-center justify-center"><img src="/uploads/callsun/about/production-string-welding.jpg" alt="Standard module production" class="w-full h-full object-cover" loading="lazy" /></div>
          <div class="p-6">
            <div class="w-10 h-10 rounded-lg bg-jinko/10 flex items-center justify-center text-jinko font-display font-bold">01</div>
            <h3 class="mt-4 text-xl font-display font-bold">Standard PV Modules at Scale</h3>
            <p class="mt-2 text-jinko-mute">Fully automated production covering 450W–720W. Non-destructive cell cutting, multi-busbar string welding, vision-guided layup, controlled lamination, automated framing, and final EL + I-V testing.</p>
            <div class="mt-4 flex flex-wrap gap-2"><span class="px-2.5 py-1 rounded-full bg-jinko-bg text-xs font-semibold">High Power Density</span><span class="px-2.5 py-1 rounded-full bg-jinko-bg text-xs font-semibold">Batch Consistency</span></div>
          </div>
        </div>
        <div class="rounded-2xl border border-jinko-line shadow-card bg-white overflow-hidden">
          <div class="h-48 bg-jinko-bg flex items-center justify-center"><img src="/uploads/callsun/about/production-layup.jpg" alt="Custom module production" class="w-full h-full object-cover" loading="lazy" /></div>
          <div class="p-6">
            <div class="w-10 h-10 rounded-lg bg-jinko/10 flex items-center justify-center text-jinko font-display font-bold">02</div>
            <h3 class="mt-4 text-xl font-display font-bold">Custom Module Engineering</h3>
            <p class="mt-2 text-jinko-mute">Semi-automated flexible production for 180W–215W and beyond. Size adaptation, structural engineering, connection compatibility — from sample validation to volume production.</p>
            <div class="mt-4 flex flex-wrap gap-2"><span class="px-2.5 py-1 rounded-full bg-jinko-bg text-xs font-semibold">Size Adaptation</span><span class="px-2.5 py-1 rounded-full bg-jinko-bg text-xs font-semibold">Structural Engineering</span></div>
          </div>
        </div>
        <div class="rounded-2xl border border-jinko-line shadow-card bg-white overflow-hidden">
          <div class="h-48 bg-jinko-bg flex items-center justify-center"><img src="/uploads/callsun/about/quality-final-inspection.jpg" alt="Quality control" class="w-full h-full object-cover" loading="lazy" /></div>
          <div class="p-6">
            <div class="w-10 h-10 rounded-lg bg-jinko/10 flex items-center justify-center text-jinko font-display font-bold">03</div>
            <h3 class="mt-4 text-xl font-display font-bold">Verified Quality Control</h3>
            <p class="mt-2 text-jinko-mute">In-process EL, final EL, I-V curve measurement, thermal cycling, UV aging, static mechanical load, withstand voltage — every module verified before delivery.</p>
            <div class="mt-4 flex flex-wrap gap-2"><span class="px-2.5 py-1 rounded-full bg-jinko-bg text-xs font-semibold">EL Testing</span><span class="px-2.5 py-1 rounded-full bg-jinko-bg text-xs font-semibold">I-V Measurement</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Manufacturing details: timeline-style -->
  <section class="py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold text-center">Manufacturing Process</p>
      <h2 class="mt-4 text-3xl lg:text-5xl font-display font-extrabold leading-tight text-center text-jinko-ink">From Cell to Finished Module</h2>
      <div class="mt-12 space-y-8">
        <div class="grid lg:grid-cols-5 gap-6 items-start">
          <div class="rounded-2xl bg-white border border-jinko-line shadow-card overflow-hidden"><img src="/uploads/callsun/about/production-cell-handling.jpg" alt="Cell handling" class="w-full aspect-[4/3] object-cover" loading="lazy" /><div class="p-4"><p class="font-display font-bold">01 Cell Handling</p><p class="mt-1 text-xs text-jinko-mute">Controlled cell in-take and storage</p></div></div>
          <div class="rounded-2xl bg-white border border-jinko-line shadow-card overflow-hidden"><img src="/uploads/callsun/about/production-string-welding.jpg" alt="String welding" class="w-full aspect-[4/3] object-cover" loading="lazy" /><div class="p-4"><p class="font-display font-bold">02 String Welding</p><p class="mt-1 text-xs text-jinko-mute">Multi-busbar + post-weld EL check</p></div></div>
          <div class="rounded-2xl bg-white border border-jinko-line shadow-card overflow-hidden"><img src="/uploads/callsun/about/production-busbar-welding.jpg" alt="Busbar welding" class="w-full aspect-[4/3] object-cover" loading="lazy" /><div class="p-4"><p class="font-display font-bold">03 Busbar Welding</p><p class="mt-1 text-xs text-jinko-mute">Ribbon and busbar interconnection</p></div></div>
          <div class="rounded-2xl bg-white border border-jinko-line shadow-card overflow-hidden"><img src="/uploads/callsun/about/production-layup.jpg" alt="Layup" class="w-full aspect-[4/3] object-cover" loading="lazy" /><div class="p-4"><p class="font-display font-bold">04 Layup</p><p class="mt-1 text-xs text-jinko-mute">Vision-guided precision layup</p></div></div>
          <div class="rounded-2xl bg-white border border-jinko-line shadow-card overflow-hidden"><img src="/uploads/callsun/about/production-junction-box.jpg" alt="Junction box" class="w-full aspect-[4/3] object-cover" loading="lazy" /><div class="p-4"><p class="font-display font-bold">05 Framing & JB</p><p class="mt-1 text-xs text-jinko-mute">Automated framing + potting</p></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quality equipment -->
  <section class="py-20">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold text-center">Quality Equipment</p>
      <h2 class="mt-4 text-3xl lg:text-5xl font-display font-extrabold leading-tight text-center text-jinko-ink">Testing & Reliability Lab</h2>
      <div class="mt-12 grid gap-4 md:grid-cols-3 lg:grid-cols-6">
        <div class="rounded-xl bg-jinko-bg border border-jinko-line p-4 text-center"><div class="w-10 h-10 mx-auto rounded-full bg-jinko/10 flex items-center justify-center text-jinko font-display font-bold text-sm">EL</div><p class="mt-2 text-xs font-semibold">EL Testing</p></div>
        <div class="rounded-xl bg-jinko-bg border border-jinko-line p-4 text-center"><div class="w-10 h-10 mx-auto rounded-full bg-jinko/10 flex items-center justify-center text-jinko font-display font-bold text-sm">I-V</div><p class="mt-2 text-xs font-semibold">Solar Simulator</p></div>
        <div class="rounded-xl bg-jinko-bg border border-jinko-line p-4 text-center"><div class="w-10 h-10 mx-auto rounded-full bg-jinko/10 flex items-center justify-center text-jinko font-display font-bold text-sm">ΔT</div><p class="mt-2 text-xs font-semibold">Thermal Cycling</p></div>
        <div class="rounded-xl bg-jinko-bg border border-jinko-line p-4 text-center"><div class="w-10 h-10 mx-auto rounded-full bg-jinko/10 flex items-center justify-center text-jinko font-display font-bold text-sm">UV</div><p class="mt-2 text-xs font-semibold">UV Aging</p></div>
        <div class="rounded-xl bg-jinko-bg border border-jinko-line p-4 text-center"><div class="w-10 h-10 mx-auto rounded-full bg-jinko/10 flex items-center justify-center text-jinko font-display font-bold text-sm">N</div><p class="mt-2 text-xs font-semibold">Static Load</p></div>
        <div class="rounded-xl bg-jinko-bg border border-jinko-line p-4 text-center"><div class="w-10 h-10 mx-auto rounded-full bg-jinko/10 flex items-center justify-center text-jinko font-display font-bold text-sm">V</div><p class="mt-2 text-xs font-semibold">Withstand Voltage</p></div>
      </div>
    </div>
  </section>

  <!-- Global reach -->
  <section class="py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-2 gap-10 items-center">
      <figure><img src="/uploads/callsun/about/world-map.jpg" alt="Global supply network" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" /></figure>
      <div>
        <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold">Global Supply</p>
        <h2 class="mt-4 text-3xl lg:text-5xl font-display font-extrabold leading-tight text-jinko-ink">Multi-Regional Manufacturing & Logistics</h2>
        <p class="mt-6 text-lg text-jinko-mute leading-relaxed">Manufacturing in China, Vietnam, Indonesia, Saudi Arabia. Warehousing and logistics in the US, UK, Germany, Australia, Canada, and Japan. This multi-regional setup gives the supply chain greater flexibility in responding to market, trade, and logistics changes.</p>
        <div class="mt-6 grid grid-cols-2 gap-4">
          <div class="rounded-xl bg-white border border-jinko-line p-4"><p class="font-display font-bold">Manufacturing</p><p class="text-xs text-jinko-mute mt-1">CN · VN · ID · SA</p></div>
          <div class="rounded-xl bg-white border border-jinko-line p-4"><p class="font-display font-bold">Warehousing</p><p class="text-xs text-jinko-mute mt-1">US · UK · DE · AU · CA · JP</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner channels -->
  <section class="py-20">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold text-center">Channel Support</p>
      <h2 class="mt-4 text-3xl lg:text-5xl font-display font-extrabold leading-tight text-center text-jinko-ink">Designed for B2B Partnerships</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card p-6 text-center"><h3 class="text-lg font-display font-bold">Distributors</h3><p class="mt-2 text-jinko-mute">Product portfolio, spec docs, marketing materials.</p></div>
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card p-6 text-center"><h3 class="text-lg font-display font-bold">Installers</h3><p class="mt-2 text-jinko-mute">Dimension, electrical, compatibility confirmation.</p></div>
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card p-6 text-center"><h3 class="text-lg font-display font-bold">OEM / Project</h3><p class="mt-2 text-jinko-mute">Custom feasibility, samples, volume production.</p></div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="rounded-3xl bg-jinko text-white p-10 lg:p-14 text-center">
        <h2 class="text-3xl lg:text-5xl font-display font-extrabold max-w-4xl mx-auto">Engineered for More Power in Less Space</h2>
        <p class="mt-6 text-white/80 max-w-2xl mx-auto">基于先进制造和可验证的品质，让有限空间产生更多能源价值。</p>
        <a href="/contact" class="mt-8 inline-flex px-8 py-4 rounded-md bg-white text-jinko font-semibold text-lg">Discuss Your Needs →</a>
      </div>
    </div>
  </section>

  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>