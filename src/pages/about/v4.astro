---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const stats = [
  { value: '55,000 m²', label: 'Manufacturing Base' },
  { value: '4', label: 'Manufacturing Regions' },
  { value: '6+', label: 'Global Logistics Markets' },
  { value: '180–720W', label: 'Module Power Range' },
];

const whoCards = [
  { num: '01', title: 'Standard PV Module Manufacturing', sub: 'Volume Production' },
  { num: '02', title: 'Custom Module Engineering', sub: 'Custom Engineering' },
  { num: '03', title: 'Quality Control & Reliability Validation', sub: 'Verified Quality' },
  { num: '04', title: 'Application-Specific System Support', sub: 'System Support' },
];

const mfgSteps = [
  { num: '01', title: 'Engineering Review' },
  { num: '02', title: 'Sample Validation' },
  { num: '03', title: 'Reliable Production' },
  { num: '04', title: 'Volume Delivery' },
];

const qualityTiles = [
  { title: 'EL Testing', sub: 'Electroluminescence Testing' },
  { title: 'Solar Simulator Testing', sub: 'I-V Performance Testing' },
  { title: 'Temperature & Humidity Testing', sub: 'Environmental Reliability' },
  { title: 'UV Aging Testing', sub: '' },
  { title: 'Mechanical Load Testing', sub: '' },
  { title: 'Insulation Resistance Testing', sub: 'Electrical Safety Test' },
];

const globalCards = [
  {
    title: 'Multi-Region Manufacturing Support',
    body: 'Production in multiple countries to support global project delivery.',
  },
  {
    title: 'Warehousing & Logistics Network',
    body: 'Global warehousing and logistics for flexible, efficient fulfillment.',
  },
  {
    title: 'Channel & Project Support',
    body: 'Dedicated support for distributors and project partners.',
  },
];

const applications = [
  'Residential PV Systems',
  'RVs & Mobile Applications',
  'Balcony Solar',
  'Off-Grid Buildings',
  'Small Commercial Systems',
];

const markets = ['China', 'Vietnam', 'Indonesia', 'Saudi Arabia', 'USA', 'Germany', 'Australia', 'Canada', 'Japan'];
---
<BaseLayout title="Callsun — PV Module Brand & Manufacturer" description="Callsun is a photovoltaic module brand and manufacturer with 55,000 m² manufacturing base, 180–720W standard and custom modules, verified quality, and global supply." canonical="/about/v4" ogImage="/uploads/callsun/about/v4-hero.webp">
  <Header slot="header" />

  <!-- 1. HERO -->
  <section class="relative overflow-hidden bg-jinko-ink">
    <img
      src="/uploads/callsun/about/v4-hero.webp"
      alt="Callsun solar module manufacturing base with adjacent solar farm and city skyline"
      class="absolute inset-0 w-full h-full object-cover object-center opacity-60"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-jinko-ink via-jinko-ink/80 to-transparent"></div>
    <div class="relative max-w-content mx-auto px-4 lg:px-6 py-28 lg:py-40">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-[0.28em] text-jinko-accent font-extrabold">PV Module Brand & Manufacturer</p>
        <h1 class="mt-6 text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-white leading-[1.1]">
          Photovoltaic Module<br class="hidden md:inline" /> Brand &amp; Manufacturer
        </h1>
        <p class="mt-8 text-base md:text-lg text-white/85 leading-relaxed max-w-2xl">
          Backed by in-house manufacturing capabilities, we provide photovoltaic modules designed for reliable performance, practical application requirements, and long-term use.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="#manufacturing" class="inline-flex items-center px-7 py-4 bg-jinko-accent text-jinko-ink font-bold hover:bg-jinko-accent/90 transition">Explore Our Capabilities</a>
          <a href="/contact" class="inline-flex items-center px-7 py-4 border border-white/40 text-white font-bold hover:bg-white/10 transition">View Company Profile →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. STATS BAND -->
  <section class="bg-jinko-ink border-t border-white/10">
    <div class="max-w-content mx-auto px-4 lg:px-6 py-14 lg:py-16">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-4">
        {stats.map((s, i) => (
          <div class={`text-center lg:text-left ${i > 0 ? 'lg:border-l lg:border-white/10 lg:pl-8' : ''}`}>
            <p class="text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-white leading-none">{s.value}</p>
            <div class="mt-3 flex items-center gap-2 justify-center lg:justify-start">
              <span class="w-2 h-2 bg-jinko-accent"></span>
              <p class="text-[11px] uppercase tracking-[0.22em] text-white/70 font-semibold">{s.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. WHO WE ARE -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">
        <div>
          <p class="text-xs uppercase tracking-[0.28em] text-jinko-accent font-extrabold">Who We Are</p>
          <h2 class="mt-4 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-jinko-ink leading-tight">
            Products Built Around Real-World Space and Long-Term Use
          </h2>
        </div>
        <div class="space-y-5 text-jinko-mute leading-relaxed text-base lg:text-lg">
          <p>Callsun focuses on the development and manufacturing of photovoltaic modules, with products covering both standard PV modules and custom-engineered modules.</p>
          <p>Our solutions are designed for a wide range of project and application requirements, supporting customers from product selection and engineering evaluation to volume production and delivery.</p>
        </div>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {whoCards.map((c) => (
          <div class="border border-jinko-line bg-white p-7 hover:border-jinko-accent transition-colors">
            <p class="text-3xl font-display font-extrabold text-jinko-accent leading-none">{c.num}</p>
            <h3 class="mt-6 text-lg font-display font-bold text-jinko-ink leading-snug">{c.title}</h3>
            <p class="mt-3 text-[11px] uppercase tracking-[0.22em] text-jinko-mute font-semibold">{c.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. MANUFACTURING BAND -->
  <section id="manufacturing" class="bg-jinko-ink">
    <div class="grid lg:grid-cols-2">
      <div class="relative min-h-[360px] lg:min-h-[560px] overflow-hidden">
        <img
          src="/uploads/callsun/about/factory-concept.png"
          alt="Automated solar module assembly line"
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="px-6 lg:px-16 py-16 lg:py-24 flex flex-col justify-center">
        <p class="text-xs uppercase tracking-[0.28em] text-jinko-accent font-extrabold">Manufacturing</p>
        <h2 class="mt-4 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-white leading-tight">
          From Product Requirements to Consistent Delivery
        </h2>
        <p class="mt-6 text-white/80 leading-relaxed text-base lg:text-lg max-w-xl">
          We combine automated production for standard PV modules with flexible engineering capabilities for custom modules, supporting reliable manufacturing, consistent quality, and scalable delivery.
        </p>
        <div class="mt-12 grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-4 border-t border-white/10 pt-8">
          {mfgSteps.map((s) => (
            <div>
              <p class="text-2xl lg:text-3xl font-display font-extrabold text-white leading-none">{s.num}</p>
              <p class="mt-3 text-sm text-white font-semibold leading-snug">{s.title}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 5. PRODUCT PORTFOLIO -->
  <section class="py-20 lg:py-24 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-[0.28em] text-jinko-accent font-extrabold">Product Portfolio</p>
        <h2 class="mt-4 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-jinko-ink leading-tight">
          Standard PV Modules at Scale. Custom Modules Engineered to Fit.
        </h2>
      </div>
      <div class="mt-14 grid lg:grid-cols-2 gap-8">
        <!-- Card 1: Standard -->
        <div class="relative bg-white border border-jinko-line p-8 lg:p-10 flex flex-col">
          <span class="absolute left-0 top-0 bottom-0 w-1 bg-jinko-accent"></span>
          <h3 class="text-2xl lg:text-3xl font-display font-extrabold text-jinko-ink">Standard PV Modules</h3>
          <p class="mt-5 text-jinko-mute leading-relaxed">Mass production of high-efficiency modules, with reliable performance and stable output for utility-scale, commercial, and industrial PV projects.</p>
          <div class="mt-8">
            <p class="text-[11px] uppercase tracking-[0.22em] text-jinko-mute font-semibold mb-3">Power Coverage</p>
            <p class="text-2xl lg:text-3xl font-display font-extrabold text-jinko-ink">450W · 580W · 620W · 720W</p>
          </div>
          <div class="mt-8 flex flex-wrap gap-2">
            <span class="px-4 py-1.5 rounded-full bg-jinko-accent/15 text-jinko-dark text-xs font-bold uppercase tracking-wider">High-Efficiency Cells</span>
            <span class="px-4 py-1.5 rounded-full bg-jinko-accent/15 text-jinko-dark text-xs font-bold uppercase tracking-wider">Stable Output</span>
          </div>
        </div>
        <!-- Card 2: Custom -->
        <div class="relative bg-white border border-jinko-line p-8 lg:p-10 flex flex-col">
          <span class="absolute left-0 top-0 bottom-0 w-1 bg-jinko-accent"></span>
          <h3 class="text-2xl lg:text-3xl font-display font-extrabold text-jinko-ink">Custom PV Modules</h3>
          <p class="mt-5 text-jinko-mute leading-relaxed">Flexible customization of size, shape, and performance parameters to support project-specific requirements across voltage, size, mounting, and connector configurations.</p>
          <div class="mt-8">
            <p class="text-[11px] uppercase tracking-[0.22em] text-jinko-mute font-semibold mb-3">Power Coverage</p>
            <p class="text-2xl lg:text-3xl font-display font-extrabold text-jinko-ink">180W · 200W · 215W</p>
          </div>
          <div class="mt-8 flex flex-wrap gap-2">
            <span class="px-4 py-1.5 rounded-full bg-jinko-accent/15 text-jinko-dark text-xs font-bold uppercase tracking-wider">Size Customization</span>
            <span class="px-4 py-1.5 rounded-full bg-jinko-accent/15 text-jinko-dark text-xs font-bold uppercase tracking-wider">Application Fit</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. VERIFIED QUALITY -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-[0.28em] text-jinko-accent font-extrabold">Verified Quality</p>
        <h2 class="mt-4 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-jinko-ink leading-tight">
          Verifiable Quality at Every Stage
        </h2>
        <p class="mt-6 text-jinko-mute leading-relaxed text-base lg:text-lg">
          From cell and material testing to module-level validation, we implement a comprehensive quality control process to ensure product performance, safety, and long-term reliability.
        </p>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {qualityTiles.map((t) => (
          <div class="relative bg-jinko-ink p-8 min-h-[160px] flex flex-col justify-between">
            <span class="absolute left-0 right-0 top-0 h-0.5 bg-jinko-accent"></span>
            <h3 class="text-xl lg:text-2xl font-display font-extrabold text-white leading-snug">{t.title}</h3>
            {t.sub && <p class="mt-6 text-[11px] uppercase tracking-[0.22em] text-jinko-accent font-bold">{t.sub}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. GLOBAL SUPPLY -->
  <section class="py-20 lg:py-24 bg-jinko-ink">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-[0.28em] text-jinko-accent font-extrabold">Global Supply</p>
        <h2 class="mt-4 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-white leading-tight">
          Global Supply for Long-Term Channel Partnerships
        </h2>
        <p class="mt-6 text-white/80 leading-relaxed text-base lg:text-lg">
          Supported by manufacturing operations in China, Vietnam, Indonesia, and Saudi Arabia, together with overseas warehousing and logistics capabilities across key markets, we provide flexible and efficient delivery support for global customers.
        </p>
      </div>

      <!-- Map + markets -->
      <div class="mt-14 border border-white/10 bg-white/5 p-6 lg:p-10">
        <img
          src="/uploads/callsun/about/world-map.jpg"
          alt="Global manufacturing and logistics network map"
          class="w-full mix-blend-luminosity opacity-90"
          loading="lazy"
        />
        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 justify-center items-center border-t border-white/10 pt-6">
          <p class="text-[10px] uppercase tracking-[0.24em] text-jinko-accent font-bold">Manufacturing & Logistics Network</p>
          {markets.map((m) => (
            <span class="text-[11px] uppercase tracking-[0.22em] text-white/70 font-semibold">· {m}</span>
          ))}
        </div>
      </div>

      <!-- 3 cards -->
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {globalCards.map((g) => (
          <div class="relative bg-jinko-ink border border-white/15 p-7 lg:p-8">
            <span class="absolute left-0 right-0 top-0 h-0.5 bg-jinko-accent"></span>
            <h3 class="text-lg font-display font-bold text-white leading-snug">{g.title}</h3>
            <p class="mt-4 text-sm text-white/75 leading-relaxed">{g.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. REAL-WORLD APPLICATIONS -->
  <section class="py-20 lg:py-24 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="grid lg:grid-cols-[1.2fr_1fr] gap-10 items-end">
        <div>
          <p class="text-xs uppercase tracking-[0.28em] text-jinko-accent font-extrabold">Real-World Applications</p>
          <h2 class="mt-4 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-jinko-ink leading-tight">
            From Reliable Modules to Real-World Applications
          </h2>
        </div>
        <p class="text-jinko-mute leading-relaxed text-base lg:text-lg lg:text-right">
          Our modules serve diverse installation environments and support reliable, stable, and durable power generation across a wide range of applications.
        </p>
      </div>
      <div class="mt-14 grid gap-4 md:grid-cols-3 lg:grid-cols-5">
        {applications.map((a) => (
          <div class="bg-white border border-jinko-line p-6 lg:p-7 hover:border-jinko-accent hover:-translate-y-0.5 transition min-h-[110px] flex items-center">
            <h3 class="text-lg lg:text-xl font-display font-bold text-jinko-ink leading-snug">{a}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. FOOTER CTA -->
  <section class="bg-jinko-ink">
    <div class="max-w-content mx-auto px-4 lg:px-6 py-16 lg:py-20">
      <div class="grid lg:grid-cols-[auto_1fr_auto] gap-8 lg:gap-12 items-center">
        <div class="flex items-center gap-3">
          <span class="inline-flex w-10 h-10 bg-jinko-accent items-center justify-center">
            <span class="text-jinko-ink font-display font-extrabold text-lg">C</span>
          </span>
          <p class="text-2xl font-display font-extrabold text-white tracking-tight">callsun</p>
        </div>
        <div>
          <p class="text-lg lg:text-xl font-display font-bold text-jinko-accent leading-snug">
            Built on Advanced Manufacturing and Verified Quality, Creating More Energy Value per Square Meter.
          </p>
        </div>
        <a href="/contact" class="inline-flex items-center px-7 py-4 bg-jinko-accent text-jinko-ink font-bold hover:bg-jinko-accent/90 transition whitespace-nowrap">
          Discuss Your Project Requirements →
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
