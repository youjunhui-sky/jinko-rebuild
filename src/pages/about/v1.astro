---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
---
<BaseLayout title="About Callsun — PV Module Brand & Manufacturer" description="Callsun is a PV module brand and manufacturer with in-house R&D, manufacturing and testing capabilities serving global B2B partners." canonical="/about/v1" ogImage="/uploads/callsun/about/factory-concept.png">
  <Header slot="header" />

  <!-- Hero: Full-bleed factory concept with bold overlay -->
  <section class="relative overflow-hidden bg-jinko-ink">
    <img src="/uploads/callsun/about/factory-concept.png" alt="Callsun solar module manufacturing" class="w-full h-[480px] md:h-[560px] lg:h-[640px] object-cover object-center" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/40 to-transparent"></div>
    <div class="absolute inset-0 flex items-center">
      <div class="max-w-content mx-auto px-4 lg:px-6 w-full">
        <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold">About Callsun</p>
        <h1 class="mt-4 text-4xl md:text-5xl lg:text-7xl font-display font-extrabold leading-tight text-white max-w-3xl">Engineered for More Power<br />in Less Space</h1>
        <p class="mt-5 text-lg text-white/80 max-w-2xl leading-relaxed">PV module brand and manufacturer with in-house R&D, manufacturing, and testing — serving distributors, installers, and project partners worldwide.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="inline-flex px-6 py-3 rounded-md bg-jinko text-white font-semibold">Partner with Callsun</a>
          <a href="/solutions" class="inline-flex px-6 py-3 rounded-md bg-white/10 text-white font-semibold border border-white/30 backdrop-blur-sm">View Solutions</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Strip: 4 key numbers -->
  <section class="bg-jinko">
    <div class="max-w-content mx-auto px-4 lg:px-6 py-10 lg:py-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div><p class="text-3xl lg:text-4xl font-display font-extrabold text-white">55,000</p><p class="mt-1 text-sm text-white/80">m² Manufacturing Base</p></div>
        <div><p class="text-3xl lg:text-4xl font-display font-extrabold text-white">180W–720W</p><p class="mt-1 text-sm text-white/80">Module Power Range</p></div>
        <div><p class="text-3xl lg:text-4xl font-display font-extrabold text-white">8+</p><p class="mt-1 text-sm text-white/80">Global Markets Served</p></div>
        <div><p class="text-3xl lg:text-4xl font-display font-extrabold text-white">ISO</p><p class="mt-1 text-sm text-white/80">Certified Manufacturing</p></div>
      </div>
    </div>
  </section>

  <!-- Brand Manifesto: Power a New World style -->
  <section class="py-20 lg:py-28">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold">Our Mission</p>
        <h2 class="mt-4 text-4xl lg:text-5xl font-display font-extrabold leading-tight text-jinko-ink">From Module Requirements to Consistent Delivery</h2>
        <p class="mt-6 text-lg text-jinko-mute leading-relaxed">Callsun is a PV module brand and manufacturer serving global markets, with in-house R&D, manufacturing, and testing capabilities. We focus on standard PV modules, custom PV modules, and application-specific solar products, supporting distributors, installers, system providers, equipment manufacturers, and project partners with product selection, engineering development, sample validation, and volume delivery.</p>
        <p class="mt-4 text-lg text-jinko-mute leading-relaxed">For space-constrained rooftops, RVs, balconies, walls, and off-grid facilities, Callsun considers power density, module dimensions, electrical design, and installation methods together to better match each product to the available space and its long-term operating needs.</p>
      </div>
    </div>
  </section>

  <!-- Core Capabilities: 4 cards -->
  <section class="py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold text-center">Core Capabilities</p>
      <h2 class="mt-4 text-4xl lg:text-5xl font-display font-extrabold leading-tight text-center text-jinko-ink">What We Do</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card p-8 text-center">
          <div class="w-16 h-16 mx-auto rounded-full bg-jinko/10 flex items-center justify-center"><svg class="w-8 h-8 text-jinko" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" /></svg></div>
          <h3 class="mt-5 text-xl font-display font-bold">Standard PV Modules at Scale</h3>
          <p class="mt-3 text-jinko-mute">450W, 580W, 620W, 720W. High power density, batch consistency, reliable volume supply.</p>
        </div>
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card p-8 text-center">
          <div class="w-16 h-16 mx-auto rounded-full bg-jinko/10 flex items-center justify-center"><svg class="w-8 h-8 text-jinko" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.42 15.17l-5.645 5.645m5.645-5.645L12 12m-.58 3.17a3 3 0 01-5.645 0m5.645 0A3 3 0 0012 12m0 0l5.645-5.645M12 12a3 3 0 005.645 0m0 0A3 3 0 0012 12m0 0l-5.645 5.645M12 12l5.645-5.645" /></svg></div>
          <h3 class="mt-5 text-xl font-display font-bold">Custom Module Engineering</h3>
          <p class="mt-3 text-jinko-mute">180W–215W for RVs, vehicles, balconies. Size adaptation, structural engineering, connection compatibility.</p>
        </div>
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card p-8 text-center">
          <div class="w-16 h-16 mx-auto rounded-full bg-jinko/10 flex items-center justify-center"><svg class="w-8 h-8 text-jinko" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg></div>
          <h3 class="mt-5 text-xl font-display font-bold">Verified Quality</h3>
          <p class="mt-3 text-jinko-mute">EL testing, I-V measurement, thermal cycling, UV aging, static load — every stage verified.</p>
        </div>
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card p-8 text-center">
          <div class="w-16 h-16 mx-auto rounded-full bg-jinko/10 flex items-center justify-center"><svg class="w-8 h-8 text-jinko" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" /></svg></div>
          <h3 class="mt-5 text-xl font-display font-bold">Global Supply</h3>
          <p class="mt-3 text-jinko-mute">Manufacturing in China, Vietnam, Indonesia, Saudi Arabia. Warehousing in US, UK, DE, AU, CA, JP.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Manufacturing: Production line photos -->
  <section class="py-20">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold text-center">Manufacturing</p>
      <h2 class="mt-4 text-4xl lg:text-5xl font-display font-extrabold leading-tight text-center text-jinko-ink">From Cell to Module</h2>
      <p class="mt-4 text-lg text-jinko-mute text-center max-w-3xl mx-auto">Fully automated production for standard modules, flexible semi-automated for custom — across 55,000 m² of manufacturing base.</p>
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        <figure><img src="/uploads/callsun/about/production-string-welding.jpg" alt="Automated string welding" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" /><figcaption class="mt-2 text-sm text-jinko-mute text-center">Multi-busbar string welding</figcaption></figure>
        <figure><img src="/uploads/callsun/about/production-layup.jpg" alt="Layup process" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" /><figcaption class="mt-2 text-sm text-jinko-mute text-center">Vision-guided layup</figcaption></figure>
        <figure><img src="/uploads/callsun/about/production-busbar-welding.jpg" alt="Busbar welding" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" /><figcaption class="mt-2 text-sm text-jinko-mute text-center">Busbar & ribbon welding</figcaption></figure>
        <figure><img src="/uploads/callsun/about/production-junction-box.jpg" alt="Junction box potting" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" /><figcaption class="mt-2 text-sm text-jinko-mute text-center">Junction box automated potting</figcaption></figure>
        <figure><img src="/uploads/callsun/about/quality-final-inspection.jpg" alt="Final inspection" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" /><figcaption class="mt-2 text-sm text-jinko-mute text-center">Final visual inspection</figcaption></figure>
        <figure><img src="/uploads/callsun/about/production-packaging.jpg" alt="Packaging" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" /><figcaption class="mt-2 text-sm text-jinko-mute text-center">Ready for delivery</figcaption></figure>
      </div>
    </div>
  </section>

  <!-- Quality & Certifications -->
  <section class="py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold">Verified Quality</p>
        <h2 class="mt-4 text-4xl lg:text-5xl font-display font-extrabold leading-tight text-jinko-ink">Every Stage, Every Module</h2>
        <p class="mt-6 text-lg text-jinko-mute leading-relaxed">Callsun quality control covers raw materials, semi-finished products, critical process steps, and final product release. In-process EL inspection detects hidden cell cracks after string welding. Final EL rechecks after lamination and framing. Simulated-sunlight I-V testing verifies rated power.</p>
        <ul class="mt-6 space-y-3">
          <li class="flex items-start gap-3"><span class="w-6 h-6 rounded-full bg-jinko text-white flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">✓</span><span class="text-jinko-mute">EL Testing — Post-weld & final</span></li>
          <li class="flex items-start gap-3"><span class="w-6 h-6 rounded-full bg-jinko text-white flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">✓</span><span class="text-jinko-mute">I-V Curve Measurement — Solar simulator</span></li>
          <li class="flex items-start gap-3"><span class="w-6 h-6 rounded-full bg-jinko text-white flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">✓</span><span class="text-jinko-mute">Thermal Cycling & UV Aging — Reliability chambers</span></li>
          <li class="flex items-start gap-3"><span class="w-6 h-6 rounded-full bg-jinko text-white flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">✓</span><span class="text-jinko-mute">Static Mechanical Load — Withstand testing</span></li>
          <li class="flex items-start gap-3"><span class="w-6 h-6 rounded-full bg-jinko text-white flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">✓</span><span class="text-jinko-mute">Withstand Voltage & Insulation Resistance</span></li>
        </ul>
      </div>
      <figure class="lg:order-first">
        <img src="/uploads/callsun/about/certificates.jpg" alt="Certifications" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- Global Network -->
  <section class="py-20">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold text-center">Global Supply</p>
      <h2 class="mt-4 text-4xl lg:text-5xl font-display font-extrabold leading-tight text-center text-jinko-ink">Worldwide Reach</h2>
      <p class="mt-4 text-lg text-jinko-mute text-center max-w-3xl mx-auto">Manufacturing and supply network spanning China, Vietnam, Indonesia, Saudi Arabia, with warehousing and logistics in the US, UK, Germany, Australia, Canada, and Japan.</p>
      <figure class="mt-10">
        <img src="/uploads/callsun/about/world-map.jpg" alt="Callsun global presence" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- Application Scenarios -->
  <section class="py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold text-center">Applications</p>
      <h2 class="mt-4 text-4xl lg:text-5xl font-display font-extrabold leading-tight text-center text-jinko-ink">From Reliable Modules to Real-World Applications</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card overflow-hidden"><img src="/uploads/callsun/solutions/5-4kw/05-scenario-rooftop.webp" alt="Residential solar" class="w-full aspect-[3/2] object-cover" loading="lazy" /><div class="p-5"><h3 class="font-display font-bold">Residential Solar</h3><p class="mt-2 text-sm text-jinko-mute">Rooftop and ground-mount for homes, with grid-tied or off-grid configuration.</p></div></div>
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card overflow-hidden"><img src="/uploads/callsun/solutions/5-4kw/06-scenario-farm.webp" alt="Farm solar" class="w-full aspect-[3/2] object-cover" loading="lazy" /><div class="p-5"><h3 class="font-display font-bold">Farm & Rural</h3><p class="mt-2 text-sm text-jinko-mute">Off-grid and distributed power for agricultural operations and remote sites.</p></div></div>
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card overflow-hidden"><img src="/uploads/callsun/solutions/5-4kw/07-scenario-backyard.webp" alt="Backyard solar" class="w-full aspect-[3/2] object-cover" loading="lazy" /><div class="p-5"><h3 class="font-display font-bold">RV & Mobile</h3><p class="mt-2 text-sm text-jinko-mute">Custom modules for RVs, vehicles, balconies — where space drives the design.</p></div></div>
      </div>
    </div>
  </section>

  <!-- Final CTA: Partner with us -->
  <section class="py-20">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="rounded-3xl bg-jinko text-white p-10 lg:p-14 text-center">
        <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold">Partner with Callsun</p>
        <h2 class="mt-4 text-4xl lg:text-5xl font-display font-extrabold">Built on Advanced Manufacturing and Verified Quality — Let Limited Space Deliver Greater Energy Value</h2>
        <p class="mt-6 text-white/80 max-w-2xl mx-auto">Contact us to discuss your module specifications and application requirements.</p>
        <a href="/contact" class="mt-8 inline-flex px-8 py-4 rounded-md bg-white text-jinko font-semibold text-lg">Contact Sales →</a>
      </div>
    </div>
  </section>

  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>