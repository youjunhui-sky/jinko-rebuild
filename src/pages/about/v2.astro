---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
---
<BaseLayout title="The Callsun Story — Solar PV Manufacturer" description="From a 55,000 m² manufacturing base to global delivery — the Callsun story of solar module manufacturing, quality control, and B2B partnership." canonical="/about/v2" ogImage="/uploads/callsun/about/hero-product.jpg">
  <Header slot="header" />

  <!-- Hero: Product + factory scene, Renogy-style story intro -->
  <section class="relative overflow-hidden bg-jinko-ink">
    <img src="/uploads/callsun/about/hero-product.jpg" alt="Callsun solar modules" class="w-full h-[420px] md:h-[500px] lg:h-[580px] object-cover object-center" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/30 to-transparent"></div>
    <div class="absolute inset-0 flex items-center">
      <div class="max-w-content mx-auto px-4 lg:px-6 w-full">
        <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold">The Callsun Story</p>
        <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-display font-extrabold leading-tight text-white max-w-3xl">Photovoltaic Module Brand & Manufacturer</h1>
        <p class="mt-5 text-lg text-white/80 max-w-2xl leading-relaxed">Standard PV modules at scale. Custom modules engineered to fit. In-house R&D, manufacturing, and testing — one partner, one supply chain.</p>
      </div>
    </div>
  </section>

  <!-- Story intro: Who we are -->
  <section class="py-20 lg:py-24">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold">Who We Are</p>
          <h2 class="mt-4 text-3xl lg:text-5xl font-display font-extrabold leading-tight text-jinko-ink">From Product Requirements to Consistent Delivery</h2>
          <p class="mt-6 text-lg text-jinko-mute leading-relaxed">Callsun is a PV module brand and manufacturer serving global markets, with in-house R&D, manufacturing, and testing capabilities. We focus on standard PV modules, custom PV modules, and application-specific solar products, supporting distributors, installers, system providers, equipment manufacturers, and project partners with product selection, engineering development, sample validation, and volume delivery.</p>
          <p class="mt-4 text-lg text-jinko-mute leading-relaxed">For space-constrained rooftops, RVs, balconies, walls, and off-grid facilities, Callsun considers power density, module dimensions, electrical design, and installation methods together — to better match each product to the available space and its long-term operating needs.</p>
        </div>
        <figure>
          <img src="/uploads/callsun/about/factory-concept.png" alt="Callsun modern manufacturing facility" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" />
        </figure>
      </div>
    </div>
  </section>

  <!-- Product line: 2-card row -->
  <section class="py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold text-center">Product Line</p>
      <h2 class="mt-4 text-3xl lg:text-5xl font-display font-extrabold leading-tight text-center text-jinko-ink">Standard PV Modules at Scale. Custom Modules Engineered to Fit.</h2>
      <div class="mt-12 grid gap-8 lg:grid-cols-2">
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card overflow-hidden">
          <img src="/uploads/callsun/about/200w-panel.jpg" alt="Standard PV module" class="w-full aspect-[2/1] object-cover" loading="lazy" />
          <div class="p-8">
            <h3 class="text-2xl font-display font-bold">Standard PV Modules</h3>
            <p class="mt-3 text-jinko-mute leading-relaxed">450W, 580W, 620W, 720W power classes. High power density, batch consistency, and reliable volume supply for residential rooftops, distributed PV, off-grid systems, and small commercial projects.</p>
            <div class="mt-5 flex flex-wrap gap-2"><span class="px-3 py-1 rounded-full bg-jinko-bg text-xs font-semibold">High Power Density</span><span class="px-3 py-1 rounded-full bg-jinko-bg text-xs font-semibold">Batch Consistency</span><span class="px-3 py-1 rounded-full bg-jinko-bg text-xs font-semibold">Reliable Volume Supply</span></div>
          </div>
        </div>
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card overflow-hidden">
          <img src="/uploads/callsun/about/200w-panel-reflection.jpg" alt="Custom PV module" class="w-full aspect-[2/1] object-cover" loading="lazy" />
          <div class="p-8">
            <h3 class="text-2xl font-display font-bold">Custom PV Modules</h3>
            <p class="mt-3 text-jinko-mute leading-relaxed">180W, 200W, 215W for RVs, vehicle rooftops, balconies, and off-grid equipment. Size adaptation, structural engineering, and connection compatibility — from sample trials to production validation.</p>
            <div class="mt-5 flex flex-wrap gap-2"><span class="px-3 py-1 rounded-full bg-jinko-bg text-xs font-semibold">Size Adaptation</span><span class="px-3 py-1 rounded-full bg-jinko-bg text-xs font-semibold">Structural Engineering</span><span class="px-3 py-1 rounded-full bg-jinko-bg text-xs font-semibold">Connection Compatibility</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Manufacturing story: left-right alternating -->
  <section class="py-20">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold text-center">How We Build</p>
      <h2 class="mt-4 text-3xl lg:text-5xl font-display font-extrabold leading-tight text-center text-jinko-ink">55,000 m² of Manufacturing</h2>
      <p class="mt-4 text-lg text-jinko-mute text-center max-w-3xl mx-auto">Fully automated production for standard modules, flexible semi-automated for custom — supported by in-house cable, frame, and injection-molded part manufacturing.</p>
    </div>
    <div class="mt-12 space-y-0">
      <div class="bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6 py-12 grid lg:grid-cols-2 gap-10 items-center"><figure><img src="/uploads/callsun/about/production-string-welding.jpg" alt="Multi-busbar string welding" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" /></figure><div><h3 class="text-2xl font-display font-bold">Multi-Busbar String Welding</h3><p class="mt-4 text-jinko-mute leading-relaxed">Non-destructive cell cutting and multi-busbar string welding with post-welding in-process EL inspection to detect hidden cracks and soldering abnormalities.</p></div></div></div>
      <div class="bg-white"><div class="max-w-content mx-auto px-4 lg:px-6 py-12 grid lg:grid-cols-2 gap-10 items-center"><figure class="lg:order-2"><img src="/uploads/callsun/about/production-layup.jpg" alt="Vision-guided layup" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" /></figure><div class="lg:order-1"><h3 class="text-2xl font-display font-bold">Vision-Guided Layup & Lamination</h3><p class="mt-4 text-jinko-mute leading-relaxed">Controlled high-temperature vacuum lamination with vision-guided layup ensures consistent bonding and long-term module durability.</p></div></div></div>
      <div class="bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6 py-12 grid lg:grid-cols-2 gap-10 items-center"><figure><img src="/uploads/callsun/about/production-junction-box.jpg" alt="Junction box automated potting" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" /></figure><div><h3 class="text-2xl font-display font-bold">Automated Framing & Junction Box</h3><p class="mt-4 text-jinko-mute leading-relaxed">After lamination, modules pass through automated framing and junction box potting, followed by final EL and I-V testing for power confirmation.</p></div></div></div>
    </div>
  </section>

  <!-- Quality: Verified at every stage -->
  <section class="py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold text-center">Quality Control</p>
      <h2 class="mt-4 text-3xl lg:text-5xl font-display font-extrabold leading-tight text-center text-jinko-ink">Verified Quality, Every Stage</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card p-6 text-center"><div class="w-14 h-14 mx-auto rounded-full bg-jinko/10 flex items-center justify-center text-jinko font-display font-bold text-xl">EL</div><h3 class="mt-4 font-display font-bold">EL Testing</h3><p class="mt-2 text-sm text-jinko-mute">Post-weld in-process EL and final EL after lamination and framing. Detects hidden cracks and interconnection anomalies.</p></div>
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card p-6 text-center"><div class="w-14 h-14 mx-auto rounded-full bg-jinko/10 flex items-center justify-center text-jinko font-display font-bold text-xl">I-V</div><h3 class="mt-4 font-display font-bold">I-V Measurement</h3><p class="mt-2 text-sm text-jinko-mute">Simulated-sunlight I-V testing records power, voltage, current, and I-V curve to verify rated power class and factory release criteria.</p></div>
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card p-6 text-center"><div class="w-14 h-14 mx-auto rounded-full bg-jinko/10 flex items-center justify-center text-jinko font-display font-bold text-xl">R</div><h3 class="mt-4 font-display font-bold">Reliability Testing</h3><p class="mt-2 text-sm text-jinko-mute">Thermal cycling, UV aging, static mechanical load, withstand voltage — data supports material evaluation, process validation, and production improvement.</p></div>
      </div>
    </div>
  </section>

  <!-- Global Network + Map -->
  <section class="py-20">
    <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold">Global Supply</p>
        <h2 class="mt-4 text-3xl lg:text-5xl font-display font-extrabold leading-tight text-jinko-ink">Worldwide Manufacturing & Delivery</h2>
        <p class="mt-6 text-lg text-jinko-mute leading-relaxed">Callsun's manufacturing and supply network spans China, Vietnam, Indonesia, Saudi Arabia, and other regions, with warehousing and logistics resources supporting local delivery in the United States, the United Kingdom, Germany, Australia, Canada, and Japan.</p>
        <p class="mt-4 text-lg text-jinko-mute leading-relaxed">This multi-regional setup gives the supply chain greater flexibility in responding to market, trade, and logistics changes.</p>
      </div>
      <figure><img src="/uploads/callsun/about/world-map.jpg" alt="Callsun global presence" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" /></figure>
    </div>
  </section>

  <!-- Partner support cards -->
  <section class="py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold text-center">Partner Support</p>
      <h2 class="mt-4 text-3xl lg:text-5xl font-display font-extrabold leading-tight text-center text-jinko-ink">Supporting Every Channel</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card p-6"><div class="w-12 h-12 rounded-xl bg-jinko/10 flex items-center justify-center text-jinko"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg></div><h3 class="mt-4 font-display font-bold text-lg">Distributors & Wholesalers</h3><p class="mt-2 text-jinko-mute">Product portfolio planning, specification documents, and marketing materials support.</p></div>
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card p-6"><div class="w-12 h-12 rounded-xl bg-jinko/10 flex items-center justify-center text-jinko"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.42 15.17l-5.645 5.645m5.645-5.645L12 12m-.58 3.17a3 3 0 01-5.645 0m5.645 0A3 3 0 0012 12m0 0l5.645-5.645M12 12a3 3 0 005.645 0m0 0A3 3 0 0012 12m0 0l-5.645 5.645M12 12l5.645-5.645" /></svg></div><h3 class="mt-4 font-display font-bold text-lg">Installers & System Providers</h3><p class="mt-2 text-jinko-mute">Confirmation of dimensions, electrical parameters, compatibility, and installation conditions.</p></div>
        <div class="rounded-2xl bg-white border border-jinko-line shadow-card p-6"><div class="w-12 h-12 rounded-xl bg-jinko/10 flex items-center justify-center text-jinko"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg></div><h3 class="mt-4 font-display font-bold text-lg">Equipment Manufacturers & Project Buyers</h3><p class="mt-2 text-jinko-mute">Custom feasibility assessment, sample trials, and transition to volume production.</p></div>
      </div>
    </div>
  </section>

  <!-- Product showcase: feedback images -->
  <section class="py-20">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold text-center">Real Projects</p>
      <h2 class="mt-4 text-3xl lg:text-5xl font-display font-extrabold leading-tight text-center text-jinko-ink">From Reliable Modules to Real-World Applications</h2>
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        <figure><img src="/uploads/callsun/about/feedback-3.jpg" alt="Customer project reference" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" /></figure>
        <figure><img src="/uploads/callsun/about/feedback-4.jpg" alt="Customer project reference" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" /></figure>
        <figure><img src="/uploads/callsun/about/feedback-5.jpg" alt="Customer project reference" class="w-full rounded-2xl border border-jinko-line shadow-card bg-white" loading="lazy" /></figure>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <div class="rounded-3xl bg-jinko text-white p-10 lg:p-14 text-center">
        <h2 class="text-3xl lg:text-5xl font-display font-extrabold">Built on advanced manufacturing and verified quality, Callsun helps limited space deliver greater energy value.</h2>
        <p class="mt-6 text-white/80 max-w-2xl mx-auto">Contact us to discuss your module specifications and application requirements.</p>
        <a href="/contact" class="mt-8 inline-flex px-8 py-4 rounded-md bg-white text-jinko font-semibold text-lg">Start a Conversation →</a>
      </div>
    </div>
  </section>

  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>