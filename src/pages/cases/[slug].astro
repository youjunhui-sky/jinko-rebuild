---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import CardGrid from '@/components/CardGrid.astro';
import { SITE } from '@/data/site';

export async function getStaticPaths(){
  const cases = await getCollection('cases');
  return cases.map(c => ({ params: { slug: c.data.slug }, props: { item: c.data } }));
}

const { item } = Astro.props;
const [products, solutions] = await Promise.all([getCollection('products'), getCollection('solutions')]);
const relatedProducts = products
  .filter((product) => item.relatedProducts.includes(product.data.slug))
  .map((product) => ({ title: product.data.name, description: product.data.tagline, href: `/products/${product.data.slug}`, eyebrow: product.data.model || product.data.category, image: product.data.image }));
const relatedSolutions = solutions
  .filter((solution) => item.relatedSolutions.includes(solution.data.slug))
  .map((solution) => ({ title: solution.data.title, description: solution.data.summary, href: `/solutions/${solution.data.slug}`, eyebrow: solution.data.type, image: solution.data.image, metric: solution.data.capacityLabel }));

const capacityLabel = item.capacityKW ? (item.capacityKW >= 1000 ? `${item.capacityKW / 1000}MW` : `${item.capacityKW}kW`) : undefined;
const storageLabel = item.capacityMWh ? `${item.capacityMWh >= 1 ? item.capacityMWh + 'MWh' : Math.round(item.capacityMWh * 1000) + 'kWh'}` : undefined;
const projectParameters = item.projectParameters.length > 0 ? item.projectParameters : [
  item.client ? { label: 'Client', value: item.client } : null,
  { label: 'Location', value: item.location },
  item.industry ? { label: 'Industry', value: item.industry } : null,
  capacityLabel ? { label: 'PV Capacity', value: capacityLabel } : null,
  storageLabel ? { label: 'Storage Capacity', value: storageLabel } : null,
  { label: 'Application', value: item.application },
].filter(Boolean);
const title = item.seoTitle || `${item.title} | Callsun`;
const description = item.metaDescription || item.description;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: item.h1 || item.title,
  description,
  image: new URL(item.coverImage, SITE.domain).href,
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: new URL('/logo.svg', SITE.domain).href } },
};
---
<BaseLayout title={title} description={description} canonical={item.canonical || `/cases/${item.slug}`} ogImage={item.ogImage || item.coverImage} keywords={item.keywords} noindex={item.noindex} ogType="article" schema={schema}>
  <Header slot="header" />

  <article>
    <section class="relative overflow-hidden bg-jinko text-white">
      <div class="absolute inset-0 opacity-20" style="background-image:linear-gradient(rgba(255,255,255,.15) 1px, transparent 1px),linear-gradient(90deg, rgba(255,255,255,.15) 1px, transparent 1px);background-size:52px 52px;"></div>
      <div class="relative max-w-content mx-auto px-4 lg:px-6 py-16 lg:py-24 grid lg:grid-cols-[1.05fr_.95fr] gap-12 items-center">
        <div>
          <nav class="text-sm text-sky-100 mb-6"><a href="/">Home</a> / <a href="/cases">Cases</a> / <span>{item.title}</span></nav>
          <p class="inline-flex text-xs uppercase tracking-widest text-jinko-accent font-bold bg-white/10 px-3 py-1.5 rounded-full ring-1 ring-white/15">{item.segment} · {item.application}</p>
          <h1 class="mt-6 text-4xl lg:text-6xl font-display font-extrabold leading-tight">{item.h1 || item.title}</h1>
          <p class="mt-4 text-3xl font-display font-extrabold text-jinko-accent">{[capacityLabel, storageLabel].filter(Boolean).join(' / ')}</p>
          <p class="mt-5 text-lg text-sky-100 max-w-3xl leading-relaxed">{item.description}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/contact" data-track-click="case_inquiry_button" data-case={item.slug} class="inline-flex px-6 py-3 rounded-md bg-jinko-accent text-jinko-ink font-bold hover:opacity-90">Request Similar Project Quote</a>
            {item.casePdf && <a href={item.casePdf} data-track-click="case_pdf_download" data-case={item.slug} class="inline-flex px-6 py-3 rounded-md bg-white/10 text-white font-semibold ring-1 ring-white/20 hover:bg-white/15">Download Case PDF</a>}
          </div>
        </div>
        <div class="rounded-none bg-white/10 ring-1 ring-white/20 p-4 shadow-2xl">
          <img src={item.coverImage} alt={item.coverImageAlt || item.title} class="rounded-none w-full object-cover" />
        </div>
      </div>
    </section>

    <section class="py-10 bg-jinko-bg">
      <div class="max-w-content mx-auto px-4 lg:px-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {projectParameters.slice(0, 8).map((param) => <div class="rounded-2xl bg-white border border-jinko-line p-5 shadow-card"><p class="text-xs uppercase tracking-widest text-jinko-mute font-bold">{param.label}</p><p class="mt-2 text-xl font-display font-extrabold text-jinko-ink">{param.value}</p></div>)}
      </div>
    </section>

    <section class="py-16 lg:py-20">
      <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-[.82fr_1.18fr] gap-10">
        <div>
          <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Sales proof</p>
          <h2 class="mt-2 text-3xl lg:text-4xl font-display font-extrabold">Use this case in B2B conversations.</h2>
          <p class="mt-4 text-jinko-mute">Turn each project reference into a repeatable sales argument for distributors, dealers and EPC installers.</p>
        </div>
        <div class="rounded-3xl bg-white border border-jinko-line shadow-card p-7 lg:p-9">
          <h3 class="text-2xl font-display font-bold">Sales angle</h3>
          <p class="mt-4 text-lg leading-relaxed text-jinko-mute">{item.salesAngle || item.description}</p>
        </div>
      </div>
    </section>

    <section class="py-16 bg-jinko-bg">
      <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-3 gap-6">
        <article class="rounded-3xl bg-white border border-jinko-line shadow-card p-7">
          <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">01 Background</p>
          <h2 class="mt-3 text-2xl font-display font-bold">Project background</h2>
          <p class="mt-4 text-jinko-mute leading-relaxed">{item.projectBackground || item.description}</p>
        </article>
        <article class="rounded-3xl bg-white border border-jinko-line shadow-card p-7">
          <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">02 Pain points</p>
          <h2 class="mt-3 text-2xl font-display font-bold">Buyer concerns</h2>
          <ul class="mt-4 space-y-3 text-jinko-mute">
            {(item.customerPainPoints.length ? item.customerPainPoints : ['Need reliable product supply and project references.', 'Need clear application fit for commercial buyers.', 'Need a repeatable sales story for similar projects.']).map((point) => <li class="flex gap-2"><span class="text-jinko-accent font-bold">•</span><span>{point}</span></li>)}
          </ul>
        </article>
        <article class="rounded-3xl bg-white border border-jinko-line shadow-card p-7">
          <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">03 Solution</p>
          <h2 class="mt-3 text-2xl font-display font-bold">Solution overview</h2>
          <p class="mt-4 text-jinko-mute leading-relaxed">{item.solutionOverview || 'A Callsun project reference used to connect product capability, system fit and commercial sales messaging.'}</p>
        </article>
      </div>
    </section>

    <section class="py-16 lg:py-20">
      <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-[.8fr_1.2fr] gap-10 items-start">
        <div>
          <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Business results</p>
          <h2 class="mt-2 text-3xl lg:text-4xl font-display font-extrabold">What this case proves.</h2>
          <p class="mt-4 text-jinko-mute">Results are written as sales-enablement proof points until the customer provides verified energy yield, savings or payback data.</p>
        </div>
        <div class="grid gap-4">
          {(item.businessResults.length ? item.businessResults : ['Provides a reusable reference for similar commercial solar opportunities.', 'Supports product reliability and project delivery conversations.', 'Guides visitors toward a quote or system package discussion.']).map((result, index) => <div class="rounded-2xl border border-jinko-line p-5 bg-white shadow-card flex gap-4"><span class="text-2xl font-display font-extrabold text-jinko-accent">{String(index + 1).padStart(2, '0')}</span><p class="text-jinko-mute">{result}</p></div>)}
        </div>
      </div>
    </section>

    {item.gallery.length > 0 && <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Gallery</p><h2 class="mt-2 text-3xl font-display font-extrabold">Project photos</h2><div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{item.gallery.map((image) => <img src={image} alt={`${item.title} project photo`} class="rounded-2xl border border-jinko-line shadow-card" />)}</div></div></section>}

    {(relatedProducts.length > 0 || relatedSolutions.length > 0) && <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6 space-y-12">
      {relatedSolutions.length > 0 && <div><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Related solutions</p><h2 class="mt-2 text-3xl font-display font-extrabold">System packages to recommend next</h2><div class="mt-8"><CardGrid items={relatedSolutions} columns="3" /></div></div>}
      {relatedProducts.length > 0 && <div><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Related products</p><h2 class="mt-2 text-3xl font-display font-extrabold">Products connected to this case</h2><div class="mt-8"><CardGrid items={relatedProducts} columns="3" /></div></div>}
    </div></section>}
  </article>

  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>
