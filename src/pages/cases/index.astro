---
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';

const indexEntry = await getEntry('caseIndex', 'index');
if (!indexEntry) throw new Error('Missing case index content entry: src/content/caseIndex/index.json');
const page = indexEntry.data;
const cases = page.cases || [];
---
<BaseLayout title={page.seoTitle || `${page.title} | Callsun`} description={page.metaDescription || page.hero.description} canonical={page.canonical || '/cases'} ogImage={page.ogImage} keywords={page.keywords} noindex={true}>
  <Header slot="header" />

  <!-- Hero — eyebrow + H1 + 中文章节副标 + 描述段 + 双 CTA -->
  <section class="py-16 lg:py-24 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <nav class="text-sm text-jinko-mute mb-5"><a href="/">Home</a> / <span>{page.title}</span></nav>
      <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold">{page.hero.eyebrow}</p>
      <h1 class="mt-3 text-4xl lg:text-6xl font-display font-extrabold leading-tight max-w-5xl">{page.h1 || page.title}</h1>
      <p class="mt-6 text-lg text-jinko-mute max-w-3xl leading-relaxed">{page.hero.description}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={page.hero.primaryCtaHref} class="inline-flex px-5 py-3 rounded-md bg-jinko text-white font-semibold shadow-card">{page.hero.primaryCtaLabel}</a>
        {page.hero.secondaryCtaLabel && page.hero.secondaryCtaHref && <a href={page.hero.secondaryCtaHref} class="inline-flex px-5 py-3 rounded-md bg-white text-jinko font-semibold border border-jinko-line">{page.hero.secondaryCtaLabel}</a>}
      </div>
    </div>
  </section>

  <!-- 8 图案例网格（参考 jinkosolar #case-studies 布局） -->
  {cases.length > 0 && (
    <section class="py-16 lg:py-20 bg-white">
      <div class="max-w-content mx-auto px-4 lg:px-6">
        <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold">Case Library</p>
        <h2 class="mt-3 text-3xl lg:text-4xl font-display font-extrabold leading-tight text-jinko-ink max-w-4xl">A representative selection of Callsun commercial deployments.</h2>
        <div class="mt-10 grid gap-7 sm:gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {cases.map((c) => (
            <figure class="group relative overflow-hidden rounded-2xl bg-jinko-bg border border-jinko-line shadow-card">
              <img src={c.image} alt={c.alt || ''} loading="lazy" class="w-full aspect-[4/3] object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-jinko-ink/60 via-jinko-ink/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {page.finalCta && (
    <section class="py-16 bg-jinko-bg">
      <div class="max-w-content mx-auto px-4 lg:px-6">
        <div class="rounded-3xl bg-jinko text-white p-8 lg:p-10 flex flex-col lg:flex-row gap-6 lg:items-center lg:justify-between">
          <div>
            <h2 class="text-3xl font-display font-extrabold">{page.finalCta.title}</h2>
            {page.finalCta.description && <p class="mt-3 text-white/80 max-w-2xl">{page.finalCta.description}</p>}
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <a href={page.finalCta.primaryHref} class="inline-flex px-5 py-3 rounded-md bg-white text-jinko font-semibold">{page.finalCta.primaryLabel}</a>
            {page.finalCta.secondaryLabel && page.finalCta.secondaryHref && <a href={page.finalCta.secondaryHref} class="inline-flex px-5 py-3 rounded-md bg-jinko-dark text-white font-semibold border border-white/20">{page.finalCta.secondaryLabel}</a>}
          </div>
        </div>
      </div>
    </section>
  )}

  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>
