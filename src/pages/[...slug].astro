---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import { SITE } from '@/data/site';

export async function getStaticPaths() {
  const pages = await getCollection('customPages', page => !page.data.draft);
  return pages.map((page) => ({ params: { slug: page.data.urlPath }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const title = page.data.seoTitle || `${page.data.title} | Callsun`;
const description = page.data.metaDescription || page.data.summary;
const h1 = page.data.h1 || page.data.title;
const canonical = page.data.canonical || `/${page.data.urlPath}`;
const pageUrl = new URL(canonical, SITE.domain).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: h1,
  description,
  url: pageUrl,
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.domain },
};
---
<BaseLayout title={title} description={description} canonical={canonical} ogImage={page.data.ogImage || page.data.coverImage || undefined} noindex={page.data.noindex} keywords={page.data.keywords} schema={schema}>
  <Header slot="header" />

  <section class="relative overflow-hidden bg-jinko text-white">
    <div class="absolute inset-0 opacity-20" style="background-image:linear-gradient(rgba(255,255,255,.15) 1px, transparent 1px),linear-gradient(90deg, rgba(255,255,255,.15) 1px, transparent 1px);background-size:48px 48px;"></div>
    <div class="relative max-w-content mx-auto px-4 lg:px-6 py-18 lg:py-24 grid lg:grid-cols-[1.08fr_.92fr] gap-12 items-center">
      <div>
        <nav class="text-sm text-sky-100 mb-6"><a href="/">Home</a> / <span>{page.data.category || page.data.pageType}</span></nav>
        <p class="inline-flex text-xs uppercase tracking-widest font-bold text-jinko-accent bg-white/10 px-3 py-1.5 rounded-full ring-1 ring-white/15">{page.data.eyebrow || page.data.pageType}</p>
        <h1 class="mt-6 text-4xl lg:text-6xl font-display font-extrabold leading-tight">{h1}</h1>
        <p class="mt-6 text-lg text-sky-100 max-w-3xl leading-relaxed">{page.data.summary}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={page.data.ctaHref} data-track-click="custom_page_cta" data-track-page={page.data.urlPath} class="inline-flex items-center px-6 py-3 rounded-md bg-jinko-accent text-jinko-ink font-bold hover:opacity-90">{page.data.ctaLabel}</a>
          {page.data.secondaryCtaHref && <a href={page.data.secondaryCtaHref} class="inline-flex items-center px-6 py-3 rounded-md bg-white/10 text-white font-semibold ring-1 ring-white/20 hover:bg-white/15">{page.data.secondaryCtaLabel || 'Learn more'}</a>}
        </div>
      </div>
      {page.data.coverImage && <div class="rounded-none bg-white/10 ring-1 ring-white/20 p-4 shadow-2xl"><img src={page.data.coverImage} alt={page.data.imageAlt || h1} class="rounded-none w-full object-cover" /></div>}
    </div>
  </section>

  {page.data.sections.length > 0 && <section class="py-18 lg:py-24 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6 space-y-10">
      {page.data.sections.map((section) => <article class="rounded-3xl bg-white border border-jinko-line shadow-card p-7 lg:p-10">
        {section.eyebrow && <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{section.eyebrow}</p>}
        <h2 class="mt-2 text-3xl lg:text-4xl font-display font-extrabold text-jinko-ink">{section.heading}</h2>
        {section.description && <p class="mt-4 text-jinko-mute text-lg max-w-3xl">{section.description}</p>}
        {section.items.length > 0 && <div class="mt-8 grid gap-5 md:grid-cols-3">{section.items.map((item) => <div class="rounded-2xl border border-jinko-line p-5 bg-jinko-bg/50"><h3 class="font-display font-bold text-xl">{item.title}</h3><p class="mt-2 text-sm text-jinko-mute">{item.description}</p></div>)}</div>}
      </article>)}
    </div>
  </section>}

  <article class="max-w-3xl mx-auto px-4 lg:px-6 py-14">
    <div class="prose prose-slate max-w-none prose-a:text-jinko prose-h2:font-display prose-h2:text-jinko-ink prose-h3:text-jinko-ink">
      <Content />
    </div>
  </article>

  {(page.data.faqs.length > 0 || page.data.relatedLinks.length > 0) && <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-2 gap-8">
    {page.data.faqs.length > 0 && <div><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">FAQ</p><h2 class="mt-2 text-3xl font-display font-extrabold">Questions this page can answer</h2><div class="mt-6 space-y-4">{page.data.faqs.map((faq) => <details class="rounded-2xl bg-white border border-jinko-line p-5"><summary class="font-bold cursor-pointer">{faq.question}</summary><p class="mt-3 text-jinko-mute">{faq.answer}</p></details>)}</div></div>}
    {page.data.relatedLinks.length > 0 && <div><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Related links</p><h2 class="mt-2 text-3xl font-display font-extrabold">Guide visitors to the next step</h2><div class="mt-6 grid gap-4">{page.data.relatedLinks.map((link) => <a href={link.href} class="block rounded-2xl bg-white border border-jinko-line p-5 hover:shadow-card"><span class="font-bold text-jinko">{link.label} →</span>{link.description && <p class="mt-2 text-sm text-jinko-mute">{link.description}</p>}</a>)}</div></div>}
  </div></section>}

  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>
