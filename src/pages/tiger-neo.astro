---
// 原站缺失页面 — Tiger Neo 旗舰产品着陆页
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Jinko Tiger Neo N-Type Solar Panel',
  description: 'Tiger Neo N-Type TOPCon bifacial solar panel — best-in-class bifacial gain for utility-scale projects.',
  brand: { '@type': 'Brand', name: 'Jinko' },
  category: 'Solar Panel',
};
---
<BaseLayout
  title="Tiger Neo N-Type Bifacial Solar Panel — TOPCon Utility Module | Jinko"
  description="Jinko Tiger Neo N-Type TOPCon bifacial solar modules — up to 25% bifacial gain, lowest LCOE for utility-scale projects. Made in Florida."
  schema={schema}
>
  <Header slot="header" />

  <section class="relative py-20 bg-gradient-to-br from-jinko-dark to-jinko text-white overflow-hidden">
    <div class="max-w-content mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Flagship · N-Type TOPCon · Bifacial</p>
      <h1 class="mt-3 text-4xl lg:text-6xl font-display font-extrabold leading-tight max-w-3xl">
        Tiger Neo. <br />The new gold standard in utility solar.
      </h1>
      <p class="mt-4 text-xl text-sky-100 max-w-2xl">
        N-type TOPCon cells. Bifacial gains up to 25%. Industry-leading first-year degradation of only 1%.
      </p>
    </div>
  </section>

  <section class="py-14">
    <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-3 gap-6">
      {[
        { l: 'Cell Tech', v: 'N-Type TOPCon', d: 'Superior temperature coefficient & low-light performance.' },
        { l: 'Bifacial Gain', v: 'Up to 25%', d: 'Capture albedo reflection for higher kWh/W.' },
        { l: 'First-Year Loss', v: '1%', d: 'Half the degradation of conventional p-type modules.' },
        { l: 'Power', v: '555–600 W', d: 'Optimized for tracker compatibility.' },
        { l: 'Warranty', v: '12 / 30 yr', d: 'Product / linear power output.' },
        { l: 'Made In', v: 'Jacksonville, FL', d: 'U.S. domestic content for IRA bonus credits.' },
      ].map((s) => (
        <div class="rounded-2xl border border-jinko-line bg-white p-6 shadow-card">
          <p class="text-xs uppercase tracking-widest text-jinko-mute">{s.l}</p>
          <p class="mt-2 text-3xl font-display font-extrabold">{s.v}</p>
          <p class="mt-2 text-jinko-mute text-sm leading-relaxed">{s.d}</p>
        </div>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
