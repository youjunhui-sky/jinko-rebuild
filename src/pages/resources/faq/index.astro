---
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import SectionHeader from '@/components/SectionHeader.astro';

const entry = await getEntry('faqPage', 'index');
if (!entry) throw new Error('Missing FAQ page content entry: src/content/faqPage/index.json');
const page = entry.data;
const allFaqs = page.categories.flatMap((category) => category.items);
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: allFaqs.map(f => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) };
---
<BaseLayout title={page.seoTitle || `${page.title} | Callsun Resources`} description={page.metaDescription || page.hero.description} canonical={page.canonical || '/resources/faq'} ogImage={page.ogImage || '/og/default.svg'} keywords={page.keywords} noindex={page.noindex} schema={faqSchema}>
  <Header slot="header" />
  <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><nav class="text-sm text-jinko-mute mb-5"><a href="/">Home</a> / <a href="/resources">Resources</a> / <span>FAQ</span></nav><SectionHeader eyebrow={page.hero.eyebrow} title={page.h1 || page.title} description={page.hero.description} /><div class="mt-8 flex flex-wrap gap-3"><a href={page.hero.primaryCtaHref} class="inline-flex px-5 py-3 rounded-md bg-jinko text-white font-semibold shadow-card">{page.hero.primaryCtaLabel}</a>{page.hero.secondaryCtaLabel && page.hero.secondaryCtaHref && <a href={page.hero.secondaryCtaHref} class="inline-flex px-5 py-3 rounded-md bg-white text-jinko font-semibold border border-jinko-line">{page.hero.secondaryCtaLabel}</a>}</div></div></section>
  <section class="py-14"><div class="max-w-content mx-auto px-4 lg:px-6 grid gap-10 lg:grid-cols-[280px_1fr]"><aside class="lg:sticky lg:top-24 self-start rounded-2xl bg-white border border-jinko-line shadow-card p-5"><p class="text-xs uppercase tracking-widest text-jinko-mute font-bold">FAQ categories</p><nav class="mt-4 grid gap-2">{page.categories.map((category) => <a href={`#${category.title.toLowerCase().replaceAll(' ', '-')}`} class="text-sm font-semibold text-jinko hover:text-jinko-dark">{category.title}</a>)}</nav></aside><div class="space-y-10">{page.categories.map(category => <section id={category.title.toLowerCase().replaceAll(' ', '-')}><h2 class="text-2xl font-display font-bold">{category.title}</h2><div class="mt-5 space-y-4">{category.items.map(f => <details class="group rounded-2xl bg-white border border-jinko-line shadow-card p-6"><summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-display font-bold text-lg"><span>{f.question}</span><span class="text-jinko group-open:rotate-180 transition-transform">▾</span></summary><p class="mt-4 text-jinko-mute leading-relaxed">{f.answer}</p></details>)}</div></section>)}</div></div></section>
  {page.finalCta && <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><div class="rounded-3xl bg-jinko text-white p-8 lg:p-10 flex flex-col lg:flex-row gap-6 lg:items-center lg:justify-between"><div><h2 class="text-3xl font-display font-extrabold">{page.finalCta.title}</h2>{page.finalCta.description && <p class="mt-3 text-white/80 max-w-2xl">{page.finalCta.description}</p>}</div><div class="flex flex-wrap gap-3 shrink-0"><a href={page.finalCta.primaryHref} class="inline-flex px-5 py-3 rounded-md bg-white text-jinko font-semibold">{page.finalCta.primaryLabel}</a>{page.finalCta.secondaryLabel && page.finalCta.secondaryHref && <a href={page.finalCta.secondaryHref} class="inline-flex px-5 py-3 rounded-md bg-jinko-dark text-white font-semibold border border-white/20">{page.finalCta.secondaryLabel}</a>}</div></div></div></section>}
  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>
