---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SectionHeader from '@/components/SectionHeader.astro';
const faqs = [
  { q: 'Who is Callsun built for?', a: 'Callsun.com is positioned for B2B distributors, dealers and EPC installers who need solar modules, storage packages and repeatable project references.' },
  { q: 'Can the website support SEO content operations?', a: 'Yes. Products, solutions, applications, blog posts, cases and support pages are CMS-driven and include editable SEO title, meta description, H1, keywords, OG image and image alt fields.' },
  { q: 'Can we connect Google Ads and GA4 later?', a: 'Yes. GTM, GA4, Google Ads conversion IDs and dataLayer events are reserved. Scripts load only after Cookie Consent and after account IDs are provided.' },
  { q: 'Is the inquiry system final?', a: 'Not yet. The current phase includes inquiry UI, UTM fields and event tracking. The backend can later connect to HubSpot, Feishu Bitable, Cloudflare D1 or another CRM.' },
  { q: 'Can product images be replaced later?', a: 'Yes. All product, solution and case images use CMS-editable fields. Current graphics are placeholders and can be replaced without changing page structure.' },
  { q: 'Does the site support independent landing pages?', a: 'A landingPages content model is reserved for future SEM campaigns. Dedicated Google Ads landing pages can be enabled when campaign structure is confirmed.' },
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title="FAQ | Callsun Resources" description="Frequently asked questions about Callsun products, SEO content operations, Google Ads tracking and inquiry system integration." schema={faqSchema}>
  <Header slot="header" />
  <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><SectionHeader eyebrow="Resources" title="Frequently asked questions" description="A first FAQ set for B2B buyers and internal stakeholders. More product-specific questions can be added through CMS later." /></div></section>
  <section class="py-14"><div class="max-w-3xl mx-auto px-4 lg:px-6 space-y-4">{faqs.map(f => <details class="group rounded-2xl bg-white border border-jinko-line shadow-card p-6"><summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-display font-bold text-lg"><span>{f.q}</span><span class="text-jinko group-open:rotate-180 transition-transform">▾</span></summary><p class="mt-4 text-jinko-mute leading-relaxed">{f.a}</p></details>)}</div></section>
  <Footer slot="footer" />
</BaseLayout>
