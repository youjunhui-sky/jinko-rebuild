---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
const toSlug = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const allPosts = (await getCollection('news', n=>!n.data.draft)).sort((a,b)=>b.data.publishDate.getTime()-a.data.publishDate.getTime());
const allTags = Array.from(new Set(allPosts.flatMap((p) => p.data.tags))).sort();
export async function getStaticPaths() {
  const toSlug = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const posts = await getCollection('news', n=>!n.data.draft);
  const tags = Array.from(new Set(posts.flatMap((p) => p.data.tags)));
  return tags.map((tag) => ({ params: { tag: toSlug(tag) }, props: { tag } }));
}
const { tag } = Astro.props;
const posts = allPosts.filter((p) => p.data.tags.includes(tag));
---
<BaseLayout title={`#${tag} Articles | Callsun Blog`} description={`Browse Callsun blog articles tagged ${tag}.`} canonical={`/resources/blog/tag/${toSlug(tag)}`} ogImage="/og/default.svg" keywords={[`${tag} solar articles`, 'Callsun blog']}>
  <Header slot="header" />
  <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><nav class="text-sm text-jinko-mute mb-5"><a href="/resources/blog">Blog</a> / <span>#{tag}</span></nav><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Tag</p><h1 class="mt-2 text-4xl lg:text-5xl font-display font-extrabold">#{tag}</h1><p class="mt-4 text-jinko-mute">{posts.length} articles with this tag.</p><div class="mt-6 flex flex-wrap gap-2">{allTags.map((item) => <a href={`/resources/blog/tag/${toSlug(item)}`} class:list={["rounded-full px-3 py-1.5 text-sm font-semibold", item === tag ? "bg-jinko text-white" : "bg-white text-jinko-mute border border-jinko-line"]}>#{item}</a>)}</div></div></section>
  <section class="py-14"><div class="max-w-content mx-auto px-4 lg:px-6 grid gap-6 md:grid-cols-3">{posts.map((p) => <article class="rounded-2xl bg-white border border-jinko-line shadow-card p-6"><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{p.data.category}</p><h2 class="mt-2 text-xl font-display font-bold"><a href={`/resources/blog/${p.slug}`}>{p.data.title}</a></h2><p class="mt-2 text-sm text-jinko-mute">{p.data.description}</p><p class="mt-4 text-xs text-jinko-mute">{p.data.publishDate.toLocaleDateString('en-US')}</p></article>)}</div></section>
  <Footer slot="footer" />
</BaseLayout>
