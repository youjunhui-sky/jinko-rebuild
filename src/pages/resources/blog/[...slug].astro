---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CardGrid from '@/components/CardGrid.astro';
import { SITE } from '@/data/site';

export async function getStaticPaths(){
  const posts=await getCollection('news', n=>!n.data.draft);
  return posts.map(p=>({params:{slug:p.slug}, props:{post:p}}));
}
const { post } = Astro.props;
const { Content } = await render(post);
const [allPosts, products, solutions, cases] = await Promise.all([
  getCollection('news', n=>!n.data.draft),
  getCollection('products'),
  getCollection('solutions'),
  getCollection('cases'),
]);
const relatedPostSlugs = post.data.relatedPosts.length ? post.data.relatedPosts : allPosts.filter((p) => p.slug !== post.slug && (p.data.category === post.data.category || p.data.tags.some((tag) => post.data.tags.includes(tag)))).map((p) => p.slug).slice(0, 3);
const relatedPosts = allPosts.filter((p) => relatedPostSlugs.includes(p.slug)).slice(0, 3);
const relatedProducts = products.filter((p) => post.data.relatedProducts.includes(p.data.slug)).map((p) => ({ title: p.data.name, description: p.data.tagline, href: `/products/${p.data.slug}`, eyebrow: p.data.model || p.data.category, image: p.data.image }));
const relatedSolutions = solutions.filter((s) => post.data.relatedSolutions.includes(s.data.slug)).map((s) => ({ title: s.data.title, description: s.data.summary, href: `/solutions/${s.data.slug}`, eyebrow: s.data.type, image: s.data.image, metric: s.data.capacityLabel }));
const relatedCases = cases.filter((c) => post.data.relatedCases.includes(c.data.slug)).map((c) => ({ title: c.data.title, description: c.data.salesAngle || c.data.description, href: `/cases/${c.data.slug}`, eyebrow: c.data.segment, image: c.data.coverImage, metric: c.data.capacityKW ? (c.data.capacityKW >= 1000 ? `${c.data.capacityKW / 1000}MW` : `${c.data.capacityKW}kW`) : undefined }));
const title = post.data.seoTitle || `${post.data.title} | Callsun`;
const description = post.data.metaDescription || post.data.description;
const canonical = post.data.canonical || `/resources/blog/${post.slug}`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.h1 || post.data.title,
  description,
  image: post.data.ogImage || post.data.cover ? new URL(post.data.ogImage || post.data.cover, SITE.domain).href : undefined,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.publishDate).toISOString(),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: new URL('/logo.svg', SITE.domain).href } },
  mainEntityOfPage: new URL(canonical, SITE.domain).href,
};
---
<BaseLayout title={title} description={description} canonical={canonical} ogImage={post.data.ogImage || post.data.cover || undefined} keywords={post.data.keywords} noindex={post.data.noindex} ogType="article" schema={articleSchema}>
  <Header slot="header" />
  <article>
    <section class="py-14 bg-jinko-bg">
      <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-[1fr_320px] gap-10 items-end">
        <div><nav class="text-sm text-jinko-mute mb-5"><a href="/">Home</a> / <a href="/resources/blog">Blog</a> / <a href={`/resources/blog/category/${post.data.category.toLowerCase().replaceAll(' ', '-')}`}>{post.data.category}</a></nav><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{post.data.category}</p><h1 class="mt-2 text-4xl lg:text-5xl font-display font-extrabold">{post.data.h1 || post.data.title}</h1><p class="mt-4 text-lg text-jinko-mute max-w-3xl">{post.data.description}</p><p class="mt-4 text-sm text-jinko-mute">Published {post.data.publishDate.toLocaleDateString('en-US')} · Updated {(post.data.updatedDate || post.data.publishDate).toLocaleDateString('en-US')} · {post.data.author}</p><div class="mt-5 flex flex-wrap gap-2">{post.data.tags.map((tag) => <a href={`/resources/blog/tag/${tag.toLowerCase().replaceAll(' ', '-')}`} class="rounded-full bg-white border border-jinko-line px-3 py-1 text-sm text-jinko-mute">#{tag}</a>)}</div></div>
        {post.data.cover && <img src={post.data.cover} alt={post.data.title} class="rounded-3xl border border-jinko-line shadow-card" />}
      </div>
    </section>

    <section class="py-14">
      <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-[minmax(0,1fr)_300px] gap-10 items-start">
        <div class="prose prose-slate max-w-none prose-a:text-jinko prose-h2:font-display prose-h2:text-jinko-ink prose-h3:text-jinko-ink"><Content /></div>
        <aside class="rounded-3xl bg-white border border-jinko-line shadow-card p-6 sticky top-24">
          <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">In this article</p>
          <h2 class="mt-2 text-xl font-display font-bold">Next action</h2>
          <p class="mt-3 text-sm text-jinko-mute">Use this article as a content-to-conversion path for products, solutions and downloads.</p>
          <a href="/resources/downloads" class="mt-5 inline-flex w-full justify-center px-4 py-2 rounded-md bg-jinko text-white font-semibold">Download resources</a>
          <a href="/contact" class="mt-3 inline-flex w-full justify-center px-4 py-2 rounded-md border border-jinko-line font-semibold">Contact sales</a>
        </aside>
      </div>
    </section>

    {(post.data.ctaTitle || post.data.ctaDescription) && <section class="py-10"><div class="max-w-content mx-auto px-4 lg:px-6"><div class="rounded-3xl bg-jinko text-white p-8 lg:p-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6"><div><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Article CTA</p><h2 class="mt-2 text-3xl font-display font-extrabold">{post.data.ctaTitle}</h2>{post.data.ctaDescription && <p class="mt-3 text-sky-100 max-w-2xl">{post.data.ctaDescription}</p>}</div>{post.data.ctaHref && <a href={post.data.ctaHref} data-track-click="blog_cta_click" data-post={post.slug} class="inline-flex px-6 py-3 rounded-md bg-jinko-accent text-jinko-ink font-bold">{post.data.ctaLabel || 'Learn more'}</a>}</div></div></section>}

    {(relatedProducts.length > 0 || relatedSolutions.length > 0 || relatedCases.length > 0 || relatedPosts.length > 0) && <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6 space-y-12">
      {relatedProducts.length > 0 && <div><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Related products</p><h2 class="mt-2 text-3xl font-display font-extrabold">Products mentioned in this topic</h2><div class="mt-8"><CardGrid items={relatedProducts} columns="3" /></div></div>}
      {relatedSolutions.length > 0 && <div><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Related solutions</p><h2 class="mt-2 text-3xl font-display font-extrabold">Solution pages to continue reading</h2><div class="mt-8"><CardGrid items={relatedSolutions} columns="3" /></div></div>}
      {relatedCases.length > 0 && <div><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Related cases</p><h2 class="mt-2 text-3xl font-display font-extrabold">Proof points for this article</h2><div class="mt-8"><CardGrid items={relatedCases} columns="3" /></div></div>}
      {relatedPosts.length > 0 && <div><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Related articles</p><div class="mt-6 grid gap-6 md:grid-cols-3">{relatedPosts.map((p) => <article class="rounded-2xl bg-white border border-jinko-line shadow-card p-6"><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{p.data.category}</p><h3 class="mt-2 text-xl font-display font-bold"><a href={`/resources/blog/${p.slug}`}>{p.data.title}</a></h3><p class="mt-2 text-sm text-jinko-mute">{p.data.description}</p></article>)}</div></div>}
    </div></section>}
  </article>
  <Footer slot="footer" />
</BaseLayout>
