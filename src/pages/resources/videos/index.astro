---
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import CardGrid from '@/components/CardGrid.astro';

const entry = await getEntry('videoPage', 'index');
if (!entry) throw new Error('Missing video page content entry: src/content/videoPage/index.json');
const page = entry.data;
---
<BaseLayout title={page.seoTitle || `${page.title} | Callsun Resources`} description={page.metaDescription || page.hero.description} canonical={page.canonical || '/resources/videos'} ogImage={page.ogImage || '/og/default.svg'} keywords={page.keywords} noindex={page.noindex}>
  <Header slot="header" />
  <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><nav class="text-sm text-jinko-mute mb-5"><a href="/">Home</a> / <a href="/resources">Resources</a> / <span>Videos</span></nav><SectionHeader eyebrow={page.hero.eyebrow} title={page.h1 || page.title} description={page.hero.description} /><div class="mt-8 flex flex-wrap gap-3"><a href={page.hero.primaryCtaHref} class="inline-flex px-5 py-3 rounded-md bg-jinko text-white font-semibold shadow-card">{page.hero.primaryCtaLabel}</a>{page.hero.secondaryCtaLabel && page.hero.secondaryCtaHref && <a href={page.hero.secondaryCtaHref} class="inline-flex px-5 py-3 rounded-md bg-white text-jinko font-semibold border border-jinko-line">{page.hero.secondaryCtaLabel}</a>}</div></div></section>
  <section class="py-16"><div class="max-w-content mx-auto px-4 lg:px-6"><SectionHeader eyebrow="Video categories" title="Prepared content tracks for future video assets" description="These categories keep video operations ready even while official footage is still pending." /><div class="mt-10"><CardGrid items={page.categories.map(c => ({ title: c.title, description: c.description, eyebrow: c.status }))} /></div></div></section>
  <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><SectionHeader eyebrow="Video slots" title="Placeholder video library" description="Replace thumbnails and add video URLs after the customer provides official assets." /><div class="mt-10 grid gap-6 md:grid-cols-3">{page.videoSlots.map(video => <article class="rounded-2xl bg-white border border-jinko-line shadow-card overflow-hidden"><div class="relative"><img src={video.thumbnail} alt={video.thumbnailAlt || video.title} class="aspect-video w-full object-cover bg-jinko-bg" loading="lazy" /><span class="absolute inset-0 m-auto h-16 w-16 rounded-full bg-jinko/90 text-white flex items-center justify-center text-2xl">▶</span></div><div class="p-6"><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{video.category || 'Video'}</p><h2 class="mt-2 text-xl font-display font-bold">{video.title}</h2>{video.description && <p class="mt-2 text-sm text-jinko-mute">{video.description}</p>}<p class="mt-4 text-xs text-jinko-mute">Duration: {video.duration || 'TBD'}</p>{video.videoUrl ? <a href={video.videoUrl} class="mt-4 inline-block text-jinko font-semibold" data-track-click="video_watch_click">Watch video →</a> : <span class="mt-4 inline-block text-sm font-semibold text-jinko-mute">Awaiting video asset</span>}</div></article>)}</div></div></section>
  {page.finalCta && <section class="py-16"><div class="max-w-content mx-auto px-4 lg:px-6"><div class="rounded-3xl bg-jinko text-white p-8 lg:p-10 flex flex-col lg:flex-row gap-6 lg:items-center lg:justify-between"><div><h2 class="text-3xl font-display font-extrabold">{page.finalCta.title}</h2>{page.finalCta.description && <p class="mt-3 text-white/80 max-w-2xl">{page.finalCta.description}</p>}</div><div class="flex flex-wrap gap-3 shrink-0"><a href={page.finalCta.primaryHref} class="inline-flex px-5 py-3 rounded-md bg-white text-jinko font-semibold">{page.finalCta.primaryLabel}</a>{page.finalCta.secondaryLabel && page.finalCta.secondaryHref && <a href={page.finalCta.secondaryHref} class="inline-flex px-5 py-3 rounded-md bg-jinko-dark text-white font-semibold border border-white/20">{page.finalCta.secondaryLabel}</a>}</div></div></div></section>}
  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>
