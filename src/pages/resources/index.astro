---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---
<BaseLayout title="Resources | Callsun" description="Callsun resources center for blog articles, downloads, FAQs, installation guides and videos.">
<Header slot="header" />
<section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">Resources</p><h1 class="mt-2 text-4xl lg:text-5xl font-display font-extrabold">Resource center</h1><p class="mt-4 text-lg text-jinko-mute max-w-3xl">Technical blog, product downloads, FAQs, installation guides and future video content.</p></div></section>
<section class="py-14"><div class="max-w-content mx-auto px-4 lg:px-6 grid gap-6 md:grid-cols-4">{[{t:'Technical Blog',u:'/resources/blog',d:'SEO articles and installer guides'},{t:'Downloads',u:'/resources/downloads',d:'Datasheets, manuals and certificates'},{t:'FAQ',u:'/resources/faq',d:'Common product and policy questions'},{t:'Videos',u:'/resources/videos',d:'Future installation and case videos'}].map(x=><a href={x.u} class="rounded-2xl bg-white border border-jinko-line shadow-card p-6 hover:-translate-y-1 transition-transform"><h2 class="text-xl font-display font-bold">{x.t}</h2><p class="mt-2 text-sm text-jinko-mute">{x.d}</p><p class="mt-5 text-jinko font-semibold">Open →</p></a>)}</div></section>
<Footer slot="footer" />
</BaseLayout>
