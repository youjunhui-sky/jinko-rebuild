---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import CardGrid from '@/components/CardGrid.astro';

export async function getStaticPaths(){
  const apps=await getCollection('applications');
  const products=await getCollection('products');
  const solutions=await getCollection('solutions');
  const cases=await getCollection('cases');
  const downloads=await getCollection('downloads');
  return apps.map(a=>({
    params:{slug:a.data.slug},
    props:{
      app:a.data,
      products: products.map(p=>p.data),
      solutions: solutions.map(s=>s.data),
      cases: cases.map(c=>c.data),
      downloads: downloads.map(d=>d.data),
    }
  }));
}
const { app, products, solutions, cases, downloads } = Astro.props;
const solutionCards = app.recommendedSolutions.map(slug => solutions.find(s => s.slug === slug)).filter(Boolean).map(s => ({ title: s.title, description: s.summary, href: `/solutions/${s.slug}`, image: s.image, metric: s.capacityLabel }));
const productCards = app.relatedProducts.map(slug => products.find(p => p.slug === slug)).filter(Boolean).map(p => ({ title: p.name, description: p.description, href: `/products/${p.slug}`, image: p.image, eyebrow: p.category }));
const caseCards = app.relatedCases.map(slug => cases.find(c => c.slug === slug)).filter(Boolean).map(c => ({ title: c.title, description: c.description, href: `/cases/${c.slug}`, image: c.coverImage, metric: c.capacityKW ? `${c.capacityKW}kW` : c.capacityMWh ? `${c.capacityMWh}MWh` : c.segment }));
const downloadCards = app.recommendedDownloads.map(slug => downloads.find(d => d.slug === slug)).filter(Boolean).map(d => ({ title: d.title, description: d.description || d.category, href: d.fileUrl, eyebrow: d.category, metric: d.fileType }));
const faqSchema = app.faqs?.length ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: app.faqs.map(f => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) } : undefined;
---
<BaseLayout title={app.seoTitle || `${app.title} | Callsun`} description={app.metaDescription || app.summary} canonical={app.canonical || `/applications/${app.slug}`} ogImage={app.ogImage || app.image} keywords={app.keywords} noindex={true} schema={faqSchema}>
  <Header slot="header" />
  <section class="py-16 lg:py-20 bg-jinko-bg">
    <div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <nav class="text-sm text-jinko-mute mb-5"><a href="/">Home</a> / <a href="/applications">Applications</a> / <span>{app.title}</span></nav>
        <p class="text-xs uppercase tracking-[0.22em] text-jinko-accent font-extrabold">{app.hero?.eyebrow || 'Application scenario'}</p>
        <h1 class="mt-3 text-4xl lg:text-5xl font-display font-extrabold leading-tight">{app.h1 || app.title}</h1>
        <p class="mt-5 text-lg text-jinko-mute leading-relaxed">{app.summary}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={app.hero?.primaryCtaHref || '/contact'} class="inline-flex px-5 py-3 rounded-md bg-jinko text-white font-semibold">{app.hero?.primaryCtaLabel || 'Discuss This Application'}</a>
          {app.hero?.secondaryCtaLabel && app.hero?.secondaryCtaHref && <a href={app.hero.secondaryCtaHref} class="inline-flex px-5 py-3 rounded-md bg-white text-jinko font-semibold border border-jinko-line">{app.hero.secondaryCtaLabel}</a>}
        </div>
      </div>
      <img src={app.image} alt={app.imageAlt || app.title} width="720" height="520" class="rounded-2xl border border-jinko-line shadow-card bg-white w-full" />
    </div>
  </section>

  {app.painPoints.length > 0 && <section class="py-16"><div class="max-w-content mx-auto px-4 lg:px-6"><SectionHeader eyebrow="Buyer concerns" title="What this application page should answer." description="Each scenario page now explains demand drivers before sending buyers into products, solutions and RFQ." /><div class="mt-10"><CardGrid items={app.painPoints} /></div></div></section>}

  {app.solutionApproach && <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6 grid lg:grid-cols-[1fr_0.8fr] gap-10"><div><SectionHeader eyebrow="Solution approach" title="Recommended package logic" description={app.solutionApproach} /></div>{app.buyerChecklist.length > 0 && <div class="rounded-3xl bg-white border border-jinko-line shadow-card p-7"><h2 class="text-2xl font-display font-bold">Project information to collect</h2><ul class="mt-5 space-y-3">{app.buyerChecklist.map(item => <li class="flex gap-3"><span class="text-jinko-accent font-bold">✓</span><span class="text-jinko-mute">{item}</span></li>)}</ul></div>}</div></section>}

  {solutionCards.length > 0 && <section class="py-16"><div class="max-w-content mx-auto px-4 lg:px-6"><SectionHeader eyebrow="Recommended solutions" title="Move from scenario to system package." /><div class="mt-10"><CardGrid items={solutionCards} /></div></div></section>}
  {productCards.length > 0 && <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><SectionHeader eyebrow="Related products" title="Modules that fit this application." /><div class="mt-10"><CardGrid items={productCards} /></div></div></section>}
  {caseCards.length > 0 && <section class="py-16"><div class="max-w-content mx-auto px-4 lg:px-6"><SectionHeader eyebrow="Related cases" title="Use project proof to reduce buyer hesitation." /><div class="mt-10"><CardGrid items={caseCards} /></div></div></section>}
  {downloadCards.length > 0 && <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><SectionHeader eyebrow="Recommended downloads" title="Documents buyers may request next." /><div class="mt-10"><CardGrid items={downloadCards} /></div></div></section>}

  {app.faqs.length > 0 && <section class="py-16"><div class="max-w-content mx-auto px-4 lg:px-6"><SectionHeader eyebrow="Application FAQ" title="Common pre-sales questions" /><div class="mt-8 grid gap-4">{app.faqs.map(f => <details class="rounded-2xl border border-jinko-line bg-white shadow-card p-6"><summary class="font-display font-bold cursor-pointer">{f.question}</summary><p class="mt-3 text-jinko-mute leading-relaxed">{f.answer}</p></details>)}</div></div></section>}

  {(app.ctaTitle || app.ctaDescription) && <section class="py-16 bg-jinko-bg"><div class="max-w-content mx-auto px-4 lg:px-6"><div class="rounded-3xl bg-jinko text-white p-8 lg:p-10 flex flex-col lg:flex-row gap-6 lg:items-center lg:justify-between"><div><h2 class="text-3xl font-display font-extrabold">{app.ctaTitle || 'Discuss this application with Callsun.'}</h2>{app.ctaDescription && <p class="mt-3 text-white/80 max-w-2xl">{app.ctaDescription}</p>}</div><a href="/contact" class="inline-flex px-5 py-3 rounded-md bg-white text-jinko font-semibold shrink-0">Request a Quote</a></div></div></section>}

  <ContactCTA />
  <Footer slot="footer" />
</BaseLayout>
