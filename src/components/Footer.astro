---
import { SITE } from '@/data/site';
import { NAV } from '@/data/nav';
const year = new Date().getFullYear();
---
<footer class="bg-jinko-ink text-slate-300 mt-24">
  <div class="max-w-content mx-auto px-4 lg:px-6 py-14 grid gap-10 lg:grid-cols-4">
    <div>
      <div class="font-display font-extrabold text-white text-2xl">Jinko<span class="text-jinko-accent">·</span>US</div>
      <p class="mt-3 text-sm text-slate-400 leading-relaxed">
        {SITE.organization.legalName}<br />
        NYSE: {SITE.organization.nyseTicker} · Founded {SITE.organization.foundingDate}
      </p>
      <p class="mt-3 text-sm text-slate-400">
        🏭 Manufacturing in {SITE.organization.factory.city}, {SITE.organization.factory.region} since {SITE.organization.factory.since}
      </p>
    </div>

    <nav aria-label="Footer" class="text-sm">
      <h2 class="text-white font-semibold mb-3">Products & Resources</h2>
      <ul class="space-y-2">
        {NAV.map((n) => (
          <li><a href={n.href} class="hover:text-white transition-colors">{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="text-sm">
      <h2 class="text-white font-semibold mb-3">Contact Sales</h2>
      <ul class="space-y-2">
        <li>📧 <a href={`mailto:${SITE.organization.contact.sales}`} class="hover:text-white">{SITE.organization.contact.sales}</a></li>
        <li>📞 <a href={`tel:${SITE.organization.contact.phone}`} class="hover:text-white">{SITE.organization.contact.phone}</a></li>
        <li class="text-slate-400">{SITE.organization.hqAddress.street}<br />
          {SITE.organization.hqAddress.city}, {SITE.organization.hqAddress.region} {SITE.organization.hqAddress.postal}
        </li>
      </ul>
    </div>

    <div class="text-sm">
      <h2 class="text-white font-semibold mb-3">Stay Updated</h2>
      <p class="text-slate-400 mb-3">Quarterly industry insights. No spam.</p>
      <form action="/api/subscribe" method="post" class="flex gap-2">
        <label class="sr-only" for="email">Email</label>
        <input id="email" type="email" name="email" required placeholder="you@company.com"
               class="flex-1 px-3 py-2 rounded-md bg-slate-800 text-white text-sm border border-slate-700 focus:border-jinko-accent outline-none" />
        <button class="px-4 py-2 rounded-md bg-jinko-accent text-jinko-ink font-semibold text-sm hover:opacity-90">
          Subscribe
        </button>
      </form>
    </div>
  </div>

  <div class="border-t border-slate-800">
    <div class="max-w-content mx-auto px-4 lg:px-6 py-6 text-xs text-slate-500 flex flex-col sm:flex-row gap-3 justify-between">
      <div>© {year} {SITE.organization.legalName}. All rights reserved.</div>
      <div class="flex gap-5">
        <a href="/privacy" class="hover:text-slate-300">Privacy</a>
        <a href="/terms" class="hover:text-slate-300">Terms</a>
        <a href="/sitemap.xml" class="hover:text-slate-300">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
