---
import { getCollection } from 'astro:content';
import { SITE } from '@/data/site';
const year = new Date().getFullYear();
const navItems = (await getCollection('navigation'))
  .map((entry) => entry.data)
  .filter((item) => item.visible && item.footerVisible)
  .sort((a, b) => a.order - b.order);
---
<footer class="bg-jinko-ink text-slate-300 mt-24">
  <div class="max-w-content mx-auto px-4 lg:px-6 py-14 grid gap-10 lg:grid-cols-4">
    <div>
      <img src="/logo.png" alt="Callsun" width="170" height="46" class="h-10 w-auto bg-white rounded-md px-2 py-1" />
      <p class="mt-4 text-sm text-slate-400 leading-relaxed">
        Solar modules, off-grid systems and solar-plus-storage packages for B2B distributors, dealers and EPC installers.
      </p>
      <p class="mt-3 text-sm text-slate-400">Built for SEO, Google Ads landing pages and B2B inquiry conversion.</p>
    </div>

    <nav aria-label="Footer" class="text-sm">
      <h2 class="text-white font-semibold mb-3">Site</h2>
      <ul class="space-y-2">
        {navItems.map((n) => <li><a href={n.href} class="hover:text-white transition-colors">{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="text-sm">
      <h2 class="text-white font-semibold mb-3">Contact Sales</h2>
      <ul class="space-y-2">
        <li>📧 <a href={`mailto:${SITE.organization.contact.sales}`} data-track-click="email_click" class="hover:text-white">{SITE.organization.contact.sales}</a></li>
        {SITE.organization.contact.phone && <li>📞 <a href={`tel:${SITE.organization.contact.phone}`} data-track-click="phone_click" class="hover:text-white">{SITE.organization.contact.phone}</a></li>}
        {SITE.organization.contact.whatsapp && <li>💬 <a href={SITE.organization.contact.whatsapp} data-track-click="whatsapp_click" class="hover:text-white">WhatsApp</a></li>}
      </ul>
    </div>

    <div class="text-sm">
      <h2 class="text-white font-semibold mb-3">Inquiry Ready</h2>
      <p class="text-slate-400 mb-3">Tell us your market, system size and target application. We will help match modules, storage and standard packages.</p>
      <a href="/contact" data-track-click="inquiry_cta" data-track-location="footer" class="inline-flex px-5 py-3 rounded-md bg-jinko-accent text-jinko-ink font-semibold text-sm hover:opacity-90">Request a Quote</a>
    </div>
  </div>

  <div class="border-t border-slate-800">
    <div class="max-w-content mx-auto px-4 lg:px-6 py-6 text-xs text-slate-500 flex flex-col sm:flex-row gap-3 justify-between">
      <div>© {year} {SITE.organization.legalName}. All rights reserved.</div>
      <div class="flex gap-5">
        <a href="/privacy" class="hover:text-slate-300">Privacy</a>
        <a href="/terms" class="hover:text-slate-300">Terms</a>
        <a href="/sitemap.xml" class="hover:text-slate-300">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
