---
---
<div id="cookie-consent" hidden class="fixed inset-x-4 bottom-4 z-50 max-w-3xl mx-auto rounded-2xl border border-jinko-line bg-white shadow-card p-4 sm:p-5">
  <div class="sm:flex gap-4 items-start justify-between">
    <div>
      <p class="font-semibold text-jinko-ink">Cookie & analytics consent</p>
      <p class="mt-1 text-sm text-jinko-mute leading-relaxed">
        Callsun uses analytics and advertising tags only after consent. This keeps GA4, GTM, Google Ads and remarketing ready for future campaigns.
      </p>
    </div>
    <div class="mt-4 sm:mt-0 flex gap-2 shrink-0">
      <button type="button" data-cookie-decline class="px-4 py-2 rounded-md border border-jinko-line text-sm font-semibold text-jinko-mute">Decline</button>
      <button type="button" data-cookie-accept class="px-4 py-2 rounded-md bg-jinko text-white text-sm font-semibold">Accept</button>
    </div>
  </div>
</div>

<script>
  const key = 'callsun_cookie_consent';
  const box = document.getElementById('cookie-consent');
  const current = localStorage.getItem(key);
  if (!current && box) box.hidden = false;

  function setConsent(value) {
    localStorage.setItem(key, value);
    if (box) box.hidden = true;
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'cookie_consent_update', consent: value });
    if (value === 'accepted') window.dispatchEvent(new Event('callsun:analytics-consent'));
  }

  document.querySelector('[data-cookie-accept]')?.addEventListener('click', () => setConsent('accepted'));
  document.querySelector('[data-cookie-decline]')?.addEventListener('click', () => setConsent('declined'));
</script>
