---
import { getCollection } from 'astro:content';
import { SITE } from '@/data/site';

const navItems = (await getCollection('navigation'))
  .map((entry) => entry.data)
  .filter((item) => item.visible)
  .sort((a, b) => a.order - b.order)
  .map((item) => ({
    ...item,
    children: item.children.filter((child) => child.visible).sort((a, b) => a.order - b.order),
  }));
---
<header class="sticky top-0 z-40 bg-white/92 backdrop-blur-md border-b border-jinko-line">
  <div class="max-w-content mx-auto px-4 lg:px-6 h-16 flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label={SITE.name + ' home'}>
      <img src="/logo.png" alt="Callsun" width="150" height="40" class="h-9 w-auto" />
    </a>

    <nav aria-label="Primary" class="hidden lg:flex items-stretch gap-1 text-sm font-medium text-jinko-mute h-full">
      {navItems.map((n) => (
        <div class="relative group flex items-center">
          <a href={n.href} class="px-3 py-2 rounded-md hover:text-jinko-ink hover:bg-jinko-bg transition-colors whitespace-nowrap">
            {n.label}
          </a>
          {n.children.length > 0 && (
            <div class="invisible opacity-0 translate-y-2 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 focus-within:visible focus-within:opacity-100 focus-within:translate-y-0 transition-all absolute left-0 top-full pt-3 w-[440px]">
              <div class="rounded-2xl border border-jinko-line bg-white shadow-xl p-3 grid gap-2">
                <div class="px-3 pt-2 pb-1">
                  <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{n.label}</p>
                  {n.description && <p class="mt-1 text-xs text-jinko-mute">{n.description}</p>}
                </div>
                <div class="grid gap-2">
                  {n.children.map((child) => (
                    <a href={child.href} class="grid grid-cols-[56px_1fr] gap-3 items-center rounded-xl p-2 hover:bg-jinko-bg transition-colors">
                      {child.image ? <img src={child.image} alt="" width="56" height="42" class="w-14 h-11 rounded-lg object-cover bg-jinko-bg" /> : <div class="w-14 h-11 rounded-lg bg-jinko-bg flex items-center justify-center text-jinko">→</div>}
                      <span>
                        <span class="block font-semibold text-jinko-ink">{child.label}</span>
                        {child.description && <span class="block text-xs text-jinko-mute mt-0.5">{child.description}</span>}
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <button type="button" class="hidden sm:inline-flex items-center px-3 py-2 text-jinko-mute hover:text-jinko-ink" aria-label="Search" onclick="location.href='/search'">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
      <a href="/contact" data-track-click="inquiry_cta" data-track-location="header"
         class="hidden sm:inline-flex items-center px-4 py-2 rounded-md bg-jinko text-white text-sm font-semibold hover:bg-jinko-dark transition-colors">
        Request Quote
      </a>
      <button type="button" class="lg:hidden p-2" aria-label="Open menu" data-mobile-menu-toggle>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="lg:hidden border-t border-jinko-line bg-white">
    <nav aria-label="Mobile" class="px-4 py-3 flex flex-col gap-1 max-h-[80vh] overflow-y-auto">
      {navItems.map((n) => (
        <div class="border-b border-jinko-line/60 last:border-b-0 py-1">
          <a href={n.href} class="py-2 font-semibold text-jinko-ink hover:text-jinko block">{n.label}</a>
          {n.children.length > 0 && <div class="pl-3 pb-2 flex flex-col gap-1">{n.children.map((child) => <a href={child.href} class="py-1.5 text-sm text-jinko-mute hover:text-jinko">{child.label}</a>)}</div>}
        </div>
      ))}
      <a href="/contact" class="mt-2 px-4 py-3 rounded-md bg-jinko text-white text-center font-semibold">Request Quote</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector('[data-mobile-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    if (menu) menu.hidden = !menu.hidden;
  });

  document.querySelectorAll('[data-track-click]').forEach((el) => {
    el.addEventListener('click', () => {
      window.callsunTrack?.(el.getAttribute('data-track-click') || 'click', {
        location: el.getAttribute('data-track-location') || 'unknown',
        href: el.getAttribute('href') || '',
      });
    });
  });
</script>
