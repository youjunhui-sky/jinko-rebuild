---
import { STATS } from '@/data/stats';
---
<section aria-labelledby="hero-title" class="relative overflow-hidden bg-gradient-to-br from-jinko-dark via-jinko to-sky-700 text-white">
  <!-- 纯 CSS Hero, 替代原站 398KB 的 Slider Revolution -->
  <div class="absolute inset-0 opacity-20 pointer-events-none"
       style="background-image:radial-gradient(circle at 20% 20%, rgba(255,180,0,.6), transparent 40%), radial-gradient(circle at 80% 30%, rgba(255,255,255,.3), transparent 50%);"></div>

  <div class="max-w-content mx-auto px-4 lg:px-6 py-20 lg:py-28 relative">
    <p class="inline-block text-xs tracking-widest uppercase font-semibold text-jinko-accent bg-white/10 px-3 py-1 rounded-full">
      NYSE: JKS · Bloomberg Tier 1 · Made in Jacksonville, FL
    </p>
    <h1 id="hero-title" class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-display font-extrabold leading-tight max-w-3xl">
      U.S. Solar Panels <span class="text-jinko-accent">+</span> Battery Storage,<br class="hidden sm:block" />
      From One Trusted Manufacturer
    </h1>
    <p class="mt-5 text-lg lg:text-xl text-sky-100 max-w-2xl leading-relaxed">
      EAGLE® TOPCon modules and EAGLE Storage® LFP batteries — engineered for U.S. utility, commercial, and residential projects. Manufactured locally in Florida since 2018.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/eagle-modules"
         class="inline-flex items-center px-6 py-3 rounded-md bg-jinko-accent text-jinko-ink font-semibold hover:opacity-90 transition">
        Explore EAGLE® Modules →
      </a>
      <a href="/installer-finder"
         class="inline-flex items-center px-6 py-3 rounded-md bg-white/10 text-white font-semibold hover:bg-white/20 transition ring-1 ring-white/20">
        Find an Installer
      </a>
    </div>

    <!-- 核心指标条 (替代原站 H6 滥用) -->
    <dl class="mt-14 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6 max-w-4xl">
      {STATS.map((s) => (
        <div>
          <dt class="text-xs uppercase tracking-wider text-sky-200">{s.label}</dt>
          <dd class="mt-1 text-2xl lg:text-3xl font-display font-extrabold text-white">
            {s.value}<span class="text-jinko-accent text-lg ml-1">{s.unit}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
