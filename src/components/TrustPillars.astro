---
const TRUST = [
  { t: 'Quality', d: 'Bloomberg Tier 1 manufacturer. Among the lowest warranty claim rates in the industry.', icon: '🛡️' },
  { t: 'Operational Efficiency', d: '400+ GW deployed globally across 160 countries. 99.9% on-time delivery in the U.S.', icon: '⚙️' },
  { t: 'Customer Commitment', d: 'Local U.S. & Canada sales and support — your project, never an afterthought.', icon: '🤝' },
];
---
<section aria-labelledby="trust-title" class="py-20 bg-jinko-bg">
  <div class="max-w-content mx-auto px-4 lg:px-6">
    <h2 id="trust-title" class="text-3xl lg:text-4xl font-display font-extrabold max-w-2xl">
      The Jinko Difference
    </h2>
    <p class="mt-3 text-jinko-mute max-w-2xl">
      Best-in-class solar + storage from a company you trust. Public on NYSE since 2010. Manufacturing locally since 2018.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {TRUST.map((c) => (
        <article class="rounded-2xl bg-white p-7 shadow-card border border-jinko-line">
          <div class="text-3xl">{c.icon}</div>
          <h3 class="mt-4 text-xl font-display font-bold">{c.t}</h3>
          <p class="mt-2 text-jinko-mute leading-relaxed">{c.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>
