---
import { LOCALES, LOCALE_NAMES, type Locale, localizedPath } from '@/lib/i18n';

interface Props { current: Locale }
const { current } = Astro.props;
const path = Astro.url.pathname.replace(/^\/(es|zh)/, '') || '/';
---
<div class="relative inline-block">
  <button type="button" class="inline-flex items-center gap-1 px-2 py-1 text-sm text-jinko-mute hover:text-jinko-ink"
          aria-haspopup="true" aria-expanded="false" data-lang-toggle>
    🌐 {LOCALE_NAMES[current]}
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
  </button>
  <ul hidden data-lang-menu class="absolute right-0 mt-1 bg-white border border-jinko-line rounded-md shadow-card py-1 min-w-[120px] z-50">
    {LOCALES.map((loc) => (
      <li>
        <a href={localizedPath(path, loc)}
           class:list={['block px-4 py-2 text-sm hover:bg-jinko-bg', loc === current ? 'text-jinko font-semibold' : 'text-jinko-mute']}
           hreflang={loc}>
          {LOCALE_NAMES[loc]}
        </a>
      </li>
    ))}
  </ul>
</div>
<script>
  const btn = document.querySelector('[data-lang-toggle]');
  const menu = document.querySelector('[data-lang-menu]') as HTMLElement | null;
  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (menu) menu.hidden = !menu.hidden;
  });
  document.addEventListener('click', () => { if (menu) menu.hidden = true; });
</script>
