---
interface Item { title: string; description: string; href?: string; eyebrow?: string; image?: string; metric?: string; }
interface Props { items: Item[]; columns?: '3' | '4'; }
const { items, columns = '3' } = Astro.props;
const gridClass = columns === '4' ? 'lg:grid-cols-4' : 'lg:grid-cols-3';
---
<ul class:list={['grid gap-6 md:grid-cols-2', gridClass]}>
  {items.map((item) => {
    const Inner = (
      <>
        {item.image && <img src={item.image} alt={item.title} loading="lazy" width="640" height="400" class="aspect-[16/10] w-full object-cover bg-jinko-bg" />}
        <div class="p-6">
          {item.eyebrow && <p class="text-xs uppercase tracking-widest text-jinko-accent font-bold">{item.eyebrow}</p>}
          <h3 class="mt-2 text-xl font-display font-bold text-jinko-ink group-hover:text-jinko">{item.title}</h3>
          {item.metric && <p class="mt-2 text-2xl font-display font-extrabold text-jinko">{item.metric}</p>}
          <p class="mt-3 text-sm text-jinko-mute leading-relaxed">{item.description}</p>
          {item.href && <p class="mt-5 text-jinko font-semibold">Learn more →</p>}
        </div>
      </>
    );
    return <li class="group rounded-2xl bg-white border border-jinko-line shadow-card overflow-hidden hover:-translate-y-1 hover:shadow-xl transition-all">{item.href ? <a href={item.href} class="block h-full">{Inner}</a> : Inner}</li>;
  })}
</ul>
